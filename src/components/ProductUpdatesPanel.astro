---
/**
 * Rail feed de productos (catálogo). Cabecera = nombre del producto.
 */
import type { Locale } from "../i18n/translations";
import { useTranslations } from "../lib/locale";
import { getTagLabels } from "../lib/updates";

type Props = {
  lang?: Locale;
};

const { lang = "es" } = Astro.props;
const t = useTranslations(lang);
const tagLabels = {
  ...getTagLabels(lang),
  update: lang === "en" ? "Update" : lang === "fr" ? "Màj" : "Update",
};

const payload = {
  lang: lang as string,
  labels: {
    empty: t("productFeedEmpty"),
    tags: tagLabels as Record<string, string>,
  },
};
---

<div
  class="updates-panel product-updates-panel"
  data-product-updates-root
  data-product-updates-payload={JSON.stringify(payload)}
>
  <header class="updates-panel__head">
    <p class="updates-panel__eyebrow">{t("productFeedEyebrow")}</p>
    <h2 class="updates-panel__title">{t("productFeedTitle")}</h2>
    <p class="updates-panel__desc">{t("productFeedDesc")}</p>
  </header>

  <div class="updates-panel__body" data-product-updates-body>
    <p class="updates-panel__empty">{t("productFeedEmpty")}</p>
  </div>
</div>

<script>
  import { safeMediaUrl } from "../lib/dom-escape";

  function escapeHtml(s: string) {
    return String(s)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function formatDate(iso: string) {
    const [y, m, d] = String(iso).split("-");
    if (!y || !m || !d) return iso;
    return `${d}/${m}/${y}`;
  }

  function safeTag(tag: string) {
    if (
      tag === "nuevo" ||
      tag === "mejora" ||
      tag === "fix" ||
      tag === "proximo" ||
      tag === "update"
    ) {
      return tag;
    }
    return "update";
  }

  function mediaBlock(item: { image?: string; video?: string }) {
    const video = safeMediaUrl(typeof item.video === "string" ? item.video : "");
    if (video) {
      return `<div class="updates-panel__media"><video class="updates-panel__video" src="${escapeHtml(video)}" controls playsinline preload="metadata"></video></div>`;
    }
    const src = safeMediaUrl(typeof item.image === "string" ? item.image : "");
    if (!src) return "";
    return `<div class="updates-panel__media"><img class="updates-panel__img" src="${escapeHtml(src)}" alt="" loading="lazy" decoding="async" /></div>`;
  }

  function productHref(lang: string, slug: string, link?: string): string {
    const s = String(slug || "").trim();
    if (s) return `/${lang}/catalogo/?p=${encodeURIComponent(s)}`;
    const u = String(link || "").trim();
    if (u.startsWith("/") && !u.startsWith("//")) {
      // reescribir /es/catalogo → lang actual
      return u.replace(/^\/(es|en|fr)(\/)/, `/${lang}$2`);
    }
    return "";
  }

  async function hydrateProductUpdates() {
    document.querySelectorAll("[data-product-updates-root]").forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.bound === "1") return;
      root.dataset.bound = "1";

      let payload: {
        lang?: string;
        labels: { empty: string; tags: Record<string, string> };
      } = { labels: { empty: "", tags: {} } };
      try {
        payload = JSON.parse(root.dataset.productUpdatesPayload || "{}");
      } catch {
        /* empty */
      }

      const body = root.querySelector("[data-product-updates-body]");
      if (!body) return;
      const lang = String(payload.lang || "es");
      const empty = payload.labels?.empty || "—";
      const tags = payload.labels?.tags || {};

      void (async () => {
        try {
          const res = await fetch("/api/product-updates", { credentials: "same-origin" });
          if (!res.ok) return;
          const data = await res.json();
          if (!data?.ok || !Array.isArray(data.items) || !data.items.length) {
            body.innerHTML = `<p class="updates-panel__empty">${escapeHtml(empty)}</p>`;
            return;
          }

          const items = data.items.slice(0, 12);
          body.innerHTML = `<ul class="updates-panel__list">${items
            .map(
              (item: {
                date?: string;
                productName?: string;
                productSlug?: string;
                tag?: string;
                summary?: string;
                image?: string;
                video?: string;
                link?: string;
              }) => {
                const tag = safeTag(String(item.tag || "update"));
                const name = escapeHtml(String(item.productName || item.productSlug || "").slice(0, 160));
                const summary = escapeHtml(String(item.summary || "").slice(0, 800));
                const date = String(item.date || "").slice(0, 10);
                const tagLabel = escapeHtml(tags[tag] || tag);
                const media = mediaBlock(item);
                const href = productHref(lang, String(item.productSlug || ""), item.link);
                const titleHtml = href
                  ? `<p class="updates-panel__item-title"><a class="updates-panel__link" href="${escapeHtml(href)}">${name}</a></p>`
                  : `<p class="updates-panel__item-title">${name}</p>`;
                return `<li class="updates-panel__item">
                <div class="updates-panel__meta">
                  <span class="updates-panel__tag updates-panel__tag--${tag}">${tagLabel}</span>
                  <time class="updates-panel__date" datetime="${escapeHtml(date)}">${escapeHtml(formatDate(date))}</time>
                </div>
                ${titleHtml}
                ${media}
                <p class="updates-panel__summary">${summary}</p>
              </li>`;
              },
            )
            .join("")}</ul>`;
        } catch {
          body.innerHTML = `<p class="updates-panel__empty">${escapeHtml(empty)}</p>`;
        }
      })();
    });
  }

  document.addEventListener("DOMContentLoaded", hydrateProductUpdates);
  document.addEventListener("astro:page-load", hydrateProductUpdates);
</script>

<style is:global>
  .product-updates-panel.updates-panel {
    display: flex;
    flex-direction: column;
    min-height: 0;
    max-height: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 12px);
    background: var(--color-bg-elevated, #101014);
    overflow: hidden;
  }
  .product-updates-panel .updates-panel__head {
    flex: 0 0 auto;
    padding: 1rem 1rem 0.65rem;
    border-bottom: 1px solid var(--color-border);
  }
  .product-updates-panel .updates-panel__body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding: 0.75rem 1rem 1rem;
  }
  .product-updates-panel .updates-panel__eyebrow {
    margin: 0;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-warm, #c9a962);
  }
  .product-updates-panel .updates-panel__title {
    margin: 0.35rem 0 0;
    font-size: 1.05rem;
    font-weight: 600;
  }
  .product-updates-panel .updates-panel__desc {
    margin: 0.35rem 0 0;
    font-size: 0.78rem;
    color: var(--color-muted);
    line-height: 1.4;
  }
  .product-updates-panel .updates-panel__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
  }
  .product-updates-panel .updates-panel__item {
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
  }
  .product-updates-panel .updates-panel__item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .product-updates-panel .updates-panel__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }
  .product-updates-panel .updates-panel__tag {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent, #c9a962);
  }
  .product-updates-panel .updates-panel__date {
    font-size: 0.68rem;
    color: var(--color-muted);
  }
  .product-updates-panel .updates-panel__item-title {
    margin: 0 0 0.35rem;
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .product-updates-panel .updates-panel__link {
    color: inherit;
    text-decoration: none;
  }
  .product-updates-panel .updates-panel__link:hover {
    color: var(--color-accent, #c9a962);
  }
  .product-updates-panel .updates-panel__media {
    margin: 0.4rem 0 0.45rem;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: #08080a;
  }
  .product-updates-panel .updates-panel__img,
  .product-updates-panel .updates-panel__video {
    display: block;
    width: 100%;
    max-height: 10rem;
    object-fit: cover;
  }
  .product-updates-panel .updates-panel__video {
    max-height: 12rem;
    object-fit: contain;
    background: #000;
  }
  .product-updates-panel .updates-panel__summary {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--color-muted);
  }
  .product-updates-panel .updates-panel__empty {
    margin: 0.5rem 0;
    font-size: 0.8rem;
    color: var(--color-muted);
  }
</style>
