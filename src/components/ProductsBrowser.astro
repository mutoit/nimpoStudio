---
/**
 * Productos software: panel lateral + ficha (layout A).
 * Hidrata desde /api/products (R2). Seed opcional desde build.
 */
import type { Locale } from "../i18n/translations";
import { useTranslations } from "../lib/locale";
import { safeMediaUrl } from "../lib/dom-escape";

export type ProductSeed = {
  slug: string;
  name: string;
  category?: string;
  status?: string;
  shortDescription?: string;
  description?: string;
  images?: string[];
  video?: string | null;
  tags?: string[];
  formats?: string[];
  featured?: boolean;
};

type Props = {
  items?: ProductSeed[];
  lang?: Locale;
};

const { items = [], lang = "es" } = Astro.props;
const t = useTranslations(lang);

const seed = items.map((p) => ({
  slug: p.slug,
  name: p.name,
  category: p.category || "other",
  status: p.status || "published",
  shortDescription: p.shortDescription || "",
  description: p.description || "",
  images: (p.images || []).map((u) => safeMediaUrl(u)).filter(Boolean),
  video: safeMediaUrl(p.video) || null,
  tags: p.tags || [],
  formats: p.formats || [],
  featured: Boolean(p.featured),
}));

const payload = {
  lang,
  labels: {
    empty: t("catalogEmptyTitle"),
    emptyDesc: t("catalogEmptyDesc"),
    soon: t("productSoon"),
    beta: t("productBeta"),
    demoStatus: t("productDemoStatus"),
    freeOrOnRequest: t("productNoPrice"),
    available: lang === "en" ? "Available" : lang === "fr" ? "Disponible" : "Disponible",
    contact: t("navContact"),
    formats: t("productFormats"),
    tags: t("productTags"),
    video: lang === "en" ? "Video" : lang === "fr" ? "Vidéo" : "Vídeo",
    image: lang === "en" ? "Image" : "Imagen",
    select: lang === "en" ? "Select a product" : lang === "fr" ? "Choisissez un produit" : "Elige un producto",
    demo: t("productDemo"),
    demoBeta: t("productDemoBeta"),
    demoRequest: t("productDemoRequest"),
    buy: t("productBuy"),
    buyRequest: t("productBuyRequest"),
    feedback: t("productFeedback"),
    feedbackTitle: t("productFeedbackTitle"),
    feedbackLead: t("productFeedbackLead"),
    feedbackChannel: t("productFeedbackChannel"),
    feedbackSubtype: t("productFeedbackSubtype"),
    feedbackBug: t("productFeedbackBug"),
    feedbackSuggestion: t("productFeedbackSuggestion"),
    feedbackSupport: t("productFeedbackSupport"),
    feedbackOther: t("productFeedbackOther"),
    feedbackName: t("quoteName"),
    feedbackEmail: t("quoteEmail"),
    feedbackMessage: t("productFeedbackMessage"),
    feedbackSend: t("productFeedbackSend"),
    feedbackOk: t("productFeedbackOk"),
    feedbackErr: t("productFeedbackErr"),
    feedbackVerified: t("productFeedbackVerified"),
    feedbackProspect: t("productFeedbackProspect"),
    feedbackVerify: t("productFeedbackVerify"),
    priceFrom: t("productPriceFrom"),
    version: t("productVersion"),
    accountPath: `/${lang}/cuenta/`,
  },
  contactHref: `/${lang}/contacto/`,
  contactEmail: "contacto@nimpo3dstudio.com",
  seed,
  accountPath: `/${lang}/cuenta/`,
};
---

<div class="pb" data-products-root data-payload={JSON.stringify(payload)}>
  <div class="pb__shop">
    <aside class="pb__panel" aria-label={t("catalogTitle")}>
      <div class="pb__panel-head">
        <p class="pb__eyebrow">{t("catalogSubtitle")}</p>
        <p class="pb__panel-title">{t("catalogTitle")}</p>
      </div>
      <ul class="pb__list" data-pb-list></ul>
    </aside>

    <article class="pb__detail" data-pb-detail aria-live="polite">
      <div class="pb__empty" data-pb-empty>
        <p class="pb__empty-title" data-pb-empty-title>{t("catalogEmptyTitle")}</p>
        {
          t("catalogEmptyDesc") ? (
            <p class="pb__empty-desc" data-pb-empty-desc>
              {t("catalogEmptyDesc")}
            </p>
          ) : (
            <p class="pb__empty-desc" data-pb-empty-desc hidden></p>
          )
        }
      </div>
      <div class="pb__grid" data-pb-grid hidden>
        <div class="pb__media">
          <span class="pb__kind" data-pb-kind></span>
          <div class="pb__stage" data-pb-stage></div>
          <div class="pb__dots" data-pb-dots hidden></div>
        </div>
        <div class="pb__info">
          <div class="pb__chips" data-pb-chips></div>
          <h2 class="pb__name" data-pb-name></h2>
          <p class="pb__short" data-pb-short></p>
          <p class="pb__body" data-pb-body></p>
          <div class="pb__meta" data-pb-formats-wrap hidden>
            <span class="pb__meta-label" data-pb-formats-label>{t("productFormats")}</span>
            <div class="pb__tags" data-pb-formats></div>
          </div>
          <div class="pb__meta" data-pb-tags-wrap hidden>
            <span class="pb__meta-label" data-pb-tags-label>{t("productTags")}</span>
            <div class="pb__tags" data-pb-tags></div>
          </div>
          <div class="pb__price" data-pb-price hidden></div>
          <div class="pb__actions" data-pb-actions>
            <a class="pb__btn pb__btn--ghost" data-pb-demo hidden target="_blank" rel="noopener">{t("productDemo")}</a>
            <button type="button" class="pb__btn pb__btn--ghost" data-pb-demo-request hidden>{t("productDemoRequest")}</button>
            <button type="button" class="pb__btn pb__btn--gold" data-pb-checkout hidden>{t("productBuy")}</button>
            <a class="pb__btn pb__btn--gold" data-pb-buy hidden target="_blank" rel="noopener">{t("productBuy")}</a>
            <a class="pb__btn pb__btn--gold" data-pb-buy-mail hidden>{t("productBuyRequest")}</a>
            <button type="button" class="pb__btn pb__btn--ghost" data-pb-feedback>{t("productFeedback")}</button>
            <a class="pb__btn pb__btn--ghost" data-pb-contact href={`/${lang}/contacto/`}>{t("navContact")}</a>
          </div>
          <form class="pb__feedback" data-pb-feedback-form hidden>
            <p class="pb__feedback-title" data-pb-feedback-title>{t("productFeedbackTitle")}</p>
            <p class="pb__feedback-lead">{t("productFeedbackLead")}</p>
            <p class="pb__feedback-badge" data-fb-badge hidden></p>
            <label>
              {t("productFeedbackChannel")}
              <select name="channel" data-fb-channel>
                <option value="bug">{t("productFeedbackBug")}</option>
                <option value="suggestion">{t("productFeedbackSuggestion")}</option>
                <option value="support">{t("productFeedbackSupport")}</option>
                <option value="other">{t("productFeedbackOther")}</option>
              </select>
            </label>
            <label>
              {t("productFeedbackSubtype")}
              <select name="subtype" data-fb-subtype></select>
            </label>
            <label data-fb-name-wrap>
              {t("quoteName")}
              <input name="name" data-fb-name maxlength="120" autocomplete="name" />
            </label>
            <label data-fb-email-wrap>
              {t("quoteEmail")}
              <input name="email" type="email" data-fb-email maxlength="200" autocomplete="email" />
            </label>
            <p class="pb__feedback-verify-row">
              <a class="pb__btn pb__btn--ghost" data-fb-verify href={`/${lang}/cuenta/`}>{t("productFeedbackVerify")}</a>
            </p>
            <label>
              {t("productFeedbackMessage")}
              <textarea name="message" required data-fb-message rows="4" maxlength="4000"></textarea>
            </label>
            <div class="pb__feedback-actions">
              <button type="submit" class="pb__btn pb__btn--gold" data-fb-submit>{t("productFeedbackSend")}</button>
              <button type="button" class="pb__btn pb__btn--ghost" data-fb-cancel>{t("libClose")}</button>
            </div>
            <p class="pb__feedback-status" data-fb-status hidden></p>
          </form>
        </div>
      </div>
    </article>
  </div>
</div>

<script>
  import { escapeHtml, safeMediaUrl, safeDomId } from "../lib/dom-escape";

  type DemoInfo = { kind: string; url?: string | null; notes?: string };
  type PlanInfo = {
    id: string;
    name: string;
    priceEur: number | null;
    buyUrl?: string | null;
    stripePriceId?: string | null;
    checkoutReady?: boolean;
  };

  type Item = {
    slug: string;
    name: string;
    category: string;
    status: string;
    shortDescription: string;
    description: string;
    images: string[];
    video: string | null;
    tags: string[];
    formats: string[];
    featured?: boolean;
    demo?: DemoInfo;
    pricing?: PlanInfo[];
    version?: string;
  };

  type Media = { type: "image" | "video"; src: string };

  function buildMedia(item: Item): Media[] {
    const out: Media[] = [];
    for (const img of item.images || []) {
      const src = safeMediaUrl(img);
      if (src) out.push({ type: "image", src });
    }
    const v = safeMediaUrl(item.video);
    if (v) out.push({ type: "video", src: v });
    return out;
  }

  function thumbHtml(item: Item) {
    const media = buildMedia(item);
    const first = media[0];
    if (!first) return `<span class="pb__ph"></span>`;
    if (first.type === "video") {
      return `<video src="${escapeHtml(first.src)}" muted playsinline preload="metadata"></video>`;
    }
    return `<img src="${escapeHtml(first.src)}" alt="" loading="lazy" />`;
  }

  function bindRoot(root: HTMLElement) {
    if (root.dataset.bound === "1") return;
    root.dataset.bound = "1";

    let payload: {
      labels: Record<string, string>;
      contactHref: string;
      contactEmail?: string;
      seed: Item[];
    } = { labels: {}, contactHref: "/es/contacto/", contactEmail: "contacto@nimpo3dstudio.com", seed: [] };
    try {
      payload = JSON.parse(root.dataset.payload || "{}");
    } catch {
      /* */
    }

    const L = payload.labels || {};
    const studioMail = payload.contactEmail || "contacto@nimpo3dstudio.com";
    let items: Item[] = Array.isArray(payload.seed) ? [...payload.seed] : [];
    let activeSlug = items[0]?.slug || "";
    let mediaIndex = 0;

    const listEl = root.querySelector("[data-pb-list]");
    const emptyEl = root.querySelector("[data-pb-empty]");
    const gridEl = root.querySelector("[data-pb-grid]");
    const stageEl = root.querySelector("[data-pb-stage]");
    const dotsEl = root.querySelector("[data-pb-dots]");
    const kindEl = root.querySelector("[data-pb-kind]");
    const chipsEl = root.querySelector("[data-pb-chips]");
    const nameEl = root.querySelector("[data-pb-name]");
    const shortEl = root.querySelector("[data-pb-short]");
    const bodyEl = root.querySelector("[data-pb-body]");
    const formatsWrap = root.querySelector("[data-pb-formats-wrap]");
    const formatsEl = root.querySelector("[data-pb-formats]");
    const tagsWrap = root.querySelector("[data-pb-tags-wrap]");
    const tagsEl = root.querySelector("[data-pb-tags]");
    const contactEl = root.querySelector("[data-pb-contact]");
    const priceEl = root.querySelector("[data-pb-price]");
    const demoEl = root.querySelector("[data-pb-demo]");
    const demoReqEl = root.querySelector("[data-pb-demo-request]");
    const buyEl = root.querySelector("[data-pb-buy]");
    const buyMailEl = root.querySelector("[data-pb-buy-mail]");
    const checkoutEl = root.querySelector("[data-pb-checkout]");
    const feedbackBtn = root.querySelector("[data-pb-feedback]");
    const feedbackForm = root.querySelector("[data-pb-feedback-form]");

    if (contactEl instanceof HTMLAnchorElement && payload.contactHref) {
      contactEl.href = payload.contactHref;
    }

    const SUBTYPES: Record<string, string[]> = {
      bug: ["crash", "install", "license_activate", "performance", "ui", "data_loss", "other"],
      suggestion: ["cosmetic", "visual", "feature", "workflow", "docs", "other"],
      support: [
        "download",
        "license",
        "billing",
        "how_to",
        "account_recovery",
        "email_change",
        "lost_license",
        "reset_devices",
        "missing_order",
        "other",
      ],
      other: ["other"],
    };

    let accountEmail = "";
    let accountBuyer = false;

    const fillSubtypes = (channel: string) => {
      if (!(feedbackForm instanceof HTMLFormElement)) return;
      const sel = feedbackForm.querySelector("[data-fb-subtype]") as HTMLSelectElement | null;
      if (!sel) return;
      const list = SUBTYPES[channel] || SUBTYPES.other;
      sel.innerHTML = list
        .map((s) => `<option value="${s}">${s.replace(/_/g, " ")}</option>`)
        .join("");
    };

    const paintFeedbackIdentity = () => {
      if (!(feedbackForm instanceof HTMLFormElement)) return;
      const badge = feedbackForm.querySelector("[data-fb-badge]");
      const emailWrap = feedbackForm.querySelector("[data-fb-email-wrap]");
      const emailInput = feedbackForm.querySelector("[data-fb-email]") as HTMLInputElement | null;
      const verify = feedbackForm.querySelector("[data-fb-verify]");
      if (badge instanceof HTMLElement) {
        badge.hidden = false;
        if (accountEmail && accountBuyer) {
          badge.textContent = `${L.feedbackVerified || "Cliente"} · ${accountEmail}`;
          badge.classList.add("is-client");
          badge.classList.remove("is-prospect");
        } else if (accountEmail) {
          badge.textContent = `${L.feedbackProspect || "Prospect"} · ${accountEmail}`;
          badge.classList.add("is-prospect");
          badge.classList.remove("is-client");
        } else {
          badge.textContent = L.feedbackProspect || "Prospect";
          badge.classList.add("is-prospect");
          badge.classList.remove("is-client");
        }
      }
      if (emailWrap instanceof HTMLElement) {
        emailWrap.hidden = Boolean(accountEmail);
      }
      if (emailInput) {
        emailInput.required = !accountEmail;
        if (accountEmail) emailInput.value = accountEmail;
      }
      if (verify instanceof HTMLAnchorElement) {
        const base = String(payload.accountPath || L.accountPath || "/es/cuenta/");
        verify.href = base;
        verify.hidden = Boolean(accountEmail && accountBuyer);
      }
    };

    const refreshAccount = async () => {
      try {
        const res = await fetch("/api/account/session", { credentials: "same-origin" });
        const data = await res.json();
        if (data?.authenticated && data.email) {
          accountEmail = String(data.email);
          accountBuyer = Boolean(data.buyer);
        } else {
          accountEmail = "";
          accountBuyer = false;
        }
      } catch {
        accountEmail = "";
        accountBuyer = false;
      }
      paintFeedbackIdentity();
    };

    const showFeedback = (preChannel?: string) => {
      if (!(feedbackForm instanceof HTMLFormElement)) return;
      feedbackForm.hidden = false;
      const ch = preChannel || "bug";
      const sel = feedbackForm.querySelector("[data-fb-channel]") as HTMLSelectElement | null;
      if (sel) sel.value = ch;
      fillSubtypes(ch);
      paintFeedbackIdentity();
      void refreshAccount();
      feedbackForm.scrollIntoView({ behavior: "smooth", block: "nearest" });
    };

    feedbackBtn?.addEventListener("click", () => showFeedback("bug"));
    root.querySelector("[data-fb-cancel]")?.addEventListener("click", () => {
      if (feedbackForm instanceof HTMLFormElement) feedbackForm.hidden = true;
    });

    if (feedbackForm instanceof HTMLFormElement) {
      fillSubtypes("bug");
      feedbackForm.querySelector("[data-fb-channel]")?.addEventListener("change", (ev) => {
        const v = (ev.target as HTMLSelectElement).value;
        fillSubtypes(v);
      });

      feedbackForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const status = feedbackForm.querySelector("[data-fb-status]");
        const submit = feedbackForm.querySelector("[data-fb-submit]");
        const name = String(
          (feedbackForm.querySelector("[data-fb-name]") as HTMLInputElement | null)?.value || "",
        ).trim();
        const email = String(
          (feedbackForm.querySelector("[data-fb-email]") as HTMLInputElement | null)?.value ||
            accountEmail ||
            "",
        ).trim();
        const message = String(
          (feedbackForm.querySelector("[data-fb-message]") as HTMLTextAreaElement | null)?.value ||
            "",
        ).trim();
        const channel = String(
          (feedbackForm.querySelector("[data-fb-channel]") as HTMLSelectElement | null)?.value ||
            "other",
        );
        const subtype = String(
          (feedbackForm.querySelector("[data-fb-subtype]") as HTMLSelectElement | null)?.value ||
            "other",
        );
        if (!accountEmail && !email) {
          if (status instanceof HTMLElement) {
            status.hidden = false;
            status.textContent = L.feedbackErr || "Email required";
            status.classList.add("is-err");
          }
          return;
        }
        if (submit instanceof HTMLButtonElement) submit.disabled = true;
        if (status instanceof HTMLElement) {
          status.hidden = false;
          status.textContent = "…";
          status.classList.remove("is-err", "is-ok");
        }
        try {
          const res = await fetch("/api/feedback", {
            method: "POST",
            credentials: "same-origin",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify({
              productSlug: activeSlug || undefined,
              channel,
              subtype,
              name,
              email: accountEmail || email,
              message,
            }),
          });
          const data = await res.json();
          if (!res.ok || !data.ok) {
            throw new Error(data.message || data.error || `Error ${res.status}`);
          }
          if (status instanceof HTMLElement) {
            const who = data.buyer ? L.feedbackVerified || "CLIENT" : L.feedbackProspect || "PROSPECT";
            status.textContent = `${L.feedbackOk || data.message || "OK"} (${who})`;
            status.classList.add("is-ok");
          }
          const msgEl = feedbackForm.querySelector("[data-fb-message]") as HTMLTextAreaElement | null;
          if (msgEl) msgEl.value = "";
        } catch (err) {
          if (status instanceof HTMLElement) {
            status.textContent =
              err instanceof Error ? err.message : L.feedbackErr || "Error";
            status.classList.add("is-err");
          }
        } finally {
          if (submit instanceof HTMLButtonElement) submit.disabled = false;
        }
      });
    }

    demoReqEl?.addEventListener("click", () => showFeedback("suggestion"));

    checkoutEl?.addEventListener("click", async () => {
      const item = items.find((x) => x.slug === activeSlug);
      if (!item) return;
      const plan = item.pricing?.[0];
      if (checkoutEl instanceof HTMLButtonElement) checkoutEl.disabled = true;
      try {
        const res = await fetch("/api/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({
            productSlug: item.slug,
            planId: plan?.id,
          }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok || !data.url) {
          throw new Error(data.message || data.error || `Error ${res.status}`);
        }
        window.location.href = data.url;
      } catch (e) {
        alert(e instanceof Error ? e.message : "Checkout error");
      } finally {
        if (checkoutEl instanceof HTMLButtonElement) checkoutEl.disabled = false;
      }
    });

    const stopVideos = () => {
      stageEl?.querySelectorAll("video").forEach((v) => {
        try {
          v.pause();
        } catch {
          /* */
        }
      });
    };

    const setDeepLink = (slug: string) => {
      try {
        const u = new URL(window.location.href);
        if (slug) u.searchParams.set("p", slug);
        else u.searchParams.delete("p");
        history.replaceState(null, "", u.pathname + u.search);
      } catch {
        /* */
      }
    };

    const renderList = () => {
      if (!listEl) return;
      if (!items.length) {
        listEl.innerHTML = `<li class="pb__list-empty">${escapeHtml(L.empty || "—")}</li>`;
        return;
      }
      listEl.innerHTML = items
        .map((item) => {
          const on = item.slug === activeSlug ? " is-on" : "";
          const id = safeDomId(item.slug);
          return `<li>
            <button type="button" class="pb__item${on}" data-slug="${escapeHtml(item.slug)}" id="pb-item-${id}">
              <span class="pb__thumb">${thumbHtml(item)}</span>
              <span class="pb__meta">
                <span class="pb__item-name">${escapeHtml(item.name)}</span>
                <span class="pb__item-cat">${escapeHtml(item.category || "")}</span>
              </span>
            </button>
          </li>`;
        })
        .join("");

      listEl.querySelectorAll("[data-slug]").forEach((btn) => {
        btn.addEventListener("click", () => {
          activeSlug = (btn as HTMLElement).dataset.slug || "";
          mediaIndex = 0;
          renderList();
          renderDetail();
          setDeepLink(activeSlug);
        });
      });
    };

    const renderDetail = () => {
      const item = items.find((x) => x.slug === activeSlug);
      if (!item) {
        if (emptyEl instanceof HTMLElement) emptyEl.hidden = false;
        if (gridEl instanceof HTMLElement) gridEl.hidden = true;
        return;
      }
      if (emptyEl instanceof HTMLElement) emptyEl.hidden = true;
      if (gridEl instanceof HTMLElement) gridEl.hidden = false;

      if (nameEl) nameEl.textContent = item.name;
      if (shortEl) shortEl.textContent = item.shortDescription || "";
      if (bodyEl) bodyEl.textContent = item.description || "";

      if (chipsEl) {
        const st = item.status || "published";
        const statusLabel =
          st === "coming-soon"
            ? L.soon || "Soon"
            : st === "beta"
              ? L.beta || "Beta"
              : st === "demo"
                ? L.demoStatus || "Demo"
                : L.available || "OK";
        const statusMod =
          st === "coming-soon"
            ? " pb__chip--soon"
            : st === "beta"
              ? " pb__chip--beta"
              : st === "demo"
                ? " pb__chip--demo"
                : "";
        chipsEl.innerHTML = `
          <span class="pb__chip">${escapeHtml(item.category || "software")}</span>
          <span class="pb__chip${statusMod}">${escapeHtml(statusLabel)}</span>
        `;
      }

      if (formatsEl && formatsWrap instanceof HTMLElement) {
        const f = item.formats || [];
        formatsWrap.hidden = !f.length;
        formatsEl.innerHTML = f.map((x) => `<span class="pb__tag">${escapeHtml(x)}</span>`).join("");
      }
      if (tagsEl && tagsWrap instanceof HTMLElement) {
        const tg = item.tags || [];
        tagsWrap.hidden = !tg.length;
        tagsEl.innerHTML = tg.map((x) => `<span class="pb__tag">${escapeHtml(x)}</span>`).join("");
      }

      // Pricing display (decimales 9.90; beta/demo sin precio = sin forzar compra)
      const plan = (item.pricing && item.pricing[0]) || null;
      const skipPrice = item.status === "beta" || item.status === "demo";
      const formatEur = (n: number) => {
        const r = Math.round(Number(n) * 100) / 100;
        return Number.isInteger(r) ? String(r) : r.toFixed(2);
      };
      if (priceEl instanceof HTMLElement) {
        if (plan && plan.priceEur != null && Number.isFinite(Number(plan.priceEur))) {
          priceEl.hidden = false;
          const ver = item.version ? ` · ${L.version || "v"} ${escapeHtml(item.version)}` : "";
          priceEl.innerHTML = `<strong>${escapeHtml(plan.name || "")}</strong> · ${L.priceFrom || ""} ${formatEur(Number(plan.priceEur))} €${ver}`;
        } else if (skipPrice) {
          priceEl.hidden = false;
          const ver = item.version ? ` · ${L.version || "v"} ${item.version}` : "";
          priceEl.textContent = `${L.freeOrOnRequest || "Beta / demo"}${ver}`;
        } else if (item.version) {
          priceEl.hidden = false;
          priceEl.textContent = `${L.version || "v"} ${item.version}`;
        } else {
          priceEl.hidden = true;
          priceEl.textContent = "";
        }
      }

      // Demo CTA
      const demo = item.demo || { kind: "none" };
      const demoKind = String(demo.kind || "none");
      const demoUrlRaw = String(demo.url || "").trim();
      const demoUrl =
        safeMediaUrl(demoUrlRaw) ||
        (/^https:\/\//i.test(demoUrlRaw) ? demoUrlRaw : "") ||
        (demoUrlRaw.startsWith("mailto:") ? demoUrlRaw : "");
      // Mismo botón: etiqueta según status del producto (beta → "Probar beta")
      const demoLabel =
        item.status === "beta"
          ? L.demoBeta || L.demo || "Beta"
          : L.demo || "Demo";
      if (demoEl instanceof HTMLAnchorElement) {
        if ((demoKind === "download" || demoKind === "web") && demoUrl) {
          demoEl.hidden = false;
          demoEl.href = demoUrl;
          demoEl.textContent = demoLabel;
        } else {
          demoEl.hidden = true;
          demoEl.removeAttribute("href");
        }
      }
      if (demoReqEl instanceof HTMLElement) {
        if (demoKind === "request") {
          demoReqEl.hidden = false;
          demoReqEl.textContent =
            item.status === "beta"
              ? L.demoBeta || L.demoRequest || "Beta"
              : L.demoRequest || "Request demo";
        } else {
          demoReqEl.hidden = true;
        }
      }

      // Buy CTA: Checkout / Payment Link / mailto.
      // Beta/demo sin stripe ni buyUrl: no pedir precio ni compra (solo demo/feedback).
      const buyUrl = plan?.buyUrl ? String(plan.buyUrl).trim() : "";
      const canCheckout = Boolean(plan?.stripePriceId || plan?.checkoutReady);
      const hasPaidPath =
        canCheckout || (buyUrl && /^https:\/\//i.test(buyUrl));
      if (checkoutEl instanceof HTMLElement) {
        checkoutEl.hidden = !canCheckout;
      }
      if (buyEl instanceof HTMLAnchorElement) {
        if (!canCheckout && buyUrl && /^https:\/\//i.test(buyUrl)) {
          buyEl.hidden = false;
          buyEl.href = buyUrl;
          buyEl.textContent = L.buy || "Buy";
        } else {
          buyEl.hidden = true;
          buyEl.removeAttribute("href");
        }
      }
      if (buyMailEl instanceof HTMLAnchorElement) {
        if (!hasPaidPath && !skipPrice) {
          buyMailEl.hidden = false;
          const subj = encodeURIComponent(`Compra / buy: ${item.name}`);
          const body = encodeURIComponent(
            `Producto: ${item.name} (${item.slug})\nPlan: ${plan?.name || "standard"}\n\n`,
          );
          buyMailEl.href = `mailto:${studioMail}?subject=${subj}&body=${body}`;
          buyMailEl.textContent = L.buyRequest || L.buy || "Buy";
        } else {
          buyMailEl.hidden = true;
          buyMailEl.removeAttribute("href");
        }
      }

      if (feedbackForm instanceof HTMLFormElement) {
        feedbackForm.hidden = true;
      }

      const media = buildMedia(item);
      stopVideos();
      if (!stageEl) return;

      if (!media.length) {
        if (kindEl) kindEl.textContent = "";
        stageEl.innerHTML = `<div class="pb__ph pb__ph--lg"></div>`;
        if (dotsEl instanceof HTMLElement) {
          dotsEl.hidden = true;
          dotsEl.innerHTML = "";
        }
        return;
      }

      const m = media[Math.min(mediaIndex, media.length - 1)] || media[0];
      if (kindEl) kindEl.textContent = m.type === "video" ? L.video || "Video" : L.image || "Image";
      if (m.type === "video") {
        stageEl.innerHTML = `<video src="${escapeHtml(m.src)}" controls playsinline preload="metadata"></video>`;
      } else {
        stageEl.innerHTML = `<img src="${escapeHtml(m.src)}" alt="" />`;
      }

      if (dotsEl instanceof HTMLElement) {
        if (media.length > 1) {
          dotsEl.hidden = false;
          dotsEl.innerHTML = media
            .map((itemM, i) => {
              const on = i === mediaIndex ? " is-on" : "";
              const inner =
                itemM.type === "video"
                  ? `<video src="${escapeHtml(itemM.src)}" muted playsinline preload="metadata"></video>`
                  : `<img src="${escapeHtml(itemM.src)}" alt="" />`;
              return `<button type="button" class="pb__dot${on}" data-mi="${i}" aria-label="media ${i + 1}">${inner}</button>`;
            })
            .join("");
          dotsEl.querySelectorAll("[data-mi]").forEach((b) => {
            b.addEventListener("click", () => {
              mediaIndex = Number((b as HTMLElement).dataset.mi || 0);
              renderDetail();
            });
          });
        } else {
          dotsEl.hidden = true;
          dotsEl.innerHTML = "";
        }
      }
    };

    const apply = () => {
      if (!items.length) {
        activeSlug = "";
        if (emptyEl instanceof HTMLElement) {
          emptyEl.hidden = false;
          const tEl = emptyEl.querySelector("[data-pb-empty-title]");
          const d = emptyEl.querySelector("[data-pb-empty-desc]");
          if (tEl) tEl.textContent = L.empty || "";
          if (d instanceof HTMLElement) {
            const desc = (L.emptyDesc || "").trim();
            d.textContent = desc;
            d.hidden = !desc;
          }
        }
        if (gridEl instanceof HTMLElement) gridEl.hidden = true;
      } else {
        if (!items.some((x) => x.slug === activeSlug)) {
          activeSlug = items[0].slug;
          mediaIndex = 0;
        }
      }
      renderList();
      renderDetail();
    };

    apply();

    // deep-link ?p=slug
    try {
      const p = new URL(window.location.href).searchParams.get("p")?.trim();
      if (p && items.some((x) => x.slug === p)) {
        activeSlug = p;
        mediaIndex = 0;
        apply();
      }
    } catch {
      /* */
    }

    const mapProduct = (raw: Record<string, unknown>): Item | null => {
      const slug = String(raw.slug || "");
      const name = String(raw.name || "");
      if (!slug || !name) return null;
      const demoRaw = raw.demo && typeof raw.demo === "object" ? (raw.demo as Record<string, unknown>) : null;
      const pricingRaw = Array.isArray(raw.pricing) ? raw.pricing : [];
      return {
        slug,
        name,
        category: String(raw.category || "other"),
        status: String(raw.status || "published"),
        shortDescription: String(raw.shortDescription || ""),
        description: String(raw.description || ""),
        images: Array.isArray(raw.images)
          ? raw.images.map((u) => safeMediaUrl(String(u))).filter(Boolean)
          : [],
        video: safeMediaUrl(raw.video as string) || null,
        tags: Array.isArray(raw.tags) ? raw.tags.map(String) : [],
        formats: Array.isArray(raw.formats) ? raw.formats.map(String) : [],
        featured: Boolean(raw.featured),
        version: raw.version ? String(raw.version) : undefined,
        demo: demoRaw
          ? {
              kind: String(demoRaw.kind || "none"),
              url: demoRaw.url != null ? String(demoRaw.url) : null,
              notes: demoRaw.notes != null ? String(demoRaw.notes) : "",
            }
          : { kind: "none", url: null, notes: "" },
        pricing: pricingRaw
          .map((p) => {
            if (!p || typeof p !== "object") return null;
            const o = p as Record<string, unknown>;
            return {
              id: String(o.id || "standard"),
              name: String(o.name || "Standard"),
              priceEur:
                o.priceEur == null || o.priceEur === ""
                  ? null
                  : Number(o.priceEur),
              buyUrl: o.buyUrl != null ? String(o.buyUrl) : null,
              stripePriceId: o.stripePriceId != null ? String(o.stripePriceId) : null,
              checkoutReady: Boolean(o.checkoutReady || o.stripePriceId),
            } satisfies PlanInfo;
          })
          .filter((x): x is PlanInfo => x != null),
      };
    };

    void (async () => {
      try {
        // Paginado: acumular páginas (escala catálogo productos)
        let cursor: string | null = null;
        let all: Item[] = [];
        let guard = 0;
        do {
          const q = new URLSearchParams({ limit: "48" });
          if (cursor) q.set("cursor", cursor);
          const res = await fetch(`/api/products?${q}`, {
            credentials: "same-origin",
          });
          if (!res.ok) break;
          const data = await res.json();
          if (!data?.ok || !Array.isArray(data.items)) break;
          for (const raw of data.items) {
            const m = mapProduct(raw as Record<string, unknown>);
            if (m) all.push(m);
          }
          cursor = data.hasMore && data.nextCursor ? String(data.nextCursor) : null;
          guard++;
        } while (cursor && guard < 20);
        if (all.length) {
          items = all;
          apply();
          try {
            const p = new URL(window.location.href).searchParams.get("p")?.trim();
            if (p && items.some((x) => x.slug === p)) {
              activeSlug = p;
              mediaIndex = 0;
              apply();
            }
          } catch {
            /* */
          }
        }
      } catch {
        /* keep seed */
      }
    })();
  }

  function init() {
    document.querySelectorAll("[data-products-root]").forEach((el) => {
      if (el instanceof HTMLElement) bindRoot(el);
    });
  }

  document.addEventListener("DOMContentLoaded", init);
  document.addEventListener("astro:page-load", init);
</script>

