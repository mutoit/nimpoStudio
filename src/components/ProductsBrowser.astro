---
/**
 * Productos software: panel lateral + ficha (layout A).
 * Hidrata desde /api/products (R2). Seed opcional desde build.
 */
import type { Locale } from "../i18n/translations";
import { useTranslations } from "../lib/locale";
import { safeMediaUrl } from "../lib/dom-escape";

export type ProductSeed = {
  slug: string;
  name: string;
  category?: string;
  status?: string;
  shortDescription?: string;
  description?: string;
  images?: string[];
  video?: string | null;
  tags?: string[];
  formats?: string[];
  featured?: boolean;
};

type Props = {
  items?: ProductSeed[];
  lang?: Locale;
};

const { items = [], lang = "es" } = Astro.props;
const t = useTranslations(lang);

const seed = items.map((p) => ({
  slug: p.slug,
  name: p.name,
  category: p.category || "other",
  status: p.status || "published",
  shortDescription: p.shortDescription || "",
  description: p.description || "",
  images: (p.images || []).map((u) => safeMediaUrl(u)).filter(Boolean),
  video: safeMediaUrl(p.video) || null,
  tags: p.tags || [],
  formats: p.formats || [],
  featured: Boolean(p.featured),
}));

const payload = {
  lang,
  labels: {
    empty: t("catalogEmptyTitle"),
    emptyDesc: t("catalogEmptyDesc"),
    soon: t("productSoon"),
    available: lang === "en" ? "Available" : lang === "fr" ? "Disponible" : "Disponible",
    contact: t("navContact"),
    formats: t("productFormats"),
    tags: t("productTags"),
    video: lang === "en" ? "Video" : lang === "fr" ? "Vidéo" : "Vídeo",
    image: lang === "en" ? "Image" : "Imagen",
    select: lang === "en" ? "Select a product" : lang === "fr" ? "Choisissez un produit" : "Elige un producto",
  },
  contactHref: `/${lang}/contacto/`,
  seed,
};
---

<div class="pb" data-products-root data-payload={JSON.stringify(payload)}>
  <div class="pb__shop">
    <aside class="pb__panel" aria-label={t("catalogTitle")}>
      <div class="pb__panel-head">
        <p class="pb__eyebrow">{t("catalogSubtitle")}</p>
        <p class="pb__panel-title">{t("catalogTitle")}</p>
      </div>
      <ul class="pb__list" data-pb-list></ul>
    </aside>

    <article class="pb__detail" data-pb-detail aria-live="polite">
      <div class="pb__empty" data-pb-empty>
        <p class="pb__empty-title" data-pb-empty-title>{t("catalogEmptyTitle")}</p>
        {
          t("catalogEmptyDesc") ? (
            <p class="pb__empty-desc" data-pb-empty-desc>
              {t("catalogEmptyDesc")}
            </p>
          ) : (
            <p class="pb__empty-desc" data-pb-empty-desc hidden></p>
          )
        }
      </div>
      <div class="pb__grid" data-pb-grid hidden>
        <div class="pb__media">
          <span class="pb__kind" data-pb-kind></span>
          <div class="pb__stage" data-pb-stage></div>
          <div class="pb__dots" data-pb-dots hidden></div>
        </div>
        <div class="pb__info">
          <div class="pb__chips" data-pb-chips></div>
          <h2 class="pb__name" data-pb-name></h2>
          <p class="pb__short" data-pb-short></p>
          <p class="pb__body" data-pb-body></p>
          <div class="pb__meta" data-pb-formats-wrap hidden>
            <span class="pb__meta-label" data-pb-formats-label>{t("productFormats")}</span>
            <div class="pb__tags" data-pb-formats></div>
          </div>
          <div class="pb__meta" data-pb-tags-wrap hidden>
            <span class="pb__meta-label" data-pb-tags-label>{t("productTags")}</span>
            <div class="pb__tags" data-pb-tags></div>
          </div>
          <div class="pb__actions">
            <a class="pb__btn pb__btn--gold" data-pb-contact href={`/${lang}/contacto/`}>{t("navContact")}</a>
          </div>
        </div>
      </div>
    </article>
  </div>
</div>

<script>
  import { escapeHtml, safeMediaUrl, safeDomId } from "../lib/dom-escape";

  type Item = {
    slug: string;
    name: string;
    category: string;
    status: string;
    shortDescription: string;
    description: string;
    images: string[];
    video: string | null;
    tags: string[];
    formats: string[];
    featured?: boolean;
  };

  type Media = { type: "image" | "video"; src: string };

  function buildMedia(item: Item): Media[] {
    const out: Media[] = [];
    for (const img of item.images || []) {
      const src = safeMediaUrl(img);
      if (src) out.push({ type: "image", src });
    }
    const v = safeMediaUrl(item.video);
    if (v) out.push({ type: "video", src: v });
    return out;
  }

  function thumbHtml(item: Item) {
    const media = buildMedia(item);
    const first = media[0];
    if (!first) return `<span class="pb__ph"></span>`;
    if (first.type === "video") {
      return `<video src="${escapeHtml(first.src)}" muted playsinline preload="metadata"></video>`;
    }
    return `<img src="${escapeHtml(first.src)}" alt="" loading="lazy" />`;
  }

  function bindRoot(root: HTMLElement) {
    if (root.dataset.bound === "1") return;
    root.dataset.bound = "1";

    let payload: {
      labels: Record<string, string>;
      contactHref: string;
      seed: Item[];
    } = { labels: {}, contactHref: "/es/contacto/", seed: [] };
    try {
      payload = JSON.parse(root.dataset.payload || "{}");
    } catch {
      /* */
    }

    const L = payload.labels || {};
    let items: Item[] = Array.isArray(payload.seed) ? [...payload.seed] : [];
    let activeSlug = items[0]?.slug || "";
    let mediaIndex = 0;

    const listEl = root.querySelector("[data-pb-list]");
    const emptyEl = root.querySelector("[data-pb-empty]");
    const gridEl = root.querySelector("[data-pb-grid]");
    const stageEl = root.querySelector("[data-pb-stage]");
    const dotsEl = root.querySelector("[data-pb-dots]");
    const kindEl = root.querySelector("[data-pb-kind]");
    const chipsEl = root.querySelector("[data-pb-chips]");
    const nameEl = root.querySelector("[data-pb-name]");
    const shortEl = root.querySelector("[data-pb-short]");
    const bodyEl = root.querySelector("[data-pb-body]");
    const formatsWrap = root.querySelector("[data-pb-formats-wrap]");
    const formatsEl = root.querySelector("[data-pb-formats]");
    const tagsWrap = root.querySelector("[data-pb-tags-wrap]");
    const tagsEl = root.querySelector("[data-pb-tags]");
    const contactEl = root.querySelector("[data-pb-contact]");

    if (contactEl instanceof HTMLAnchorElement && payload.contactHref) {
      contactEl.href = payload.contactHref;
    }

    const stopVideos = () => {
      stageEl?.querySelectorAll("video").forEach((v) => {
        try {
          v.pause();
        } catch {
          /* */
        }
      });
    };

    const setDeepLink = (slug: string) => {
      try {
        const u = new URL(window.location.href);
        if (slug) u.searchParams.set("p", slug);
        else u.searchParams.delete("p");
        history.replaceState(null, "", u.pathname + u.search);
      } catch {
        /* */
      }
    };

    const renderList = () => {
      if (!listEl) return;
      if (!items.length) {
        listEl.innerHTML = `<li class="pb__list-empty">${escapeHtml(L.empty || "—")}</li>`;
        return;
      }
      listEl.innerHTML = items
        .map((item) => {
          const on = item.slug === activeSlug ? " is-on" : "";
          const id = safeDomId(item.slug);
          return `<li>
            <button type="button" class="pb__item${on}" data-slug="${escapeHtml(item.slug)}" id="pb-item-${id}">
              <span class="pb__thumb">${thumbHtml(item)}</span>
              <span class="pb__meta">
                <span class="pb__item-name">${escapeHtml(item.name)}</span>
                <span class="pb__item-cat">${escapeHtml(item.category || "")}</span>
              </span>
            </button>
          </li>`;
        })
        .join("");

      listEl.querySelectorAll("[data-slug]").forEach((btn) => {
        btn.addEventListener("click", () => {
          activeSlug = (btn as HTMLElement).dataset.slug || "";
          mediaIndex = 0;
          renderList();
          renderDetail();
          setDeepLink(activeSlug);
        });
      });
    };

    const renderDetail = () => {
      const item = items.find((x) => x.slug === activeSlug);
      if (!item) {
        if (emptyEl instanceof HTMLElement) emptyEl.hidden = false;
        if (gridEl instanceof HTMLElement) gridEl.hidden = true;
        return;
      }
      if (emptyEl instanceof HTMLElement) emptyEl.hidden = true;
      if (gridEl instanceof HTMLElement) gridEl.hidden = false;

      if (nameEl) nameEl.textContent = item.name;
      if (shortEl) shortEl.textContent = item.shortDescription || "";
      if (bodyEl) bodyEl.textContent = item.description || "";

      if (chipsEl) {
        const soon = item.status === "coming-soon";
        chipsEl.innerHTML = `
          <span class="pb__chip">${escapeHtml(item.category || "software")}</span>
          <span class="pb__chip${soon ? " pb__chip--soon" : ""}">${escapeHtml(soon ? L.soon || "Soon" : L.available || "OK")}</span>
        `;
      }

      if (formatsEl && formatsWrap instanceof HTMLElement) {
        const f = item.formats || [];
        formatsWrap.hidden = !f.length;
        formatsEl.innerHTML = f.map((x) => `<span class="pb__tag">${escapeHtml(x)}</span>`).join("");
      }
      if (tagsEl && tagsWrap instanceof HTMLElement) {
        const tg = item.tags || [];
        tagsWrap.hidden = !tg.length;
        tagsEl.innerHTML = tg.map((x) => `<span class="pb__tag">${escapeHtml(x)}</span>`).join("");
      }

      const media = buildMedia(item);
      stopVideos();
      if (!stageEl) return;

      if (!media.length) {
        if (kindEl) kindEl.textContent = "";
        stageEl.innerHTML = `<div class="pb__ph pb__ph--lg"></div>`;
        if (dotsEl instanceof HTMLElement) {
          dotsEl.hidden = true;
          dotsEl.innerHTML = "";
        }
        return;
      }

      const m = media[Math.min(mediaIndex, media.length - 1)] || media[0];
      if (kindEl) kindEl.textContent = m.type === "video" ? L.video || "Video" : L.image || "Image";
      if (m.type === "video") {
        stageEl.innerHTML = `<video src="${escapeHtml(m.src)}" controls playsinline preload="metadata"></video>`;
      } else {
        stageEl.innerHTML = `<img src="${escapeHtml(m.src)}" alt="" />`;
      }

      if (dotsEl instanceof HTMLElement) {
        if (media.length > 1) {
          dotsEl.hidden = false;
          dotsEl.innerHTML = media
            .map((itemM, i) => {
              const on = i === mediaIndex ? " is-on" : "";
              const inner =
                itemM.type === "video"
                  ? `<video src="${escapeHtml(itemM.src)}" muted playsinline preload="metadata"></video>`
                  : `<img src="${escapeHtml(itemM.src)}" alt="" />`;
              return `<button type="button" class="pb__dot${on}" data-mi="${i}" aria-label="media ${i + 1}">${inner}</button>`;
            })
            .join("");
          dotsEl.querySelectorAll("[data-mi]").forEach((b) => {
            b.addEventListener("click", () => {
              mediaIndex = Number((b as HTMLElement).dataset.mi || 0);
              renderDetail();
            });
          });
        } else {
          dotsEl.hidden = true;
          dotsEl.innerHTML = "";
        }
      }
    };

    const apply = () => {
      if (!items.length) {
        activeSlug = "";
        if (emptyEl instanceof HTMLElement) {
          emptyEl.hidden = false;
          const tEl = emptyEl.querySelector("[data-pb-empty-title]");
          const d = emptyEl.querySelector("[data-pb-empty-desc]");
          if (tEl) tEl.textContent = L.empty || "";
          if (d instanceof HTMLElement) {
            const desc = (L.emptyDesc || "").trim();
            d.textContent = desc;
            d.hidden = !desc;
          }
        }
        if (gridEl instanceof HTMLElement) gridEl.hidden = true;
      } else {
        if (!items.some((x) => x.slug === activeSlug)) {
          activeSlug = items[0].slug;
          mediaIndex = 0;
        }
      }
      renderList();
      renderDetail();
    };

    apply();

    // deep-link ?p=slug
    try {
      const p = new URL(window.location.href).searchParams.get("p")?.trim();
      if (p && items.some((x) => x.slug === p)) {
        activeSlug = p;
        mediaIndex = 0;
        apply();
      }
    } catch {
      /* */
    }

    void (async () => {
      try {
        const res = await fetch("/api/products", { credentials: "same-origin" });
        if (!res.ok) return;
        const data = await res.json();
        if (!data?.ok || !Array.isArray(data.items)) return;
        items = data.items.map((raw: Record<string, unknown>) => ({
          slug: String(raw.slug || ""),
          name: String(raw.name || ""),
          category: String(raw.category || "other"),
          status: String(raw.status || "published"),
          shortDescription: String(raw.shortDescription || ""),
          description: String(raw.description || ""),
          images: Array.isArray(raw.images)
            ? raw.images.map((u) => safeMediaUrl(String(u))).filter(Boolean)
            : [],
          video: safeMediaUrl(raw.video as string) || null,
          tags: Array.isArray(raw.tags) ? raw.tags.map(String) : [],
          formats: Array.isArray(raw.formats) ? raw.formats.map(String) : [],
          featured: Boolean(raw.featured),
        })).filter((x: Item) => x.slug && x.name);
        apply();
        try {
          const p = new URL(window.location.href).searchParams.get("p")?.trim();
          if (p && items.some((x) => x.slug === p)) {
            activeSlug = p;
            mediaIndex = 0;
            apply();
          }
        } catch {
          /* */
        }
      } catch {
        /* keep seed */
      }
    })();
  }

  function init() {
    document.querySelectorAll("[data-products-root]").forEach((el) => {
      if (el instanceof HTMLElement) bindRoot(el);
    });
  }

  document.addEventListener("DOMContentLoaded", init);
  document.addEventListener("astro:page-load", init);
</script>

<style is:global>
  .pb__shop {
    display: grid;
    grid-template-columns: minmax(12rem, 15.5rem) minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }
  @media (max-width: 860px) {
    .pb__shop {
      grid-template-columns: 1fr;
    }
  }

  .pb__panel {
    border: 1px solid rgb(201 169 98 / 0.22);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--glow);
    overflow: hidden;
    position: sticky;
    top: 1rem;
  }
  .pb__panel-head {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .pb__eyebrow {
    margin: 0;
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent-dim);
    font-weight: 600;
  }
  .pb__panel-title {
    margin: 0.25rem 0 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
  }
  .pb__list {
    margin: 0;
    padding: 0.45rem;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-height: min(60vh, 28rem);
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .pb__list-empty {
    padding: 0.75rem;
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .pb__item {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: 0.65rem;
    align-items: center;
    width: 100%;
    padding: 0.45rem 0.5rem;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    text-align: left;
    cursor: pointer;
    color: inherit;
    font: inherit;
    transition: background 0.12s, border-color 0.12s;
  }
  .pb__item:hover {
    background: var(--color-surface-hover);
  }
  .pb__item.is-on {
    background: var(--color-accent-light);
    border-color: rgb(201 169 98 / 0.35);
  }
  .pb__thumb {
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 5px;
    overflow: hidden;
    background: #0c0c10;
    border: 1px solid rgb(255 255 255 / 0.08);
  }
  .pb__thumb img,
  .pb__thumb video,
  .pb__ph {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pb__ph {
    background: linear-gradient(145deg, #1c1c22, #0a0a0c);
  }
  .pb__ph--lg {
    min-height: 12rem;
    aspect-ratio: 4 / 5;
  }
  .pb__meta {
    min-width: 0;
  }
  .pb__item-name {
    display: block;
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pb__item-cat {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.65rem;
    color: var(--color-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .pb__detail {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-elevated);
    overflow: hidden;
    min-height: 22rem;
  }
  .pb__empty {
    padding: 2.5rem 1.5rem;
    text-align: center;
  }
  .pb__empty-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.4rem;
  }
  .pb__empty-desc {
    margin: 0.5rem 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .pb__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    min-height: 22rem;
  }
  @media (max-width: 720px) {
    .pb__grid {
      grid-template-columns: 1fr;
    }
  }
  .pb__media {
    position: relative;
    background: #0a0a0c;
    border-right: 1px solid var(--color-border);
  }
  @media (max-width: 720px) {
    .pb__media {
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }
  }
  .pb__kind {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    z-index: 2;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2rem 0.45rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.55);
    border: 1px solid rgb(255 255 255 / 0.12);
    color: var(--color-accent);
  }
  .pb__stage {
    aspect-ratio: 4 / 5;
    max-height: min(70vh, 32rem);
    background: #0c0c10;
  }
  .pb__stage img,
  .pb__stage video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pb__dots {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    gap: 0.35rem;
    padding: 0.65rem;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.65));
    justify-content: center;
    flex-wrap: wrap;
  }
  .pb__dot {
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.15);
    border-radius: 5px;
    overflow: hidden;
    background: #111;
    opacity: 0.7;
    cursor: pointer;
  }
  .pb__dot.is-on {
    opacity: 1;
    border-color: var(--color-accent);
  }
  .pb__dot img,
  .pb__dot video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  .pb__info {
    padding: 1.25rem 1.35rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .pb__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .pb__chip {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.18rem 0.45rem;
    border-radius: 999px;
    background: var(--color-accent-light);
    color: var(--color-accent-dim);
    border: 1px solid rgb(201 169 98 / 0.2);
  }
  .pb__chip--soon {
    color: #ffb38a;
    background: rgb(50 22 12 / 0.5);
    border-color: rgb(255 140 80 / 0.35);
  }
  .pb__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.4vw, 1.85rem);
    font-weight: 500;
    line-height: 1.15;
  }
  .pb__short {
    margin: 0;
    font-size: 0.95rem;
    color: rgb(200 200 208);
  }
  .pb__body {
    margin: 0;
    font-size: 0.86rem;
    color: var(--color-muted);
    line-height: 1.6;
    white-space: pre-wrap;
    flex: 1;
  }
  .pb__meta-label {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    font-weight: 600;
  }
  .pb__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .pb__tag {
    font-size: 0.68rem;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
  }
  .pb__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.35rem;
  }
  .pb__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 1rem;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    color: inherit;
    transition: background 0.12s, border-color 0.12s;
  }
  .pb__btn:hover {
    background: var(--color-surface-hover);
    border-color: rgb(201 169 98 / 0.3);
  }
  .pb__btn--gold {
    background: var(--color-accent);
    color: #0a0a0c;
    border-color: transparent;
    font-weight: 600;
  }
  .pb__btn--gold:hover {
    filter: brightness(1.06);
    background: var(--color-accent);
  }
</style>
