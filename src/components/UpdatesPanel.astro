---
import { getUpdates, getTagLabels } from "../lib/updates";
import type { Locale } from "../i18n/translations";
import { useTranslations } from "../lib/locale";
import { safeMediaUrl } from "../lib/dom-escape";

type Props = {
  lang?: Locale;
};

const { lang = "es" } = Astro.props;
const t = useTranslations(lang);
const tagLabels = getTagLabels(lang);

const updates = getUpdates(6);

const formatDate = (iso: string) => {
  const [year, month, day] = iso.split("-");
  return `${day}/${month}/${year}`;
};

const payload = {
  lang: lang as string,
  labels: {
    empty: t("updatesEmpty"),
    tags: tagLabels as Record<string, string>,
    nlTitle: t("newsletterTitle"),
    nlLead: t("newsletterLead"),
    nlEmail: t("newsletterEmail"),
    nlSubmit: t("newsletterSubmit"),
    nlOk: t("newsletterOk"),
    nlAlready: t("newsletterAlready"),
    nlErr: t("newsletterErr"),
    nlPrivacy: t("newsletterPrivacy"),
  },
  seed: updates,
};
---

<div
  class="updates-panel"
  data-updates-root
  data-updates-payload={JSON.stringify(payload)}
>
  <header class="updates-panel__head">
    <p class="updates-panel__eyebrow">{t("updatesFeed")}</p>
    <h2 class="updates-panel__title">{t("updatesTitle")}</h2>
    <p class="updates-panel__desc">{t("updatesDesc")}</p>
  </header>

  <div data-updates-body>
    {
      updates.length === 0 ? (
        <p class="updates-panel__empty">{t("updatesEmpty")}</p>
      ) : (
        <ul class="updates-panel__list">
          {updates.map((item) => {
            const img = safeMediaUrl(item.image);
            const link = (item as { link?: string }).link;
            return (
              <li class="updates-panel__item">
                <div class="updates-panel__meta">
                  <span class:list={["updates-panel__tag", `updates-panel__tag--${item.tag}`]}>
                    {tagLabels[item.tag]}
                  </span>
                  <time class="updates-panel__date" datetime={item.date}>
                    {formatDate(item.date)}
                  </time>
                </div>
                {
                  img ? (
                    <div class="updates-panel__media">
                      <img
                        src={img}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        class="updates-panel__img"
                      />
                    </div>
                  ) : null
                }
                {
                  link ? (
                    <p class="updates-panel__item-title">
                      <a href={link} class="updates-panel__link">{item.title}</a>
                    </p>
                  ) : (
                    <p class="updates-panel__item-title">{item.title}</p>
                  )
                }
                <p class="updates-panel__summary">{item.summary}</p>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>

  <form class="updates-panel__nl" data-newsletter-form>
    <p class="updates-panel__nl-title">{t("newsletterTitle")}</p>
    <p class="updates-panel__nl-lead">{t("newsletterLead")}</p>
    <label class="updates-panel__nl-label">
      <span class="visually-hidden">{t("newsletterEmail")}</span>
      <input
        type="email"
        name="email"
        required
        maxlength="200"
        autocomplete="email"
        placeholder={t("newsletterEmail")}
        data-newsletter-email
      />
    </label>
    <button type="submit" class="updates-panel__nl-btn" data-newsletter-submit>
      {t("newsletterSubmit")}
    </button>
    <p class="updates-panel__nl-privacy">{t("newsletterPrivacy")}</p>
    <p class="updates-panel__nl-status" data-newsletter-status hidden></p>
  </form>
</div>

<script>
  import { safeMediaUrl } from "../lib/dom-escape";

  function escapeHtml(s: string) {
    return String(s)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function formatDate(iso: string) {
    const [y, m, d] = String(iso).split("-");
    if (!y || !m || !d) return iso;
    return `${d}/${m}/${y}`;
  }

  function safeTag(tag: string) {
    if (tag === "nuevo" || tag === "mejora" || tag === "fix" || tag === "proximo") return tag;
    return "nuevo";
  }

  function mediaBlock(image: unknown) {
    const src = safeMediaUrl(typeof image === "string" ? image : "");
    if (!src) return "";
    return `<div class="updates-panel__media"><img class="updates-panel__img" src="${escapeHtml(src)}" alt="" loading="lazy" decoding="async" /></div>`;
  }

  function safeLink(raw: unknown): string {
    const u = String(raw || "").trim();
    if (!u) return "";
    if (u.startsWith("/") && !u.startsWith("//")) return u;
    if (/^https:\/\/(www\.)?nimpo3dstudio\.com(\/|\?|#|$)/i.test(u)) return u;
    if (/^https:\/\/nimpo-studio\.pages\.dev(\/|\?|#|$)/i.test(u)) return u;
    return "";
  }

  async function hydrateUpdates() {
    document.querySelectorAll("[data-updates-root]").forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.bound === "1") return;
      root.dataset.bound = "1";

      let payload: {
        lang?: string;
        labels: {
          empty: string;
          tags: Record<string, string>;
          nlOk?: string;
          nlAlready?: string;
          nlErr?: string;
        };
      } = { labels: { empty: "", tags: {} } };
      try {
        payload = JSON.parse(root.dataset.updatesPayload || "{}");
      } catch {
        /* seed only */
      }

      const body = root.querySelector("[data-updates-body]");
      if (!body) return;

      const nlForm = root.querySelector("[data-newsletter-form]");
      nlForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const statusEl = root.querySelector("[data-newsletter-status]");
        const btn = root.querySelector("[data-newsletter-submit]");
        const emailEl = root.querySelector("[data-newsletter-email]") as HTMLInputElement | null;
        const email = String(emailEl?.value || "").trim();
        const L = payload.labels || {};
        if (btn instanceof HTMLButtonElement) btn.disabled = true;
        if (statusEl instanceof HTMLElement) {
          statusEl.hidden = false;
          statusEl.textContent = "…";
          statusEl.classList.remove("is-err", "is-ok");
        }
        try {
          const res = await fetch("/api/newsletter", {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify({ email, lang: payload.lang || "es" }),
          });
          const data = await res.json();
          if (!res.ok || !data.ok) {
            throw new Error(data.message || data.error || L.nlErr || "Error");
          }
          if (statusEl instanceof HTMLElement) {
            statusEl.classList.add("is-ok");
            statusEl.textContent =
              data.status === "already_active"
                ? L.nlAlready || data.message || "OK"
                : L.nlOk || data.message || "OK";
          }
          if (emailEl && data.status !== "already_active") emailEl.value = "";
        } catch (err) {
          if (statusEl instanceof HTMLElement) {
            statusEl.classList.add("is-err");
            statusEl.textContent =
              err instanceof Error ? err.message : L.nlErr || "Error";
          }
        } finally {
          if (btn instanceof HTMLButtonElement) btn.disabled = false;
        }
      });

      void (async () => {
        try {
          const res = await fetch("/api/updates", { credentials: "same-origin" });
          if (!res.ok) return;
          const data = await res.json();
          if (!data?.ok || !Array.isArray(data.items) || !data.items.length) return;

          const tags = payload.labels?.tags || {};
          const items = data.items.slice(0, 6);
          body.innerHTML = `<ul class="updates-panel__list">${items
            .map(
              (item: {
                date?: string;
                title?: string;
                tag?: string;
                summary?: string;
                image?: string;
                link?: string;
              }) => {
                const tag = safeTag(String(item.tag || "nuevo"));
                const title = escapeHtml(String(item.title || "").slice(0, 160));
                const summary = escapeHtml(String(item.summary || "").slice(0, 500));
                const date = String(item.date || "").slice(0, 10);
                const tagLabel = escapeHtml(tags[tag] || tag);
                const media = mediaBlock(item.image);
                const href = safeLink(item.link);
                const titleHtml = href
                  ? `<p class="updates-panel__item-title"><a class="updates-panel__link" href="${escapeHtml(href)}">${title}</a></p>`
                  : `<p class="updates-panel__item-title">${title}</p>`;
                return `<li class="updates-panel__item">
                <div class="updates-panel__meta">
                  <span class="updates-panel__tag updates-panel__tag--${tag}">${tagLabel}</span>
                  <time class="updates-panel__date" datetime="${escapeHtml(date)}">${escapeHtml(formatDate(date))}</time>
                </div>
                ${media}
                ${titleHtml}
                <p class="updates-panel__summary">${summary}</p>
              </li>`;
              },
            )
            .join("")}</ul>`;
        } catch {
          /* keep build seed */
        }
      })();
    });
  }

  document.addEventListener("DOMContentLoaded", hydrateUpdates);
  document.addEventListener("astro:page-load", hydrateUpdates);
</script>

<style is:global>
  .updates-panel {
    padding: 1.25rem 1.15rem;
    border-radius: var(--radius-lg);
    border: 1px solid rgb(201 169 98 / 0.22);
    background: var(--color-surface);
    box-shadow: var(--glow);
  }

  .updates-panel__head {
    margin-bottom: 1.15rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .updates-panel__eyebrow {
    margin: 0;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent-dim);
  }

  .updates-panel__title {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.1;
  }

  .updates-panel__desc {
    margin: 0.45rem 0 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .updates-panel__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-height: min(52vh, 28rem);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }

  .updates-panel__item {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .updates-panel__item:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .updates-panel__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .updates-panel__tag {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius);
    background: var(--color-accent-light);
    color: var(--color-accent-dim);
  }

  .updates-panel__tag--nuevo {
    color: var(--color-accent);
    border: 1px solid rgb(201 169 98 / 0.25);
  }

  .updates-panel__date {
    font-size: 0.68rem;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .updates-panel__media {
    margin: 0.55rem 0 0;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.08);
    background: #0c0c10;
    aspect-ratio: 16 / 10;
    max-height: 9.5rem;
  }

  .updates-panel__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .updates-panel__item-title {
    margin: 0.45rem 0 0;
    font-size: 0.88rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .updates-panel__summary {
    margin: 0.3rem 0 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .updates-panel__empty {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .updates-panel__link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgb(201 169 98 / 0.35);
  }
  .updates-panel__link:hover {
    color: var(--color-accent);
  }

  .updates-panel__nl {
    margin-top: 1.15rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .updates-panel__nl-title {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-accent-dim);
  }
  .updates-panel__nl-lead,
  .updates-panel__nl-privacy {
    margin: 0;
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--color-muted);
  }
  .updates-panel__nl-label input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.5rem 0.65rem;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: rgb(0 0 0 / 0.35);
    color: inherit;
    font: inherit;
    font-size: 0.85rem;
  }
  .updates-panel__nl-btn {
    margin: 0;
    padding: 0.5rem 0.85rem;
    border-radius: 6px;
    border: 1px solid transparent;
    background: var(--color-accent);
    color: #0a0a0c;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
  }
  .updates-panel__nl-btn:hover {
    filter: brightness(1.06);
  }
  .updates-panel__nl-btn:disabled {
    opacity: 0.65;
    cursor: wait;
  }
  .updates-panel__nl-status {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.35;
  }
  .updates-panel__nl-status.is-ok {
    color: var(--color-accent);
  }
  .updates-panel__nl-status.is-err {
    color: #ff9b8a;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
