---
import Layout from "../../../components/Layout.astro";
import ProductsBrowser from "../../../components/ProductsBrowser.astro";
import ProductUpdatesPanel from "../../../components/ProductUpdatesPanel.astro";
import type { Locale } from "../../../i18n/translations";
import { useTranslations } from "../../../lib/locale";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }, { params: { lang: "fr" } }];
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
---

<Layout title={t("catalogTitle")} description={t("catalogDesc")} lang={lang}>
  <!--
    Hero encima; shell = ficha | feed (mismos tops).
    No page-with-feed 38rem (aplasta ficha).
  -->
  <div class="catalog-page">
    <header class="hero">
      <p class="hero__eyebrow">{t("catalogSubtitle")}</p>
      <div class="hero__title-row">
        <h1 class="hero__title">{t("catalogTitle")}</h1>
        <span class="hero__soon">{t("catalogComingSoon")}</span>
      </div>
      <p class="hero__desc">{t("catalogDesc")}</p>
    </header>

    <div class="catalog-shell">
      <div class="catalog-shell__main">
        <ProductsBrowser items={[]} lang={lang} />
      </div>
      <aside class="catalog-shell__rail" aria-label={t("productFeedTitle")}>
        <ProductUpdatesPanel lang={lang} />
      </aside>
    </div>
  </div>
</Layout>

<style>
  .catalog-page {
    width: min(100% - 2rem, calc(var(--max-width) + 17.5rem + 1.75rem));
    margin-inline: auto;
  }

  .hero {
    max-width: 36rem;
    margin-bottom: 1.75rem;
  }

  .hero__eyebrow {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-warm);
  }

  .hero__title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 0.85rem;
    margin-top: 0.5rem;
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.5vw, 3.25rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: 0.01em;
  }

  .hero__soon {
    display: inline-flex;
    align-items: center;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #0a0a0c;
    background: var(--color-accent);
    border: 1px solid rgb(201 169 98 / 0.5);
    box-shadow: 0 0 20px rgb(201 169 98 / 0.25);
    line-height: 1.2;
  }

  .hero__desc {
    margin: 0.85rem 0 0;
    color: var(--color-muted);
    font-size: 1rem;
  }

  .catalog-shell {
    width: 100%;
  }

  .catalog-shell__rail {
    margin-top: 2rem;
    max-width: 28rem;
  }

  @media (min-width: 1100px) {
    .catalog-shell {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 17.5rem;
      column-gap: 1.75rem;
      align-items: start;
    }

    .catalog-shell__main {
      min-width: 0;
    }

    .catalog-shell__rail {
      margin-top: 0;
      max-width: none;
      position: sticky;
      top: 5.5rem;
      max-height: calc(100dvh - 7rem);
      overflow: hidden;
      padding-block: 0 2rem;
      box-sizing: border-box;
    }

    .catalog-shell__rail :global(.product-updates-panel) {
      max-height: 100%;
      min-height: 0;
    }
  }
</style>
