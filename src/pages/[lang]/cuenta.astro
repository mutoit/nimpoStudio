---
/**
 * Área cliente: magic link + pedidos + nick + recovery.
 */
import Layout from "../../components/Layout.astro";
import type { Locale } from "../../i18n/translations";
import { useTranslations } from "../../lib/locale";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }, { params: { lang: "fr" } }];
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);

const labels = {
  title: t("accountTitle"),
  lead: t("accountLead"),
  email: t("quoteEmail"),
  send: t("accountSendLink"),
  sent: t("accountLinkSent"),
  logout: t("accountLogout"),
  orders: t("accountOrders"),
  empty: t("accountEmpty"),
  download: t("accountDownload"),
  license: t("accountLicense"),
  err: t("accountError"),
  checkoutOk: t("accountCheckoutOk"),
  nick: t("accountNick"),
  nickSave: t("accountNickSave"),
  nickHint: t("accountNickHint"),
  nickOk: t("accountNickOk"),
  recovery: t("accountRecovery"),
  recoveryLead: t("accountRecoveryLead"),
  recoveryOld: t("accountRecoveryOld"),
  recoveryNew: t("accountRecoveryNew"),
  recoveryKey: t("accountRecoveryKey"),
  recoveryProof: t("accountRecoveryProof"),
  recoveryMsg: t("accountRecoveryMsg"),
  recoverySend: t("accountRecoverySend"),
  recoveryOk: t("accountRecoveryOk"),
};
---

<Layout title={t("accountTitle")} description={t("accountLead")} lang={lang}>
  <div class="container account" data-account-root data-labels={JSON.stringify(labels)}>
    <header class="hero">
      <p class="hero__eyebrow">{t("accountEyebrow")}</p>
      <h1 class="hero__title">{t("accountTitle")}</h1>
      <p class="hero__desc">{t("accountLead")}</p>
    </header>

    <p class="banner" data-banner hidden></p>

    <section class="card" data-login>
      <form class="form" data-magic-form>
        <label>
          {t("quoteEmail")}
          <input type="email" name="email" required autocomplete="email" data-email />
        </label>
        <button type="submit" class="btn btn--gold" data-magic-submit>{t("accountSendLink")}</button>
      </form>
      <p class="status" data-login-status hidden></p>
    </section>

    <section class="card" data-panel hidden>
      <div class="panel-head">
        <p data-user-email></p>
        <button type="button" class="btn btn--ghost" data-logout>{t("accountLogout")}</button>
      </div>

      <div class="nick-block">
        <label>
          {t("accountNick")}
          <input type="text" data-nick maxlength="20" autocomplete="nickname" pattern="[A-Za-z0-9_]{3,20}" />
        </label>
        <p class="hint">{t("accountNickHint")}</p>
        <button type="button" class="btn btn--sm btn--gold" data-nick-save>{t("accountNickSave")}</button>
        <p class="status" data-nick-status hidden></p>
      </div>

      <h2 class="sub">{t("accountOrders")}</h2>
      <div data-orders-list>
        <p class="muted">{t("accountEmpty")}</p>
      </div>
    </section>

    <section class="card recovery" data-recovery>
      <h2 class="sub">{t("accountRecovery")}</h2>
      <p class="muted">{t("accountRecoveryLead")}</p>
      <form class="form" data-recovery-form>
        <label>
          {t("accountRecoveryNew")}
          <input type="email" name="newEmail" required data-rec-new autocomplete="email" />
        </label>
        <label>
          {t("accountRecoveryOld")}
          <input type="email" name="oldEmail" data-rec-old autocomplete="email" />
        </label>
        <label>
          {t("accountRecoveryKey")}
          <input type="text" name="licenseKey" data-rec-key maxlength="40" autocomplete="off" />
        </label>
        <label>
          {t("accountRecoveryProof")}
          <input type="text" name="proof" data-rec-proof maxlength="500" />
        </label>
        <label>
          {t("accountRecoveryMsg")}
          <textarea name="message" data-rec-msg rows="3" maxlength="4000"></textarea>
        </label>
        <button type="submit" class="btn btn--gold" data-rec-submit>{t("accountRecoverySend")}</button>
      </form>
      <p class="status" data-rec-status hidden></p>
    </section>
  </div>
</Layout>

<script>
  type Labels = Record<string, string>;

  function bind(root: HTMLElement) {
    if (root.dataset.bound === "1") return;
    root.dataset.bound = "1";
    let L: Labels = {};
    try {
      L = JSON.parse(root.dataset.labels || "{}");
    } catch {
      /* */
    }

    const login = root.querySelector("[data-login]");
    const panel = root.querySelector("[data-panel]");
    const banner = root.querySelector("[data-banner]");
    const loginStatus = root.querySelector("[data-login-status]");
    const ordersList = root.querySelector("[data-orders-list]");
    const userEmail = root.querySelector("[data-user-email]");
    const nickInput = root.querySelector("[data-nick]") as HTMLInputElement | null;
    const nickStatus = root.querySelector("[data-nick-status]");

    try {
      const u = new URL(window.location.href);
      if (u.searchParams.get("checkout") === "success" && banner instanceof HTMLElement) {
        banner.hidden = false;
        banner.textContent = L.checkoutOk || "Pago recibido. Revisa tu email y esta cuenta.";
        banner.classList.add("is-ok");
      }
      if (u.searchParams.get("e") === "magic" && banner instanceof HTMLElement) {
        banner.hidden = false;
        banner.textContent = L.err || "Enlace inválido o caducado.";
        banner.classList.add("is-err");
      }
    } catch {
      /* */
    }

    const paintSession = async () => {
      try {
        const res = await fetch("/api/account/session", { credentials: "same-origin" });
        const data = await res.json();
        if (!data?.authenticated) {
          if (login instanceof HTMLElement) login.hidden = false;
          if (panel instanceof HTMLElement) panel.hidden = true;
          return;
        }
        if (login instanceof HTMLElement) login.hidden = true;
        if (panel instanceof HTMLElement) panel.hidden = false;
        if (userEmail) userEmail.textContent = data.email;
        if (nickInput) nickInput.value = data.nick || "";
        const orders = Array.isArray(data.orders) ? data.orders : [];
        if (!(ordersList instanceof HTMLElement)) return;
        if (!orders.length) {
          ordersList.innerHTML = `<p class="muted">${L.empty || "—"}</p>`;
          return;
        }
        ordersList.innerHTML = orders
          .map((o: Record<string, unknown>) => {
            const name = String(o.productName || o.productSlug || "");
            const key = String(o.licenseKey || "");
            const slug = String(o.productSlug || "");
            const kind = String(o.kind || "software");
            const hasFull = Boolean(o.hasFullBuild);
            const stemN = Number(o.stemCount || 0);
            const kindLabel = kind === "music" ? "Música" : "Software";
            const dl = hasFull
              ? `<button type="button" class="btn btn--sm btn--gold" data-dl-key="${key}" data-dl-slug="${slug}" data-dl-kind="${kind}">${L.download || "Download"}</button>`
              : `<span class="muted">—</span>`;
            return `<article class="order">
              <div>
                <strong>${name}</strong>
                <p class="muted">${kindLabel} · ${String(o.planName || "")} · ${String(o.paidAt || "").slice(0, 10)}${
                  stemN ? ` · ${stemN} stems` : ""
                }</p>
                <p class="key">${L.license || "License"}: <code>${key}</code></p>
              </div>
              <div>${dl}</div>
            </article>`;
          })
          .join("");

        ordersList.querySelectorAll("[data-dl-key]").forEach((btn) => {
          btn.addEventListener("click", async () => {
            const licenseKey = (btn as HTMLElement).dataset.dlKey || "";
            const productSlug = (btn as HTMLElement).dataset.dlSlug || "";
            const kind = (btn as HTMLElement).dataset.dlKind || "software";
            try {
              const r = await fetch("/api/download", {
                method: "POST",
                credentials: "same-origin",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  licenseKey,
                  productSlug,
                  workSlug: kind === "music" ? productSlug : undefined,
                }),
              });
              const j = await r.json();
              if (!r.ok || !j.ok) throw new Error(j.error || "download_failed");
              // Música: varios archivos (master + stems)
              if (Array.isArray(j.files) && j.files.length) {
                for (const f of j.files) {
                  if (f?.url) {
                    const a = document.createElement("a");
                    a.href = f.url;
                    a.download = f.name || "";
                    a.rel = "noopener";
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    await new Promise((res) => setTimeout(res, 400));
                  }
                }
                return;
              }
              if (!j.url) throw new Error(j.error || "download_failed");
              window.location.href = j.url;
            } catch (e) {
              alert(e instanceof Error ? e.message : L.err || "Error");
            }
          });
        });
      } catch {
        /* */
      }
    };

    root.querySelector("[data-magic-form]")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = String(
        (root.querySelector("[data-email]") as HTMLInputElement | null)?.value || "",
      ).trim();
      const submit = root.querySelector("[data-magic-submit]");
      if (submit instanceof HTMLButtonElement) submit.disabled = true;
      if (loginStatus instanceof HTMLElement) {
        loginStatus.hidden = false;
        loginStatus.textContent = "…";
      }
      try {
        const res = await fetch("/api/account/magic", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || res.status);
        if (loginStatus instanceof HTMLElement) {
          loginStatus.textContent = L.sent || data.message || "OK";
          loginStatus.classList.add("is-ok");
        }
      } catch (err) {
        if (loginStatus instanceof HTMLElement) {
          loginStatus.textContent = err instanceof Error ? err.message : L.err || "Error";
          loginStatus.classList.add("is-err");
        }
      } finally {
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
      }
    });

    root.querySelector("[data-logout]")?.addEventListener("click", async () => {
      await fetch("/api/account/session", { method: "DELETE", credentials: "same-origin" });
      location.reload();
    });

    root.querySelector("[data-nick-save]")?.addEventListener("click", async () => {
      const nick = String(nickInput?.value || "").trim();
      if (nickStatus instanceof HTMLElement) {
        nickStatus.hidden = false;
        nickStatus.textContent = "…";
        nickStatus.classList.remove("is-ok", "is-err");
      }
      try {
        const res = await fetch("/api/account/profile", {
          method: "POST",
          credentials: "same-origin",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ nick }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || res.status);
        if (nickStatus instanceof HTMLElement) {
          nickStatus.textContent = L.nickOk || "OK";
          nickStatus.classList.add("is-ok");
        }
      } catch (err) {
        if (nickStatus instanceof HTMLElement) {
          nickStatus.textContent = err instanceof Error ? err.message : L.err || "Error";
          nickStatus.classList.add("is-err");
        }
      }
    });

    root.querySelector("[data-recovery-form]")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const status = root.querySelector("[data-rec-status]");
      const submit = root.querySelector("[data-rec-submit]");
      if (submit instanceof HTMLButtonElement) submit.disabled = true;
      if (status instanceof HTMLElement) {
        status.hidden = false;
        status.textContent = "…";
        status.classList.remove("is-ok", "is-err");
      }
      try {
        const res = await fetch("/api/account/recovery", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            newEmail: (root.querySelector("[data-rec-new]") as HTMLInputElement | null)?.value,
            oldEmail: (root.querySelector("[data-rec-old]") as HTMLInputElement | null)?.value,
            licenseKey: (root.querySelector("[data-rec-key]") as HTMLInputElement | null)?.value,
            proof: (root.querySelector("[data-rec-proof]") as HTMLInputElement | null)?.value,
            message: (root.querySelector("[data-rec-msg]") as HTMLTextAreaElement | null)?.value,
          }),
        });
        const data = await res.json();
        if (status instanceof HTMLElement) {
          status.textContent = data.message || L.recoveryOk || "OK";
          status.classList.add("is-ok");
        }
      } catch {
        if (status instanceof HTMLElement) {
          status.textContent = L.recoveryOk || "OK";
          status.classList.add("is-ok");
        }
      } finally {
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
      }
    });

    void paintSession();
  }

  const init = () => {
    document.querySelectorAll("[data-account-root]").forEach((el) => {
      if (el instanceof HTMLElement) bind(el);
    });
  };
  document.addEventListener("DOMContentLoaded", init);
  document.addEventListener("astro:page-load", init);
</script>

<style>
  .account {
    max-width: 36rem;
    padding-block: 2rem 4rem;
  }
  .hero__eyebrow {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 600;
  }
  .hero__title {
    margin: 0.4rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 500;
  }
  .hero__desc {
    color: var(--color-muted);
    line-height: 1.5;
  }
  .banner {
    padding: 0.75rem 1rem;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    margin-bottom: 1rem;
  }
  .banner.is-ok {
    border-color: rgb(100 200 140 / 0.4);
    color: #b8f0c8;
  }
  .banner.is-err {
    border-color: rgb(240 100 100 / 0.4);
    color: #f0a0a0;
  }
  .card {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-surface);
    padding: 1.15rem 1.25rem;
    margin-bottom: 1rem;
  }
  .form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .form label {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.85rem;
  }
  .form input,
  .form textarea,
  .nick-block input {
    font: inherit;
    color: var(--color-fg);
    background: var(--color-bg-elevated, #121218);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.5rem 0.65rem;
  }
  .panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .sub {
    font-family: var(--font-display);
    font-size: 1.1rem;
    margin: 1rem 0 0.5rem;
  }
  .order {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--color-border);
  }
  .order:first-child {
    border-top: none;
  }
  .key code {
    font-size: 0.8rem;
    word-break: break-all;
  }
  .muted {
    color: var(--color-muted);
    font-size: 0.85rem;
  }
  .hint {
    margin: 0.25rem 0 0.5rem;
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .nick-block {
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .nick-block label {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.85rem;
  }
  .status {
    font-size: 0.85rem;
    margin-top: 0.5rem;
  }
  .status.is-ok {
    color: #9ff0bc;
  }
  .status.is-err {
    color: #f0a0a0;
  }
  .recovery {
    margin-top: 0.5rem;
  }
</style>
