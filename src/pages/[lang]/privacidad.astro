---
import Layout from "../../components/Layout.astro";
import { site } from "../../lib/site";
import type { Locale } from "../../i18n/translations";
import { useTranslations } from "../../lib/locale";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }, { params: { lang: "fr" } }];
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);

const rightsBody = t("privacyRightsBody").replace("{email}", site.email);

const dataItems = [
  t("privacyDataAnalytics"),
  t("privacyDataEvents"),
  t("privacyDataContact"),
  t("privacyDataConsent"),
] as const;

const serviceItems = [
  t("privacyCfAnalytics"),
  t("privacyGa4"),
  t("privacyMeta"),
  t("privacySearch"),
] as const;

function splitBullet(text: string): { label: string; rest: string } {
  const sep = " — ";
  const i = text.indexOf(sep);
  if (i < 0) return { label: text, rest: "" };
  return { label: text.slice(0, i), rest: text.slice(i + sep.length) };
}
---

<Layout title={t("privacyTitle")} description={t("privacyDesc")} lang={lang}>
  <div class="container page legal">
    <h1>{t("privacyTitle")}</h1>
    <p class="legal__updated">{t("privacyUpdated")}</p>

    <section>
      <h2>{t("privacyController")}</h2>
      <p>
        {site.name}
        {" "}
        {t("privacyControllerBody")}
        {" "}
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </section>

    <section>
      <h2>{t("privacyDataTitle")}</h2>
      <ul>
        {
          dataItems.map((item) => {
            const { label, rest } = splitBullet(item);
            return (
              <li>
                <strong>{label}</strong>
                {rest ? ` — ${rest}` : null}
              </li>
            );
          })
        }
      </ul>
    </section>

    <section>
      <h2>{t("privacyServicesTitle")}</h2>
      <ul>
        {
          serviceItems.map((item) => {
            const { label, rest } = splitBullet(item);
            return (
              <li>
                <strong>{label}</strong>
                {rest ? ` — ${rest}` : null}
              </li>
            );
          })
        }
      </ul>
    </section>

    <section>
      <h2>{t("privacyLegalTitle")}</h2>
      <p>{t("privacyLegalBody")}</p>
    </section>

    <section>
      <h2>{t("privacyRightsTitle")}</h2>
      <p>{rightsBody}</p>
    </section>

    <section>
      <h2>{t("privacyFutureTitle")}</h2>
      <p>{t("privacyFutureBody")}</p>
    </section>
  </div>
</Layout>

<style>
  .legal {
    max-width: 42rem;
  }

  .legal h1 {
    font-family: var(--font-display);
    font-size: 2rem;
    margin: 0 0 0.5rem;
  }

  .legal__updated {
    margin: 0 0 2rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .legal section {
    margin-bottom: 1.75rem;
  }

  .legal h2 {
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-dim);
    margin: 0 0 0.65rem;
  }

  .legal p,
  .legal li {
    color: var(--color-muted);
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .legal a {
    color: var(--color-accent);
  }

  .legal ul {
    margin: 0;
    padding-left: 1.25rem;
  }
</style>
