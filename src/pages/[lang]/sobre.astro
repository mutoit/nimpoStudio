---
import Layout from "../../components/Layout.astro";
import { site } from "../../lib/site";
import type { Locale } from "../../i18n/translations";
import { useTranslations, localizePath } from "../../lib/locale";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }, { params: { lang: "fr" } }];
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
const contactHref = localizePath("/contacto", lang);
---

<Layout title={t("aboutTitle")} description={`${site.name}`} lang={lang}>
  <div class="container page">
    <p class="eyebrow">{t("aboutEyebrow")}</p>
    <header class="about-head">
      <img
        class="about-head__logo"
        src="/images/logo-nimpo.png"
        alt=""
        width="96"
        height="96"
        decoding="async"
      />
      <h1 class="title">{site.name}</h1>
    </header>
    <div class="prose">
      <p>{t("aboutP1")}</p>
      <p>{t("aboutP2")}</p>
      <p>{t("aboutP3")}</p>
      <p class="prose__thanks">{t("aboutP4")}</p>
      <p>
        {t("aboutP5")}{" "}
        <a href={contactHref}>{t("aboutContactLink")}</a>.
      </p>
    </div>
  </div>
</Layout>

<style>
  .page {
    max-width: 40rem;
  }

  .eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-warm);
  }

  .about-head {
    display: flex;
    align-items: center;
    gap: 1rem 1.15rem;
    margin-top: 0.65rem;
  }

  .about-head__logo {
    flex-shrink: 0;
    width: clamp(4.25rem, 12vw, 5.75rem);
    height: clamp(4.25rem, 12vw, 5.75rem);
    border-radius: 50%;
    object-fit: cover;
    box-shadow:
      0 0 0 1px rgb(201 169 98 / 0.35),
      0 12px 28px rgb(0 0 0 / 0.45);
    background: #1a120c;
  }

  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .prose {
    margin-top: 1.5rem;
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-muted);
  }

  .prose p {
    margin: 0 0 1rem;
  }

  .prose__thanks {
    color: var(--color-fg);
    font-weight: 500;
  }

  .prose a {
    color: var(--color-accent);
    font-weight: 500;
  }

  @media (max-width: 420px) {
    .about-head {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>