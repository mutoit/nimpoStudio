---
/**
 * Panel de publicación (solo estudio).
 * Un clic: sube media a R2 + actualiza catálogo vivo → se ve en /es/biblioteca/
 */
import Layout from "../../components/Layout.astro";
---

<Layout title="Admin biblioteca" description="Panel privado de biblioteca" lang="es">
  <div class="container admin">
    <header class="head">
      <div>
        <p class="eyebrow">Privado · no indexar</p>
        <h1>Publicar en biblioteca</h1>
      </div>
      <button type="button" class="btn btn--ghost" data-logout>Cerrar sesión</button>
    </header>

    <p class="lead">
      Publica, edita o borra desde aquí. Miniaturas a la derecha. Biblioteca pública:
      <a href="/es/biblioteca/" target="_blank" rel="noopener">/es/biblioteca/</a>
      <br />
      <span class="hint" data-stats-optout>
        Stats: en este panel no se cuentan. En el resto del sitio, abre una vez
        <a href="/es/?nimpo_no_stats=1">/?nimpo_no_stats=1</a>
        (se guarda en el navegador).
      </span>
    </p>

    <div class="admin-layout">
    <div class="workspace" data-workspace>
      <div class="edit-bar" data-edit-bar hidden>
        <span data-edit-label>Editando…</span>
        <button type="button" class="btn btn--sm" data-edit-cancel>Cancelar</button>
      </div>

      <div class="channels">
        <button type="button" class="chip is-active" data-channel="video">
          Canal vídeo
        </button>
        <button type="button" class="chip" data-channel="stems">Canal stems</button>
      </div>

      <form class="form" data-admin-form>
        <label>
          Título *
          <input name="title" required data-title />
        </label>
        <label>
         Slug (url)
          <input name="slug" placeholder="auto-desde-titulo" data-slug />
        </label>

        <label>
          Aspecto
          <select name="aspect">
            <option value="1:1">1:1</option>
            <option value="9:16">9:16</option>
            <option value="16:9">16:9</option>
          </select>
        </label>

        <div class="media-lights" data-media-lights aria-label="Estado de archivos">
          <div class="ml" data-ml="video" data-state="idle">
            <span class="ml__dot" aria-hidden="true"></span>
            <span class="ml__name">Vídeo</span>
            <span class="ml__txt" data-ml-txt>—</span>
          </div>
          <div class="ml" data-ml="cover" data-state="idle">
            <span class="ml__dot" aria-hidden="true"></span>
            <span class="ml__name">Cover</span>
            <span class="ml__txt" data-ml-txt>—</span>
          </div>
          <div class="ml" data-ml="stems" data-state="idle">
            <span class="ml__dot" aria-hidden="true"></span>
            <span class="ml__name">Stems</span>
            <span class="ml__txt" data-ml-txt>—</span>
          </div>
          <div class="ml" data-ml="upload" data-state="idle">
            <span class="ml__dot" aria-hidden="true"></span>
            <span class="ml__name">Subida</span>
            <span class="ml__txt" data-ml-txt>—</span>
          </div>
        </div>

        <div data-video-fields>
          <div class="media-status" data-status-video hidden role="status"></div>
          <label class="file-label">
            Vídeo (mp4 / webm) *
            <input type="file" accept="video/mp4,video/webm,video/*" data-video-file />
          </label>
          <div class="preview" data-video-preview hidden></div>
          <label class="file-label">
            Miniatura imagen (opcional)
            <input type="file" accept="image/*" data-cover-file />
          </label>
          <p class="hint">
            No hace falta si subes vídeo: la tarjeta usa el vídeo (primer fotograma). La imagen solo
            ayuda a cargar más rápido o si quieres un still fijo.
          </p>
          <div class="preview preview--img" data-cover-preview hidden></div>
        </div>

        <div data-stems-fields hidden>
          <div class="media-status" data-status-stems-visual hidden role="status"></div>
          <label class="file-label">
            Vídeo de fondo / visual (opcional)
            <input type="file" accept="video/mp4,video/webm,video/*" data-stems-video />
          </label>
          <div class="preview" data-stems-video-preview hidden></div>
          <label class="file-label">
            Miniatura imagen (opcional)
            <input type="file" accept="image/*" data-stems-cover />
          </label>
          <p class="hint">
            Con vídeo basta para la miniatura. La imagen es opcional (poster / carga más ligera).
            Lo obligatorio son las capas de audio.
          </p>
          <div class="preview preview--img" data-stems-cover-preview hidden></div>
          <div class="stems-box">
            <div class="stems-head">
              <span>Capas (stems) *</span>
              <button type="button" class="btn btn--sm" data-add-stem>+ Fila vacía</button>
            </div>
            <div class="media-status" data-status-stems hidden role="status"></div>
            <div
              class="dropzone"
              data-stems-drop
              tabindex="0"
              role="button"
              aria-label="Arrastra stems de audio aquí"
            >
              <input
                type="file"
                accept="audio/*,.mp3,.wav,.m4a,.ogg,.aac"
                multiple
                hidden
                data-stems-pick
              />
              <p class="dropzone__title">Arrastra aquí los stems</p>
              <p class="dropzone__sub">mp3 / wav / m4a · varios a la vez · o haz clic</p>
            </div>
            <div class="stems-list" data-stems-list></div>
          </div>

        </div>

        <!-- Mezcla audible (vídeo o stems) → se incrusta al publicar stems -->
        <div class="mix-preview" data-mix-preview>
          <p class="mix-preview__title">Escuchar mezcla (audio + ruido)</p>
          <p class="mix-protect" role="note">
            El <strong>Play aquí</strong> usa stems <strong>limpios</strong> + el ruido del
            slider. Al <strong>publicar / guardar</strong> se graba esa mezcla en los archivos del
            visitante. Si solo cambias el slider y guardas (sin re-arrastrar), se re-hornea desde la
            copia limpia del servidor. Si no hay copia limpia, hay que arrastrar stems otra vez.
          </p>
          <p class="hint">
            🟢 bolitas verdes = media en servidor (no significa “mezcla recién recalculada”).
            Naranja al subir/bake; si mueves el ruido y guardas, verás bake otra vez.
          </p>
          <label class="mix-slider">
            <span>Volumen audio <em data-music-pct>100%</em></span>
            <input
              type="range"
              min="0"
              max="100"
              value="100"
              step="1"
              data-music-level
              aria-label="Volumen de tu audio"
            />
          </label>
          <label class="mix-slider">
            <span>Volumen ruido <em data-noise-pct>12%</em></span>
            <input
              type="range"
              min="0"
              max="40"
              value="12"
              step="1"
              data-noise-level
              aria-label="Volumen de ruido de preview"
            />
          </label>
          <div class="mix-actions">
            <button type="button" class="btn btn--gold" data-mix-play>▶ Escuchar</button>
            <button type="button" class="btn btn--sm" data-mix-stop>Stop</button>
          </div>
          <p class="mix-msg" data-mix-msg hidden></p>
        </div>

        <fieldset class="chips-field">
          <legend>Moods</legend>
          <p class="hint">
            Clic para marcar en esta obra. <strong>Dorado / relleno</strong> = seleccionada (y filtro
            público).
          </p>
          <div class="mood-tags" data-mood-tags role="group" aria-label="Moods de la obra"></div>
          <div class="add-chip">
            <input type="text" placeholder="Nuevo mood…" data-mood-custom maxlength="40" />
            <button type="button" class="btn btn--sm" data-mood-add>Añadir</button>
          </div>
          <details class="mood-manage">
            <summary>Gestionar lista</summary>
            <ul class="mood-manage-list" data-mood-manage></ul>
          </details>
          <p class="hint" data-mood-hint hidden></p>
        </fieldset>

        <label>
          Descripción
          <textarea name="description" rows="2"></textarea>
        </label>
        <label>
          Notas
          <textarea name="notes" rows="2"></textarea>
        </label>
        <label class="check">
          <input type="checkbox" name="licenseEnabled" checked /> Licencia habilitada
        </label>
        <label class="check">

        </label>
        <label>
          Año
          <input name="year" type="number" value="2026" />
        </label>

        <p class="hint" data-edit-hint hidden>
          Guardar fusiona cambios: la media que no toques se mantiene. Puedes guardar varias
          veces seguidas.
        </p>
        <button type="submit" class="btn btn--gold" data-publish>
          Publicar en la web
        </button>
        <p class="status" data-status hidden></p>
      </form>
      <!-- Toast fijo de éxito (más tiempo visible) -->
      <div class="toast" data-toast hidden role="status"></div>

      <hr class="sep" />

      <section class="feed-block" data-feed-block>
        <h2 class="subhead">Feed · Novedades (home)</h2>
        <p class="lead lead--sm">
          Panel lateral de la home. Título + descripción + miniatura opcional (imagen o GIF animado).
          Se guarda en R2 y se ve al recargar, sin redeploy.
        </p>
        <form class="form" data-feed-form>
          <label>
            Título del aviso *
            <input name="feedTitle" required maxlength="160" placeholder="Web en construcción" data-feed-title />
          </label>
          <label>
            Descripción *
            <textarea
              name="feedSummary"
              required
              maxlength="500"
              rows="3"
              placeholder="Estamos construyendo la web…"
              data-feed-summary
            ></textarea>
          </label>
          <div class="feed-row">
            <label>
              Etiqueta
              <select name="feedTag" data-feed-tag>
                <option value="nuevo">Nuevo</option>
                <option value="mejora">Mejora</option>
                <option value="fix">Fix</option>
                <option value="proximo" selected>Próximo</option>
              </select>
            </label>
            <label>
              Fecha
              <input name="feedDate" type="date" data-feed-date />
            </label>
          </div>
          <label>
            Miniatura imagen / GIF (opcional)
            <input
              type="file"
              accept="image/jpeg,image/png,image/webp,image/gif,.jpg,.jpeg,.png,.webp,.gif"
              data-feed-image
            />
          </label>
          <p class="lead lead--sm">
            JPG, PNG, WebP o GIF (hasta 8&nbsp;MB). El GIF se anima en el feed.
          </p>
          <div class="preview preview--img" data-feed-image-preview hidden></div>
          <button type="submit" class="btn btn--gold" data-feed-publish>
            Publicar en el feed
          </button>
          <p class="status" data-feed-status hidden></p>
        </form>
        <div class="feed-tiles-wrap">
          <p class="lead lead--sm">Entradas del feed</p>
          <div class="feed-tiles pub-grid" data-feed-grid>
            <p class="pub-empty">Cargando…</p>
          </div>
        </div>
      </section>

      <pre class="out" data-out hidden></pre>
    </div>

    <aside class="pub-rail" data-pub-rail>
      <div class="pub-rail__head">
        <h2 class="subhead">Publicaciones</h2>
        <button
          type="button"
          class="btn btn--sm"
          data-rebuild-previews
          title="Genera 1 mix preview por obra (play rápido en biblioteca)"
        >
          🎧 Previews
        </button>
        <button type="button" class="btn btn--sm" data-pub-refresh title="Actualizar">↻</button>
      </div>
      <p class="lead lead--sm">Catálogo vivo · celdas · 🎧 = mix play</p>
      <!-- Barra de progreso del botón 🎧 Previews (justo debajo del texto) -->
      <div class="preview-job" data-preview-job hidden role="status" aria-live="polite">
        <div class="preview-job__top">
          <span class="preview-job__msg" data-preview-job-msg>Listo</span>
          <span class="preview-job__pct" data-preview-job-pct></span>
        </div>
        <div class="preview-job__track" aria-hidden="true">
          <div class="preview-job__fill" data-preview-job-fill style="--p:0%"></div>
        </div>
        <p class="preview-job__detail" data-preview-job-detail></p>
      </div>
      <div class="pub-frame" data-pub-frame>
        <div class="pub-grid" data-pub-grid>
          <p class="pub-empty">Cargando…</p>
        </div>
        <div class="pub-pager" data-pub-pager hidden>
          <button type="button" class="btn btn--sm" data-pub-prev aria-label="Anterior">‹</button>
          <span class="pub-page" data-pub-page>1 / 1</span>
          <button type="button" class="btn btn--sm" data-pub-next aria-label="Siguiente">›</button>
        </div>
      </div>
    </aside>
    </div>
  </div>
</Layout>

<script>
  import { bakePreviewNoise, bakeMixPreview, bakeMixPreviewFromUrls } from "../../lib/preview-noise-bake";
  import { AdminMixPreview } from "../../lib/admin-mix-preview";
  import { compressImageForUpload } from "../../lib/admin-image-compress";
  import { runPreviewRebuild } from "../../lib/admin/preview-rebuild";
  import { bindAdminFeed } from "../../lib/admin/feed";
  import { createStemsUi } from "../../lib/admin/stems-ui";

  type StemRow = { label: string; file: File | null };
  const mixPreview = new AdminMixPreview();

  document.querySelector("[data-logout]")?.addEventListener("click", async () => {
    await fetch("/admin/session", { method: "DELETE", credentials: "same-origin" });
    location.href = "/admin/biblioteca/";
  });

  bindAdminFeed();

  let channel: "video" | "stems" = "video";
  // stemRows se sincroniza con stemsUi (dropzone + filas)
  let stemRows: StemRow[] = [];
  /** null = alta nueva; string = editando slug */
  let editingSlug: string | null = null;
  let editingItem: Record<string, unknown> | null = null;
  let publications: Record<string, unknown>[] = [];
  const PUB_PAGE_SIZE = 12;
  let pubPage = 0;

  const slugify = (s: string) =>
    s
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/(^-|-$)/g, "");

  document.querySelectorAll("[data-channel]").forEach((btn) => {
    btn.addEventListener("click", () => {
      setChannel(((btn as HTMLElement).dataset.channel as "video" | "stems") || "video");
    });
  });

  const bindPreview = (inputSel: string, previewSel: string, kind: "video" | "img") => {
    const input = document.querySelector(inputSel);
    const box = document.querySelector(previewSel);
    if (!(input instanceof HTMLInputElement) || !(box instanceof HTMLElement)) return;
    input.addEventListener("change", () => {
      const f = input.files?.[0];
      if (!f) {
        box.hidden = true;
        box.innerHTML = "";
        return;
      }
      const url = URL.createObjectURL(f);
      box.hidden = false;
      box.innerHTML =
        kind === "video"
          ? `<video src="${url}" controls playsinline></video><p class="fname">${f.name}</p>`
          : `<img src="${url}" alt="" /><p class="fname">${f.name}</p>`;
    });
  };
  bindPreview("[data-video-file]", "[data-video-preview]", "video");
  bindPreview("[data-cover-file]", "[data-cover-preview]", "img");
  bindPreview("[data-stems-video]", "[data-stems-video-preview]", "video");
  bindPreview("[data-stems-cover]", "[data-stems-cover-preview]", "img");
  bindPreview("[data-feed-image]", "[data-feed-image-preview]", "img");
  for (const sel of [
    "[data-video-file]",
    "[data-cover-file]",
    "[data-stems-video]",
    "[data-stems-cover]",
  ]) {
    document.querySelector(sel)?.addEventListener("change", () => refreshLocalPendingLights());
  }

  let toastTimer = 0;
  const showToast = (msg: string, ms = 14000) => {
    const toast = document.querySelector("[data-toast]");
    if (!(toast instanceof HTMLElement)) return;
    toast.hidden = false;
    toast.textContent = msg;
    toast.classList.add("is-on");
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toast.classList.remove("is-on");
      toast.hidden = true;
    }, ms);
  };

  const setStatus = (msg: string, ok = true) => {
    const el = document.querySelector("[data-status]");
    if (!(el instanceof HTMLElement)) return;
    el.hidden = false;
    el.textContent = msg;
    el.classList.toggle("is-err", !ok);
    if (ok && (msg.startsWith("✅") || msg.includes("Publicado") || msg.includes("Guardado"))) {
      showToast(msg, 16000);
    }
  };

  type MediaLightState = "idle" | "ok" | "loading" | "err" | "pending";
  const setLight = (key: string, state: MediaLightState, text: string) => {
    const row = document.querySelector(`[data-ml="${key}"]`);
    if (!(row instanceof HTMLElement)) return;
    row.dataset.state = state;
    const txt = row.querySelector("[data-ml-txt]");
    if (txt) txt.textContent = text;
  };

  const refreshLocalPendingLights = () => {
    const localVideo =
      !!(document.querySelector("[data-video-file]") as HTMLInputElement)?.files?.[0] ||
      !!(document.querySelector("[data-stems-video]") as HTMLInputElement)?.files?.[0];
    const localCover =
      !!(document.querySelector("[data-cover-file]") as HTMLInputElement)?.files?.[0] ||
      !!(document.querySelector("[data-stems-cover]") as HTMLInputElement)?.files?.[0];
    const localStems = stemRows.filter((r) => r.file).length;
    // Naranja = en el PC, aún no en R2. Verde solo tras publicar con éxito.
    if (localVideo) setLight("video", "pending", "En PC · falta publicar");
    if (localCover) setLight("cover", "pending", "En PC · falta publicar");
    if (localStems) setLight("stems", "pending", `${localStems} en PC · falta publicar`);
    if (localVideo || localCover || localStems) {
      setLight("upload", "pending", "→ Dale a Publicar");
    }
  };

  const stemsUi = createStemsUi({
    onStatus: (msg, ok) => setStatus(msg, ok !== false),
    onChange: () => {
      stemRows = stemsUi.getRows();
      refreshLocalPendingLights();
    },
  });
  const renderStems = () => {
    stemRows = stemsUi.getRows();
    stemsUi.render();
  };
  const addStemFiles = (files: FileList | File[]) => stemsUi.addFiles(files);

  // Mezcla preview: volúmenes audio / ruido
  const musicRange = document.querySelector<HTMLInputElement>("[data-music-level]");
  const noiseRange = document.querySelector<HTMLInputElement>("[data-noise-level]");
  const musicPct = document.querySelector("[data-music-pct]");
  const noisePct = document.querySelector("[data-noise-pct]");
  const mixMsg = document.querySelector("[data-mix-msg]");

  const readMixGains = () => ({
    music01: Number(musicRange?.value || 100) / 100,
    noise01: Number(noiseRange?.value || 12) / 100,
  });

  const syncMixLabels = () => {
    const { music01, noise01 } = readMixGains();
    if (musicPct) musicPct.textContent = `${Math.round(music01 * 100)}%`;
    if (noisePct) noisePct.textContent = `${Math.round(noise01 * 100)}%`;
    mixPreview.setGains(music01, noise01);
  };
  /** true si el usuario movió audio/ruido desde la última carga/guardado */
  let mixDirty = false;
  musicRange?.addEventListener("input", () => {
    mixDirty = true;
    syncMixLabels();
  });
  noiseRange?.addEventListener("input", () => {
    mixDirty = true;
    syncMixLabels();
  });
  syncMixLabels();

  const setMixMsg = (msg: string, err = false) => {
    if (!(mixMsg instanceof HTMLElement)) return;
    mixMsg.hidden = !msg;
    mixMsg.textContent = msg;
    mixMsg.classList.toggle("is-err", err);
  };

  document.querySelector("[data-mix-stop]")?.addEventListener("click", () => {
    mixPreview.stop();
    setMixMsg("Stop.");
  });

  document.querySelector("[data-mix-play]")?.addEventListener("click", async () => {
    const { music01, noise01 } = readMixGains();
    mixPreview.setGains(music01, noise01);
    setMixMsg("Cargando…");
    try {
      if (channel === "stems") {
        // Preferir archivos locales limpios (recién arrastrados)
        const files = stemRows.map((r) => r.file).filter((f): f is File => !!f);
        if (files.length) {
          await mixPreview.playStems(files);
          setMixMsg(
            `Stems limpios (local) · ${files.length} capa(s) · audio ${Math.round(music01 * 100)}% · ruido ${Math.round(noise01 * 100)}%`,
          );
          return;
        }
        // Edición: preferir cleanSrc (sin ruido); fallback a src ruidoso con aviso
        type ServerStem = { src?: string; cleanSrc?: string };
        const serverStems = Array.isArray(editingItem?.stems)
          ? (editingItem!.stems as ServerStem[])
          : [];
        const cleanUrls = serverStems
          .map((s) => String(s.cleanSrc || "").trim())
          .filter(Boolean);
        const noisyUrls = serverStems.map((s) => String(s.src || "").trim()).filter(Boolean);
        if (cleanUrls.length) {
          await mixPreview.playStemUrls(cleanUrls);
          setMixMsg(
            `Stems limpios (servidor) · ${cleanUrls.length} capa(s) · audio ${Math.round(music01 * 100)}% · ruido ${Math.round(noise01 * 100)}%`,
          );
          return;
        }
        if (!noisyUrls.length) {
          setMixMsg("No hay stems locales ni en servidor. Arrastra audio o elige otra ficha.", true);
          return;
        }
        await mixPreview.playStemUrls(noisyUrls);
        setMixMsg(
          `⚠ Solo hay stems CON RUIDO guardados (publicación antigua). Arrastra los limpios una vez y guarda: a partir de ahí el Play usará limpios y podrás re-mezclar ruido.`,
          true,
        );
      } else {
        const vInput = document.querySelector<HTMLInputElement>("[data-video-file]");
        const file = vInput?.files?.[0];
        const previewBox = document.querySelector("[data-video-preview]");
        let videoEl = previewBox?.querySelector("video") as HTMLVideoElement | null;
        if (!videoEl && file) {
          const url = URL.createObjectURL(file);
          if (previewBox instanceof HTMLElement) {
            previewBox.hidden = false;
            previewBox.innerHTML = `<video src="${url}" controls playsinline></video><p class="fname">${file.name}</p>`;
            videoEl = previewBox.querySelector("video");
          }
        }
        if (!videoEl && editingItem?.video) {
          const url = String(editingItem.video);
          if (previewBox instanceof HTMLElement) {
            previewBox.hidden = false;
            previewBox.innerHTML = `<video src="${url}" controls playsinline></video><p class="fname">servidor</p>`;
            videoEl = previewBox.querySelector("video");
          }
        }
        if (!videoEl) {
          setMixMsg("No hay vídeo local ni en servidor.", true);
          return;
        }
        await mixPreview.playMediaElement(videoEl);
        setMixMsg(
          `Vídeo + ruido · audio ${Math.round(music01 * 100)}% · ruido ${Math.round(noise01 * 100)}%`,
        );
      }
    } catch (e) {
      setMixMsg(e instanceof Error ? e.message : "No se pudo reproducir", true);
    }
  });

  // Moods simples: pill azul = en la obra + filtro biblioteca. Menú plegado = borrar.
  const MOOD_LS_KEY = "nimpo-admin-moods-v1";
  const MOOD_DENY_KEY = "nimpo-admin-moods-deny-v1";
  const DEFAULT_MOODS = [
    "oscuro", "orgánico", "inmersivo", "nocturno", "lento", "energético",
    "etérea", "apertura", "cinematic", "minimal", "esperanza",
    "ambient", "forest", "electronic", "groove", "pads", "strings", "synth",
  ];

  const normalizeMood = (raw: string) =>
    String(raw || "").trim().toLowerCase().replace(/\s+/g, " ").slice(0, 40);

  const loadStoredMoods = (): string[] => {
    try {
      const raw = JSON.parse(localStorage.getItem(MOOD_LS_KEY) || "[]");
      return Array.isArray(raw) ? raw.map(normalizeMood).filter(Boolean) : [];
    } catch { return []; }
  };
  const loadDeniedMoods = (): Set<string> => {
    try {
      return new Set((JSON.parse(localStorage.getItem(MOOD_DENY_KEY) || "[]") as string[]).map(normalizeMood));
    } catch { return new Set(); }
  };
  const saveStoredMoods = (list: string[]) => {
    try {
      localStorage.setItem(
        MOOD_LS_KEY,
        JSON.stringify([...new Set(list.map(normalizeMood).filter(Boolean))].sort((a, b) => a.localeCompare(b, "es"))),
      );
    } catch { /* */ }
  };
  const rememberMood = (v: string) => {
    const n = normalizeMood(v);
    if (!n) return;
    // si estaba en denylist, revivir
    try {
      const deny = loadDeniedMoods();
      if (deny.has(n)) {
        deny.delete(n);
        localStorage.setItem(MOOD_DENY_KEY, JSON.stringify([...deny]));
      }
    } catch { /* */ }
    const set = new Set(loadStoredMoods());
    set.add(n);
    saveStoredMoods([...set]);
  };
  const forgetMood = (v: string) => {
    const n = normalizeMood(v);
    saveStoredMoods(loadStoredMoods().filter((m) => m !== n));
    try {
      const deny = loadDeniedMoods();
      deny.add(n);
      localStorage.setItem(MOOD_DENY_KEY, JSON.stringify([...deny]));
    } catch { /* */ }
  };

  /** Moods del servidor (R2 catalog/moods.json + ítems) */
  let serverMoods: string[] = [];

  const moodVocabulary = (): string[] => {
    const deny = loadDeniedMoods();
    const s = new Set(DEFAULT_MOODS.map(normalizeMood));
    for (const m of serverMoods) s.add(normalizeMood(m));
    for (const m of loadStoredMoods()) s.add(m);
    for (const p of publications) {
      for (const m of (p.moods as string[]) || []) s.add(normalizeMood(m));
      for (const t of (p.tags as string[]) || []) s.add(normalizeMood(t));
    }
    return [...s].filter((m) => m && !deny.has(m)).sort((a, b) => a.localeCompare(b, "es"));
  };

  const readSelectedMoods = (): string[] => {
    const tagsEl = document.querySelector("[data-mood-tags]");
    if (!(tagsEl instanceof HTMLElement)) return [];
    return [...tagsEl.querySelectorAll<HTMLElement>("[data-mood-tag].is-on")]
      .map((el) => normalizeMood(el.dataset.mood || ""))
      .filter(Boolean);
  };

  const rebuildMoodPick = (opts?: { selected?: string[]; filters?: string[] }) => {
    const tagsEl = document.querySelector("[data-mood-tags]");
    const manageEl = document.querySelector("[data-mood-manage]");
    if (!(tagsEl instanceof HTMLElement)) return;

    // selected = moods de la obra = también filtros públicos
    let selected = new Set<string>();
    if (opts?.selected || opts?.filters) {
      for (const m of opts.selected || []) selected.add(normalizeMood(m));
      for (const m of opts.filters || []) selected.add(normalizeMood(m));
    } else {
      for (const m of readSelectedMoods()) selected.add(m);
    }
    for (const m of selected) rememberMood(m);

    const vocab = moodVocabulary();
    tagsEl.innerHTML = "";
    for (const m of vocab) {
      const on = selected.has(m);
      const pill = document.createElement("button");
      pill.type = "button";
      pill.className = on ? "mood-tag is-on" : "mood-tag";
      pill.dataset.moodTag = "1";
      pill.dataset.mood = m;
      pill.setAttribute("aria-pressed", on ? "true" : "false");
      pill.textContent = m;
      pill.title = on ? "Seleccionada · clic para quitar" : "Clic para marcar en esta obra";
      // Estilo inline de respaldo (por si el CSS scope falla otra vez)
      if (on) {
        pill.style.background = "#c9a962";
        pill.style.borderColor = "#c9a962";
        pill.style.color = "#0c0a06";
        pill.style.fontWeight = "700";
        pill.style.boxShadow = "0 0 0 2px rgba(201,169,98,0.5)";
      }
      pill.addEventListener("click", (ev) => {
        ev.preventDefault();
        ev.stopPropagation();
        const next = new Set(readSelectedMoods());
        if (next.has(m)) next.delete(m);
        else next.add(m);
        rebuildMoodPick({ selected: [...next] });
      });
      tagsEl.appendChild(pill);
      if (on) {
        const hi = document.createElement("input");
        hi.type = "checkbox";
        hi.name = "moodPick";
        hi.value = m;
        hi.checked = true;
        hi.hidden = true;
        tagsEl.appendChild(hi);
        const hf = document.createElement("input");
        hf.type = "checkbox";
        hf.name = "moodFilter";
        hf.value = m;
        hf.checked = true;
        hf.hidden = true;
        tagsEl.appendChild(hf);
      }
    }

    if (manageEl instanceof HTMLElement) {
      manageEl.innerHTML = "";
      for (const m of vocab) {
        const li = document.createElement("li");
        li.className = "mood-manage-row";
        const del = document.createElement("button");
        del.type = "button";
        del.className = "mood-trash";
        del.setAttribute("aria-label", "Borrar " + m);
        del.title = "Quitar de la lista";
        del.innerHTML =
          '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6"/></svg>';
        del.addEventListener("click", () => {
          if (!confirm("¿Quitar «" + m + "» de la lista global?")) return;
          forgetMood(m);
          void (async () => {
            try {
              const res = await fetch("/admin/items", {
                method: "POST",
                credentials: "same-origin",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ action: "remove_mood", mood: m }),
              });
              const data = await res.json();
              if (res.ok && data.ok && Array.isArray(data.moods)) {
                serverMoods = data.moods.map(String);
              }
            } catch {
              /* local deny ya aplicado */
            }
            rebuildMoodPick({ selected: readSelectedMoods().filter((x) => x !== m) });
            setStatus("Mood «" + m + "» quitado de la lista.");
          })();
        });
        const span = document.createElement("span");
        span.className = "mood-manage-name";
        span.textContent = m;
        // Orden: papelera | nombre (columnas alineadas)
        li.appendChild(del);
        li.appendChild(span);
        manageEl.appendChild(li);
      }
    }

    const hint = document.querySelector("[data-mood-hint]");
    if (hint instanceof HTMLElement) {
      hint.hidden = false;
      hint.textContent =
        selected.size + " marcados (obra + filtro web) · " + vocab.length + " etiquetas";
    }
  };

  const addMoodFromInput = () => {
    const input = document.querySelector("[data-mood-custom]");
    if (!(input instanceof HTMLInputElement)) return;
    const v = normalizeMood(input.value);
    if (!v) {
      setStatus("Escribe un mood para añadir.", false);
      return;
    }
    rememberMood(v);
    const next = new Set(readSelectedMoods());
    next.add(v);
    rebuildMoodPick({ selected: [...next] });
    input.value = "";
    setStatus("Mood «" + v + "» añadido y marcado (azul).");
  };

  document.querySelector("[data-mood-add]")?.addEventListener("click", (e) => {
    e.preventDefault();
    addMoodFromInput();
  });
  document.querySelector("[data-mood-custom]")?.addEventListener("keydown", (e) => {
    if ((e as KeyboardEvent).key === "Enter") {
      e.preventDefault();
      addMoodFromInput();
    }
  });

  // No rebuild aquí: loadPubs trae moods de R2 y pinta una sola vez (evita parpadeo lista corta)

  const setChannel = (ch: "video" | "stems") => {
    channel = ch;
    document.querySelectorAll("[data-channel]").forEach((b) => {
      b.classList.toggle("is-active", (b as HTMLElement).dataset.channel === ch);
    });
    const vf = document.querySelector("[data-video-fields]");
    const sf = document.querySelector("[data-stems-fields]");
    if (vf instanceof HTMLElement) vf.hidden = ch !== "video";
    if (sf instanceof HTMLElement) sf.hidden = ch !== "stems";
    const videoInput = document.querySelector("[data-video-file]");
    if (videoInput instanceof HTMLInputElement) {
      videoInput.required = ch === "video" && !editingSlug;
    }
  };

  const setMediaBanner = (
    sel: string,
    state: boolean | "ok" | "bad" | "loading",
    html: string,
    show: boolean,
  ) => {
    const el = document.querySelector(sel);
    if (!(el instanceof HTMLElement)) return;
    if (!show) {
      el.hidden = true;
      el.textContent = "";
      el.classList.remove("is-ok", "is-bad", "is-loading");
      return;
    }
    el.hidden = false;
    const kind =
      state === true || state === "ok"
        ? "ok"
        : state === "loading"
          ? "loading"
          : "bad";
    el.classList.toggle("is-ok", kind === "ok");
    el.classList.toggle("is-bad", kind === "bad");
    el.classList.toggle("is-loading", kind === "loading");
    el.innerHTML = html;
  };

  /** Avisos + bolitas verdes/naranjas/rojas junto a cada zona de archivos. */
  const paintMediaStatus = (item: Record<string, unknown> | null) => {
    if (!item) {
      setMediaBanner("[data-status-video]", true, "", false);
      setMediaBanner("[data-status-stems]", true, "", false);
      setMediaBanner("[data-status-stems-visual]", true, "", false);
      setLight("video", "idle", "—");
      setLight("cover", "idle", "—");
      setLight("stems", "idle", "—");
      setLight("upload", "idle", "—");
      return;
    }

    const videoUrl = item.video ? String(item.video) : "";
    const coverUrl = item.cover ? String(item.cover) : "";
    const stems = Array.isArray(item.stems) ? item.stems : [];
    const videoName = videoUrl ? decodeURIComponent(videoUrl.split("/").pop() || videoUrl) : "";
    const coverName = coverUrl ? decodeURIComponent(coverUrl.split("/").pop() || coverUrl) : "";
    const stemNames = stems
      .map((s: { label?: string; src?: string }) =>
        String(s.label || (s.src || "").split("/").pop() || "?"),
      )
      .filter(Boolean);

    const localVideo =
      !!(document.querySelector("[data-video-file]") as HTMLInputElement)?.files?.[0] ||
      !!(document.querySelector("[data-stems-video]") as HTMLInputElement)?.files?.[0];
    const localCover =
      !!(document.querySelector("[data-cover-file]") as HTMLInputElement)?.files?.[0] ||
      !!(document.querySelector("[data-stems-cover]") as HTMLInputElement)?.files?.[0];
    const localStems = stemRows.filter((r) => r.file).length;

    if (localVideo) setLight("video", "pending", "En PC · falta publicar");
    else if (videoUrl) setLight("video", "ok", videoName.slice(0, 28));
    else setLight("video", "err", "Sin vídeo");

    if (localCover) setLight("cover", "pending", "En PC · falta publicar");
    else if (coverUrl) setLight("cover", "ok", coverName.slice(0, 28));
    else setLight("cover", "idle", "Opcional");

    if (localStems) setLight("stems", "pending", `${localStems} en PC · falta publicar`);
    else if (stemNames.length) setLight("stems", "ok", `${stemNames.length} en servidor`);
    else setLight("stems", channel === "stems" ? "err" : "idle", channel === "stems" ? "Faltan" : "—");

    if (localVideo || localCover || localStems) setLight("upload", "pending", "→ Dale a Publicar");
    else setLight("upload", "ok", "En catálogo");

    // Canal vídeo
    if (videoUrl) {
      setMediaBanner(
        "[data-status-video]",
        "ok",
        `<strong>✓ Vídeo en servidor</strong><br/><span>${videoName}</span>` +
          (coverName ? `<br/><span>Cover: ${coverName}</span>` : "") +
          `<br/><span class="media-status__note">Cada re-subida crea URL nueva (no reutiliza caché del audio/vídeo viejo).</span>`,
        true,
      );
    } else {
      setMediaBanner(
        "[data-status-video]",
        "bad",
        `<strong>✗ No hay vídeo en servidor</strong><br/><span>Elige un archivo mp4/webm o la ficha no tendrá vídeo.</span>`,
        true,
      );
    }

    // Canal stems — visual
    if (videoUrl || coverName) {
      setMediaBanner(
        "[data-status-stems-visual]",
        "ok",
        `<strong>✓ Visual en servidor</strong><br/><span>${
          videoName ? `Vídeo: ${videoName}` : ""
        }${videoName && coverName ? " · " : ""}${coverName ? `Cover: ${coverName}` : ""}</span>`,
        true,
      );
    } else {
      setMediaBanner(
        "[data-status-stems-visual]",
        "bad",
        `<strong>Sin vídeo/cover en servidor</strong><br/><span>Opcional: puedes subir visual ahora o dejarlo vacío.</span>`,
        true,
      );
    }

    // Canal stems — audio
    const stemsArr = Array.isArray(item?.stems) ? (item.stems as { cleanSrc?: string }[]) : [];
    const cleanCount = stemsArr.filter((s) => s && s.cleanSrc).length;
    if (stemNames.length) {
      const cleanNote =
        cleanCount === stemNames.length
          ? `Play del admin usa stems limpios (${cleanCount}). Visitantes oyen la versión con ruido.`
          : cleanCount > 0
            ? `Solo ${cleanCount}/${stemNames.length} tienen copia limpia. Arrastra de nuevo los que falten.`
            : `⚠ Sin copia limpia. Arrastra stems limpios y guarda (URL nueva cada vez).`;
      setMediaBanner(
        "[data-status-stems]",
        cleanCount > 0 ? "ok" : "bad",
        `<strong>✓ ${stemNames.length} stem(s) en servidor</strong><br/><span>${stemNames.join(" · ")}</span>` +
          `<br/><span class="media-status__note">${cleanNote}</span>`,
        true,
      );
    } else {
      setMediaBanner(
        "[data-status-stems]",
        "bad",
        `<strong>✗ No hay stems en servidor</strong><br/><span>Arrastra al menos un audio o no se podrá publicar esta ficha stems.</span>`,
        true,
      );
    }
  };

  const setEditMode = (item: Record<string, unknown> | null) => {
    editingItem = item;
    editingSlug = item ? String(item.slug || "") : null;
    const bar = document.querySelector("[data-edit-bar]");
    const label = document.querySelector("[data-edit-label]");
    const hint = document.querySelector("[data-edit-hint]");
    const pubBtn = document.querySelector("[data-publish]");
    const slugInput = document.querySelector<HTMLInputElement>("[data-slug]");
    if (bar instanceof HTMLElement) bar.hidden = !item;
    if (hint instanceof HTMLElement) hint.hidden = !item;
    if (label) label.textContent = item ? `Editando «${item.title || item.slug}»` : "";
    if (pubBtn) pubBtn.textContent = item ? "Guardar cambios" : "Publicar en la web";
    if (slugInput) {
      slugInput.readOnly = !!item;
      slugInput.style.opacity = item ? "0.7" : "1";
    }
    // En edición el vídeo no es obligatorio en el input
    const videoInput = document.querySelector("[data-video-file]");
    if (videoInput instanceof HTMLInputElement) {
      videoInput.required = !item && channel === "video";
    }
    if (!item) {
      const form = document.querySelector("[data-admin-form]");
      if (form instanceof HTMLFormElement) form.reset();
      stemsUi.clear();
      stemRows = stemsUi.getRows();
      paintMediaStatus(null);
      setChannel("video");
      rebuildMoodPick({ selected: [], filters: [] });
      return;
    }

    const form = document.querySelector("[data-admin-form]");
    if (!(form instanceof HTMLFormElement)) return;
    const titleEl = form.querySelector("[data-title]") as HTMLInputElement | null;
    if (titleEl) titleEl.value = String(item.title || "");
    if (slugInput) slugInput.value = String(item.slug || "");
    const aspect = form.querySelector("[name=aspect]") as HTMLSelectElement | null;
    if (aspect) aspect.value = String(item.aspect || "1:1");
    const desc = form.querySelector("[name=description]") as HTMLTextAreaElement | null;
    if (desc) desc.value = String(item.description || "");
    const notes = form.querySelector("[name=notes]") as HTMLTextAreaElement | null;
    if (notes) notes.value = String(item.notes || "");
    const year = form.querySelector("[name=year]") as HTMLInputElement | null;
    if (year) year.value = String(item.year || new Date().getFullYear());
    const lic = form.querySelector("[name=licenseEnabled]") as HTMLInputElement | null;
    if (lic) lic.checked = item.licenseEnabled !== false;


    const kind = item.kind === "stems" || (Array.isArray(item.stems) && item.stems.length)
      ? "stems"
      : "video";
    setChannel(kind);

    // Unificar moods + tags legacy en una sola lista
    const selectedMoods = [
      ...((item.moods as string[]) || []),
      ...((item.tags as string[]) || []),
    ].map(normalizeMood).filter(Boolean);
    const filterMoods = [
      ...((item.filterMoods as string[]) || []),
      ...((item.filterTags as string[]) || []),
    ].map(normalizeMood).filter(Boolean);
    for (const m of selectedMoods) rememberMood(m);
    rebuildMoodPick({ selected: selectedMoods, filters: filterMoods });

    stemsUi.clear();
    stemRows = stemsUi.getRows();
    paintMediaStatus(item);
    mixDirty = false;
    const hasClean = Array.isArray(item.stems)
      ? (item.stems as { cleanSrc?: string }[]).some((s) => s && s.cleanSrc)
      : false;
    setStatus(
      hasClean
        ? `Editando «${item.title}». Puedes cambiar el ruido y guardar (re-hornea desde limpios). 🟢 = en servidor.`
        : `Editando «${item.title}». Sin copia limpia: para cambiar ruido hay que arrastrar stems otra vez.`,
    );
  };

  document.querySelector("[data-edit-cancel]")?.addEventListener("click", () => {
    setEditMode(null);
    setStatus("Edición cancelada.");
  });

  const renderPubs = () => {
    const grid = document.querySelector("[data-pub-grid]");
    const pager = document.querySelector("[data-pub-pager]");
    const pageLabel = document.querySelector("[data-pub-page]");
    if (!(grid instanceof HTMLElement)) return;

    if (!publications.length) {
      grid.innerHTML = `<p class="pub-empty">No hay publicaciones.</p>`;
      if (pager instanceof HTMLElement) pager.hidden = true;
      return;
    }

    const totalPages = Math.max(1, Math.ceil(publications.length / PUB_PAGE_SIZE));
    if (pubPage >= totalPages) pubPage = totalPages - 1;
    if (pubPage < 0) pubPage = 0;
    const start = pubPage * PUB_PAGE_SIZE;
    const slice = publications.slice(start, start + PUB_PAGE_SIZE);

    if (pager instanceof HTMLElement) {
      pager.hidden = totalPages <= 1;
    }
    if (pageLabel) pageLabel.textContent = `${pubPage + 1} / ${totalPages}`;
    const prev = document.querySelector("[data-pub-prev]");
    const next = document.querySelector("[data-pub-next]");
    if (prev instanceof HTMLButtonElement) prev.disabled = pubPage <= 0;
    if (next instanceof HTMLButtonElement) next.disabled = pubPage >= totalPages - 1;

    grid.innerHTML = slice
      .map((item) => {
        const slug = String(item.slug || "");
        const title = String(item.title || slug);
        const safeSlug = slug.replace(/"/g, "");
        const safeTitle = title.replace(/"/g, "");
        const thumb = `<img src="/images/admin-thumb.svg" alt="" width="64" height="64" loading="lazy" />`;
        const shortTitle = title.length > 22 ? `${title.slice(0, 20)}…` : title;
        const safeShort = shortTitle.replace(/</g, "&lt;").replace(/"/g, "&quot;");
        return `<article class="tile" data-pub-slug="${safeSlug}" title="${safeTitle}">
          <div class="tile__media" data-pub-edit="${safeSlug}" role="button" tabindex="0" aria-label="Editar ${safeTitle}">
            ${thumb}
          </div>
          <p class="tile__title">${safeShort}</p>
          <div class="tile__actions">
            <button type="button" class="tile__btn" data-pub-edit="${safeSlug}" title="Editar">✎</button>
            <button type="button" class="tile__btn tile__btn--danger" data-pub-del="${safeSlug}" title="Borrar">🗑</button>
          </div>
        </article>`;
      })
      .join("");

    grid.querySelectorAll("[data-pub-edit]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const slug = (btn as HTMLElement).dataset.pubEdit || "";
        const item = publications.find((p) => p.slug === slug);
        if (item) {
          setEditMode(item);
          document.querySelector("[data-admin-form]")?.scrollIntoView({ behavior: "smooth" });
        }
      });
    });
    grid.querySelectorAll("[data-pub-del]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const slug = (btn as HTMLElement).dataset.pubDel || "";
        if (!slug) return;
        if (!confirm(`¿Borrar «${slug}» del catálogo y sus archivos en R2? No se puede deshacer.`)) {
          return;
        }
        try {
          const res = await fetch(`/admin/items?slug=${encodeURIComponent(slug)}`, {
            method: "DELETE",
            credentials: "same-origin",
          });
          const data = await res.json();
          if (!res.ok || !data.ok) throw new Error(data.error || data.message || "Error");
          setStatus(
            `✅ ${data.message || "Borrado"} · media R2: ${data.mediaDeleted ?? "?"} archivo(s). Si la biblioteca aún lo muestra: Ctrl+F5.`,
          );
          showToast(`Borrado «${slug}» del catálogo`, 12000);
          if (editingSlug === slug) setEditMode(null);
          await loadPubs();
        } catch (e) {
          setStatus(e instanceof Error ? e.message : "Error al borrar", false);
        }
      });
    });
  };

  const loadPubs = async () => {
    const grid = document.querySelector("[data-pub-grid]");
    try {
      const res = await fetch("/admin/items", { credentials: "same-origin" });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || "No se pudo cargar");
      publications = Array.isArray(data.items) ? data.items : [];
      if (Array.isArray(data.moods) && data.moods.length) {
        // Unir, no reemplazar por lista más corta
        const merged = new Set([
          ...serverMoods.map((x) => normalizeMood(x)),
          ...data.moods.map((x: unknown) => normalizeMood(String(x))),
        ]);
        serverMoods = [...merged].filter(Boolean);
      }
      pubPage = 0;
      renderPubs();
      // Una sola pintura con vocabulario R2 (misma fuente que biblioteca pública)
      const keep = readSelectedMoods();
      rebuildMoodPick(keep.length ? { selected: keep } : { selected: [] });
    } catch (e) {
      if (grid instanceof HTMLElement) {
        grid.innerHTML = `<p class="pub-empty is-err">${e instanceof Error ? e.message : "Error"}</p>`;
      }
      // Fallback local si falla el API
      rebuildMoodPick();
    }
  };

  document.querySelector("[data-pub-prev]")?.addEventListener("click", () => {
    pubPage -= 1;
    renderPubs();
  });
  document.querySelector("[data-pub-next]")?.addEventListener("click", () => {
    pubPage += 1;
    renderPubs();
  });
  document.querySelector("[data-pub-refresh]")?.addEventListener("click", () => {
    void loadPubs();
  });

  /** 🎧 Previews → módulo admin/preview-rebuild (MP3) */
  document.querySelector("[data-rebuild-previews]")?.addEventListener("click", () => {
    void runPreviewRebuild({
      loadPubs,
      getPublications: () => publications as import("../../lib/admin/preview-rebuild").PubItem[],
    });
  });

  void loadPubs();

  document.querySelector("[data-admin-form]")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = form.querySelector("[data-publish]");
    if (btn instanceof HTMLButtonElement) btn.disabled = true;

    try {
      // No confiar en required HTML (rompe edición silenciosamente)
      const titleInput = form.querySelector("[data-title]") as HTMLInputElement | null;
      const title = String(titleInput?.value || form.querySelector<HTMLInputElement>("[name=title]")?.value || "").trim();
      if (!title) {
        setStatus("El título es obligatorio.", false);
        titleInput?.focus();
        return;
      }

      const fd = new FormData(form);
      const slug =
        (editingSlug && String(editingSlug).trim()) ||
        String(fd.get("slug") || "").trim() ||
        slugify(title);
      if (!slug) {
        setStatus("Falta slug (o un título para generarlo).", false);
        return;
      }

      // Solo moods (tags unificados); vaciamos tags en catálogo
      const moods = [...new Set(fd.getAll("moodPick").map((x) => normalizeMood(String(x))).filter(Boolean))];
      const filterMoods = [...new Set(
        fd.getAll("moodFilter").map((x) => normalizeMood(String(x))).filter((m) => moods.includes(m)),
      )];
      const tags: string[] = [];
      const filterTags: string[] = [];
      for (const m of moods) rememberMood(m);

      const hasVideoFile =
        channel === "video"
          ? !!(form.querySelector("[data-video-file]") as HTMLInputElement)?.files?.[0]
          : !!(form.querySelector("[data-stems-video]") as HTMLInputElement)?.files?.[0];
      const hasCoverFile =
        channel === "video"
          ? !!(form.querySelector("[data-cover-file]") as HTMLInputElement)?.files?.[0]
          : !!(form.querySelector("[data-stems-cover]") as HTMLInputElement)?.files?.[0];
      const hasStemFiles = stemRows.some((r) => r.file);
      const hasAnyNewMedia = hasVideoFile || hasCoverFile || hasStemFiles;

      // Cambiar solo el slider de ruido SIN stems locales → re-hornear desde cleanSrc
      type ServerStem = { id?: string; label?: string; src?: string; cleanSrc?: string };
      const serverStemsForMix = Array.isArray(editingItem?.stems)
        ? (editingItem!.stems as ServerStem[])
        : [];
      const cleanServerStems = serverStemsForMix.filter(
        (s) => s && String(s.cleanSrc || "").trim(),
      );
      const wantsRemixedNoise =
        !!editingSlug &&
        channel === "stems" &&
        !hasStemFiles &&
        mixDirty;

      if (wantsRemixedNoise && !cleanServerStems.length) {
        throw new Error(
          "Has cambiado el ruido, pero esta ficha no tiene copia limpia en servidor. Arrastra los stems limpios otra vez y publica (solo una vez); luego podrás bajar el ruido a 0% y guardar.",
        );
      }

      // Solo metadatos (título, moods…): NO toca audio. Si mixDirty + stems → se va al publish con re-bake.
      if (editingSlug && !hasAnyNewMedia && !wantsRemixedNoise) {
        setLight("upload", "loading", "Guardando meta…");
        setStatus("Guardando cambios (audio se conserva tal cual)…");
        const res = await fetch("/admin/items", {
          method: "POST",
          credentials: "same-origin",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            action: "update",
            slug: editingSlug,
            title,
            aspect: String(fd.get("aspect") || "1:1"),
            description: String(fd.get("description") || ""),
            notes: String(fd.get("notes") || ""),
            moods,
            tags,
            filterMoods,
            filterTags,
            year: Number(fd.get("year") || 2026),
            provisional: false,
            licenseEnabled: fd.get("licenseEnabled") === "on",
          }),
        });
        let data: { ok?: boolean; message?: string; error?: string; item?: unknown } = {};
        try {
          data = await res.json();
        } catch {
          throw new Error(`Respuesta no JSON (${res.status}). ¿Sesión caducada? Vuelve a entrar.`);
        }
        if (!res.ok || !data.ok) {
          throw new Error(
            data.message || data.error || `Error al guardar (${res.status})`,
          );
        }
        setLight("upload", "ok", "Meta OK · audio igual");
        setStatus(`✅ ${data.message || "Guardado"} — el audio no se tocó (no moviste el ruido o no había re-bake).`);
        showToast(`✅ «${title}» meta guardada · audio igual en servidor`, 14000);
        await loadPubs();
        const updated =
          publications.find((p) => p.slug === editingSlug) ||
          (data.item as Record<string, unknown> | undefined);
        if (updated) setEditMode(updated as Record<string, unknown>);
        mixDirty = false;
        return;
      }

      const body = new FormData();
      body.set("title", title);
      body.set("slug", slug);
      body.set("kind", channel);
      body.set("aspect", String(fd.get("aspect") || "1:1"));
      body.set("moods", JSON.stringify(moods));
      body.set("tags", JSON.stringify(tags));
      body.set("filterMoods", JSON.stringify(filterMoods));
      body.set("filterTags", JSON.stringify(filterTags));
      body.set("description", String(fd.get("description") || ""));
      body.set("notes", String(fd.get("notes") || ""));
      body.set("year", String(fd.get("year") || "2026"));
      body.set("provisional", "0");
      body.set("licenseEnabled", fd.get("licenseEnabled") === "on" ? "1" : "0");

      if (channel === "video") {
        const v = (form.querySelector("[data-video-file]") as HTMLInputElement)?.files?.[0];
        if (!v && !editingSlug) throw new Error("Elige un vídeo.");
        // En edición: sin vídeo nuevo → el servidor conserva el existente
        if (v) body.set("video", v, v.name);
        const c = (form.querySelector("[data-cover-file]") as HTMLInputElement)?.files?.[0];
        if (c) {
          const small = await compressImageForUpload(c, { maxEdge: 360, quality: 0.72 });
          body.set("cover", small, small.name);
        }
      } else {
        const v = (form.querySelector("[data-stems-video]") as HTMLInputElement)?.files?.[0];
        if (v) body.set("video", v, v.name);
        const c = (form.querySelector("[data-stems-cover]") as HTMLInputElement)?.files?.[0];
        if (c) {
          const small = await compressImageForUpload(c, { maxEdge: 360, quality: 0.72 });
          body.set("cover", small, small.name);
        }
        const { music01, noise01 } = readMixGains();
        const withFile = stemRows.filter((r) => r.file);
        if (!withFile.length && !editingSlug) {
          throw new Error("Añade al menos un stem con audio.");
        }

        const fetchCleanAsFile = async (url: string, name: string) => {
          const res = await fetch(url, { credentials: "same-origin", cache: "reload" });
          if (!res.ok) throw new Error(`No se pudo bajar limpio (${res.status}): ${name}`);
          const blob = await res.blob();
          const base = name.replace(/[^\w.\-()+ ]+/g, "_") || "stem";
          const ext = (blob.type || "").includes("wav")
            ? "wav"
            : (blob.type || "").includes("mpeg")
              ? "mp3"
              : "wav";
          return new File([blob], `${base}.${ext}`, {
            type: blob.type || "audio/wav",
          });
        };

        // A) Stems locales nuevos  B) Re-mezcla desde cleanSrc del servidor
        const bakedPublic: File[] = [];
        if (withFile.length) {
          mixPreview.stop();
          setLight("stems", "loading", `Bake ${withFile.length}…`);
          setLight("upload", "loading", "Procesando ruido…");
          setStatus(
            `Procesando mezcla (audio ${Math.round(music01 * 100)}% · ruido ${Math.round(noise01 * 100)}%) en ${withFile.length} stem(s)…`,
          );
          let n = 0;
          const layerCount = withFile.length;
          for (const row of withFile) {
            if (!row.file) continue;
            setLight("stems", "loading", `${n + 1}/${layerCount} bake`);
            body.set(`stem_${n}_clean`, row.file, row.file.name);
            let baked = row.file;
            try {
              baked = await bakePreviewNoise(row.file, noise01, music01, layerCount);
            } catch (err) {
              console.warn("[bake noise]", err);
              setLight("stems", "err", "Bake falló (sube original)");
            }
            body.set(`stem_${n}_file`, baked, baked.name);
            body.set(`stem_${n}_label`, row.label || row.file.name);
            bakedPublic.push(baked);
            n++;
          }
        } else if (wantsRemixedNoise && cleanServerStems.length) {
          mixPreview.stop();
          const layerCount = cleanServerStems.length;
          setLight("stems", "loading", `Re-mezcla ${layerCount}…`);
          setLight("upload", "loading", "Bajando limpios + bake…");
          setStatus(
            `Re-aplicando ruido ${Math.round(noise01 * 100)}% desde copias limpias (${layerCount} stem(s))…`,
          );
          let n = 0;
          for (const st of cleanServerStems) {
            const cleanUrl = String(st.cleanSrc || "").trim();
            const label = String(st.label || st.id || `stem-${n + 1}`);
            setLight("stems", "loading", `${n + 1}/${layerCount} limpio`);
            const cleanFile = await fetchCleanAsFile(cleanUrl, label);
            setLight("stems", "loading", `${n + 1}/${layerCount} bake`);
            let baked = cleanFile;
            try {
              baked = await bakePreviewNoise(cleanFile, noise01, music01, layerCount);
            } catch (err) {
              console.warn("[bake noise cleanSrc]", err);
              throw new Error(`No se pudo re-mezclar «${label}». Prueba re-subir stems.`);
            }
            body.set(`stem_${n}_clean`, cleanFile, cleanFile.name);
            body.set(`stem_${n}_file`, baked, baked.name);
            body.set(`stem_${n}_label`, label);
            bakedPublic.push(baked);
            n++;
          }
        }
        // 1 mix preview para ▶ de biblioteca (no N×WAV en el visitante)
        if (bakedPublic.length) {
          setStatus("Generando preview mix MP3…");
          setLight("stems", "loading", "Preview MP3…");
          try {
            const mix = await bakeMixPreview(bakedPublic);
            const ext = mix.type.includes("mpeg") || mix.name.endsWith(".mp3") ? "mp3" : "wav";
            body.set("preview", mix, `${slug}-preview.${ext}`);
          } catch (err) {
            console.warn("[bake mix preview]", err);
          }
        } else if (editingSlug) {
          const pub = publications.find((p) => p.slug === editingSlug) as
            | { stems?: { src?: string }[]; preview?: string }
            | undefined;
          const srcs = (pub?.stems || [])
            .map((s) => String(s.src || "").trim())
            .filter(Boolean);
          if (srcs.length && !pub?.preview) {
            try {
              setStatus("Generando preview MP3 desde stems publicados…");
              const mix = await bakeMixPreviewFromUrls(srcs, {
                credentials: "same-origin",
                cache: "reload",
              });
              const ext = mix.type.includes("mpeg") || mix.name.endsWith(".mp3") ? "mp3" : "wav";
              body.set("preview", mix, `${slug}-preview.${ext}`);
            } catch (err) {
              console.warn("[rebuild mix preview]", err);
            }
          }
        }
        // else: edición stems sin archivos nuevos ni mixDirty → publish conserva stems en servidor
      }

      mixPreview.stop();
      if (hasVideoFile) setLight("video", "loading", "Subiendo…");
      if (hasCoverFile) setLight("cover", "loading", "Subiendo…");
      if (hasStemFiles) setLight("stems", "loading", "Subiendo…");
      setLight("upload", "loading", "Publicando en R2…");
      setStatus(editingSlug ? "Subiendo archivos (URL nueva cada vez)…" : "Publicando… (subida + catálogo)");
      const res = await fetch("/admin/publish", {
        method: "POST",
        body,
        credentials: "same-origin",
      });
      const data = await res.json();
      if (!res.ok || !data.ok) {
        setLight("upload", "err", "Error");
        if (hasVideoFile) setLight("video", "err", "Falló");
        if (hasStemFiles) setLight("stems", "err", "Falló");
        const err = String(data.error || "");
        if (err === "bad_extension") {
          throw new Error(
            "Tipo de archivo no permitido. Vídeo: mp4/webm/mov · Audio: mp3/wav/m4a · Imagen: jpg/png/webp",
          );
        }
        if (err === "file_too_large" || err === "total_too_large") {
          throw new Error(
            err === "total_too_large"
              ? `Peso total máximo ${data.maxTotalMb || 250} MB por publicación`
              : `Archivo demasiado grande (máx ${data.maxMb || 100} MB)`,
          );
        }
        if (err === "missing_stems") {
          throw new Error("Faltan stems y no hay stems previos que conservar.");
        }
        if (err === "missing_video") {
          throw new Error("Falta vídeo y no hay vídeo previo que conservar.");
        }
        throw new Error(data.message || data.error || `Error ${res.status}`);
      }

      const msg =
        data.message ||
        `✅ ${editingSlug ? "Guardado" : "Publicado"} «${data.item?.title || title}»`;
      setLight("upload", "ok", mixDirty || hasStemFiles ? "Mezcla OK" : "Listo");
      if (hasStemFiles || wantsRemixedNoise) setLight("stems", "ok", "En servidor");
      mixDirty = false;
      setStatus(`✅ ${msg}`);
      showToast(
        hasStemFiles || wantsRemixedNoise
          ? `✅ ${msg} · audio con la mezcla actual (Ctrl+F5 en biblioteca)`
          : `✅ ${msg}`,
        18000,
      );
      const out = document.querySelector("[data-out]");
      if (out instanceof HTMLElement) {
        out.hidden = false;
        out.textContent = JSON.stringify(
          {
            ok: true,
            merged: data.merged,
            keptMedia: data.keptMedia,
            catalogCount: data.catalogCount,
            item: data.item,
          },
          null,
          2,
        );
      }
      await loadPubs();
      // Seguir editando el mismo ítem (cambios acumulativos)
      const updated =
        publications.find((p) => p.slug === slug) ||
        (data.item as Record<string, unknown> | undefined);
      if (updated) {
        setEditMode(updated);
        stemsUi.clear();
        stemRows = stemsUi.getRows();
        // limpiar inputs file
        form.querySelectorAll('input[type="file"]').forEach((inp) => {
          if (inp instanceof HTMLInputElement) inp.value = "";
        });
        document.querySelectorAll(".preview").forEach((p) => {
          if (p instanceof HTMLElement) {
            p.hidden = true;
            p.innerHTML = "";
          }
        });
      } else {
        setEditMode(null);
        form.reset();
        stemsUi.clear();
        stemRows = stemsUi.getRows();
      }
    } catch (err) {
      setLight("upload", "err", "Error");
      setStatus(err instanceof Error ? err.message : "Error al publicar", false);
    } finally {
      if (btn instanceof HTMLButtonElement) btn.disabled = false;
    }
  });
</script>

