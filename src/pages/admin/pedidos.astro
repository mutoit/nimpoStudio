---
/**
 * Admin pedidos / licencias — registro unificado + Emitir Founder.
 */
import Layout from "../../components/Layout.astro";
---

<Layout title="Admin pedidos" description="Pedidos y licencias" lang="es">
  <div class="container admin">
    <header class="head">
      <div>
        <p class="eyebrow">Privado · commerce</p>
        <h1>Pedidos y licencias</h1>
      </div>
      <div class="head__actions">
        <a class="btn btn--ghost" href="/admin/abonados/">Abonados</a>
        <a class="btn btn--ghost" href="/admin/tickets/">Tickets</a>
        <a class="btn btn--ghost" href="/admin/productos/">Productos</a>
        <a class="btn btn--ghost" href="/admin/biblioteca/">Biblioteca</a>
        <button type="button" class="btn btn--ghost" data-logout>Cerrar sesión</button>
      </div>
    </header>

    <p class="lead">
      Historial <strong>permanente</strong>: cada compra Stripe y cada Founder añade una fila (no se borra sola).
      <span data-stripe-flag></span>
    </p>

    <section class="card issue-card">
      <div class="issue-card__top">
        <h2 class="subhead subhead--tight">Emitir Founder</h2>
        <p class="tool-hint">
          Pegar email → Emitir → ver <strong>ENVIADO</strong> → siguiente. Producto se mantiene.
        </p>
      </div>
      <form class="issue-form" data-issue-form>
        <label class="field">
          <span>Email cliente</span>
          <input
            type="email"
            name="email"
            placeholder="cliente@…"
            required
            data-issue-email
            autocomplete="email"
          />
        </label>
        <label class="field field--grow">
          <span>Producto</span>
          <select name="productSlug" required data-issue-product>
            <option value="">Producto…</option>
          </select>
        </label>
        <button type="submit" class="btn btn--gold btn--issue" data-issue-submit>Emitir Founder</button>
      </form>
      <p class="flash" data-status hidden role="status" aria-live="assertive"></p>
    </section>

    <section class="card registry-card">
      <div class="registry-head">
        <div>
          <h2 class="subhead subhead--tight">Registro</h2>
          <p class="tool-hint">Cliente · pedido · key · estado · acciones en una sola tabla.</p>
        </div>
        <button type="button" class="btn btn--sm" data-refresh>↻ Actualizar</button>
      </div>
      <div class="table-wrap" data-registry>
        <p class="empty">Cargando…</p>
      </div>
    </section>

    <details class="card tools-extra">
      <summary>Transfer email / herramientas</summary>
      <form class="issue-form" data-transfer-form>
        <label class="field">
          <span>De</span>
          <input type="email" name="from" placeholder="from@…" required data-tr-from />
        </label>
        <label class="field">
          <span>A</span>
          <input type="email" name="to" placeholder="to@…" required data-tr-to />
        </label>
        <button type="submit" class="btn btn--sm btn--gold">Transferir</button>
      </form>
    </details>
  </div>
</Layout>

<script>
  const statusEl = document.querySelector("[data-status]");

  const setStatus = (msg: string, ok = true) => {
    if (!(statusEl instanceof HTMLElement)) return;
    statusEl.hidden = false;
    statusEl.textContent = msg;
    statusEl.classList.toggle("is-err", !ok);
    statusEl.classList.toggle("is-ok", ok);
    statusEl.classList.add("is-pulse");
    window.setTimeout(() => statusEl.classList.remove("is-pulse"), 600);
  };

  const esc = (s: string) =>
    String(s || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");

  /** Keys en UI: nunca el valor completo (solo en memoria para acciones). */
  const maskKey = (key: string) => {
    const k = String(key || "").trim();
    if (!k) return "—";
    return "••••-••••-••••";
  };

  const ICO = {
    /* flecha reenviar (verde en CSS) */
    resend: `<svg class="ico ico--lg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3.4 20.6 20.85 12.7a.9.9 0 0 0 0-1.4L3.4 3.4a.75.75 0 0 0-1.1.9l2.6 6.45H14a1 1 0 1 1 0 2H4.9L2.3 19.7a.75.75 0 0 0 1.1.9z"/></svg>`,
    /* reciclaje = nueva key */
    rotate: `<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.5 4.5 19 7l-2.5 2.5V8h-3.1a5 5 0 0 0-4.7 3.3l-1.1-.6A6.5 6.5 0 0 1 13.4 6.5H16.5V4.5zm-9 15L5 17l2.5-2.5V16h3.1a5 5 0 0 0 4.7-3.3l1.1.6A6.5 6.5 0 0 1 10.6 17.5H7.5v2zM7.8 9.2 5.2 7.8l2.2-4.1 2.6 1.4-1.1 2A6.5 6.5 0 0 1 18 12h-1.5a5 5 0 0 0-8.7-2.8z"/></svg>`,
    /* silla = reset seats */
    seat: `<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 3a3 3 0 0 0-3 3v7H3v2h2v5h2v-5h8v5h2v-5h2v-2h-2V6a3 3 0 0 0-3-3H8zm0 2h6a1 1 0 0 1 1 1v7H7V6a1 1 0 0 1 1-1z"/></svg>`,
    x: `<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.4 5 5 6.4 10.6 12 5 17.6 6.4 19 12 13.4 17.6 19 19 17.6 13.4 12 19 6.4 17.6 5 12 10.6 6.4 5z"/></svg>`,
  };

  /** key completa solo en memoria; botones usan índice */
  let keyVault: string[] = [];

  document.querySelector("[data-logout]")?.addEventListener("click", async () => {
    await fetch("/admin/session", { method: "DELETE", credentials: "same-origin" });
    location.href = "/admin/pedidos/";
  });

  type Order = {
    id: string;
    email: string;
    productName: string;
    productSlug: string;
    planId?: string;
    planName: string;
    amountEur: number | null;
    status: string;
    licenseKey?: string;
    paidAt?: string;
    createdAt: string;
  };
  type Lic = {
    key: string;
    productSlug: string;
    email: string;
    planId: string;
    seats: number;
    activations: { machineId: string }[];
    revoked: boolean;
    createdAt: string;
    orderId?: string;
  };

  const load = async () => {
    const regEl = document.querySelector("[data-registry]");
    try {
      const res = await fetch("/admin/orders", { credentials: "same-origin" });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || res.status);
      const flag = document.querySelector("[data-stripe-flag]");
      if (flag) {
        flag.textContent = data.stripeConfigured
          ? " · Stripe OK"
          : " · Stripe: falta STRIPE_SECRET_KEY";
      }

      const orders = (data.orders || []) as Order[];
      const licenses = (data.licenses || []) as Lic[];
      const licByKey = new Map(licenses.map((l) => [l.key.toUpperCase(), l]));

      if (!(regEl instanceof HTMLElement)) return;
      if (!orders.length) {
        regEl.innerHTML = `<p class="empty">Sin pedidos aún. Emite un Founder o espera una compra Stripe.</p>`;
        return;
      }

      const sorted = [...orders].sort((a, b) => {
        const ta = Date.parse(a.paidAt || a.createdAt || "") || 0;
        const tb = Date.parse(b.paidAt || b.createdAt || "") || 0;
        return tb - ta;
      });

      keyVault = [];

      regEl.innerHTML = `<table class="tbl">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Producto</th>
            <th>Plan</th>
            <th>€</th>
            <th>Key</th>
            <th>Seats</th>
            <th>Estado</th>
            <th class="th-actions"></th>
          </tr>
        </thead>
        <tbody>
        ${sorted
          .map((o) => {
            const d = (o.paidAt || o.createdAt || "").slice(0, 10);
            const key = o.licenseKey || "";
            const lic = key ? licByKey.get(key.toUpperCase()) : undefined;
            const revoked = Boolean(lic?.revoked);
            const seats = lic
              ? `${lic.activations?.length || 0}/${lic.seats || 1}`
              : "—";
            const planLabel = o.planName || o.planId || "—";
            const productLabel = (o.productName || o.productSlug || "—").trim();
            const isFounder =
              String(o.planId || "").toLowerCase() === "founder" ||
              String(o.planName || "").toLowerCase() === "founder";
            const statusBits = [
              o.status,
              revoked ? "revocada" : key ? "activa" : "sin key",
              isFounder ? "founder" : null,
            ]
              .filter(Boolean)
              .join(" · ");

            let keyIdx = -1;
            if (key) {
              keyIdx = keyVault.length;
              keyVault.push(key);
            }

            const actions = key
              ? `<div class="icon-actions">
                  <button type="button" class="ibtn ibtn--green" data-fulfill="${esc(o.id)}" title="Reenviar mail" aria-label="Reenviar mail">${ICO.resend}</button>
                  ${
                    revoked
                      ? ""
                      : `<button type="button" class="ibtn ibtn--green" data-act="reset_activations" data-ki="${keyIdx}" title="Reset seats (liberar PCs)" aria-label="Reset seats">${ICO.seat}</button>
                         <button type="button" class="ibtn ibtn--green" data-act="rotate_key" data-ki="${keyIdx}" title="Nueva key (invalida la anterior)" aria-label="Rotar key">${ICO.rotate}</button>
                         <button type="button" class="ibtn ibtn--red" data-act="revoke" data-ki="${keyIdx}" title="Revocar licencia" aria-label="Revocar">${ICO.x}</button>`
                  }
                </div>`
              : "—";

            return `<tr class="${revoked ? "is-revoked" : ""}">
              <td class="td-date">${esc(d)}</td>
              <td class="td-email">${esc(o.email)}</td>
              <td class="td-product">${esc(productLabel)}</td>
              <td>${esc(planLabel)}</td>
              <td>${o.amountEur != null ? esc(String(o.amountEur)) : "—"}</td>
              <td><span class="key-mask" title="Oculta · reenvía el mail si hace falta">${maskKey(key)}</span></td>
              <td>${esc(seats)}</td>
              <td><span class="pill">${esc(statusBits)}</span></td>
              <td class="td-actions">${actions}</td>
            </tr>`;
          })
          .join("")}
        </tbody>
      </table>`;

      regEl.querySelectorAll("[data-fulfill]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const orderId = (btn as HTMLElement).dataset.fulfill || "";
          try {
            const r = await fetch("/admin/orders", {
              method: "POST",
              credentials: "same-origin",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ action: "fulfill", orderId }),
            });
            const j = await r.json();
            if (!r.ok || !j.ok) throw new Error(j.message || j.error);
            setStatus(j.message || "Mail reenviado", true);
          } catch (e) {
            setStatus(e instanceof Error ? e.message : "Error", false);
          }
        });
      });

      const postAction = async (action: string, key: string, confirmMsg: string) => {
        if (!confirm(confirmMsg)) return;
        try {
          const r = await fetch("/admin/orders", {
            method: "POST",
            credentials: "same-origin",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action, key }),
          });
          const j = await r.json();
          if (!r.ok || !j.ok) throw new Error(j.message || j.error);
          setStatus(j.message || "OK", true);
          void load();
        } catch (e) {
          setStatus(e instanceof Error ? e.message : "Error", false);
        }
      };

      regEl.querySelectorAll("[data-act]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const el = btn as HTMLElement;
          const action = el.dataset.act || "";
          const ki = Number(el.dataset.ki);
          const key = Number.isFinite(ki) ? keyVault[ki] || "" : "";
          if (!key || !action) return;
          if (action === "revoke") void postAction("revoke", key, "¿Revocar esta licencia?");
          else if (action === "reset_activations")
            void postAction("reset_activations", key, "¿Reset seats? El cliente podrá activar de nuevo.");
          else if (action === "rotate_key")
            void postAction(
              "rotate_key",
              key,
              "¿Nueva key? La actual dejará de valer. Luego usa Reenviar para mandar la nueva.",
            );
        });
      });
    } catch (e) {
      if (regEl instanceof HTMLElement) {
        regEl.innerHTML = `<p class="empty is-err">${esc(
          e instanceof Error ? e.message : "Error",
        )}</p>`;
      }
    }
  };

  document.querySelector("[data-transfer-form]")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const fromEmail = String(
      (document.querySelector("[data-tr-from]") as HTMLInputElement | null)?.value || "",
    ).trim();
    const toEmail = String(
      (document.querySelector("[data-tr-to]") as HTMLInputElement | null)?.value || "",
    ).trim();
    if (!confirm(`¿Transferir ${fromEmail} → ${toEmail}?`)) return;
    try {
      const r = await fetch("/admin/orders", {
        method: "POST",
        credentials: "same-origin",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "transfer_email", fromEmail, toEmail }),
      });
      const j = await r.json();
      if (!r.ok || !j.ok) throw new Error(j.message || j.error);
      setStatus(j.message || "OK", true);
      void load();
    } catch (err) {
      setStatus(err instanceof Error ? err.message : "Error", false);
    }
  });

  const fillProducts = async () => {
    const sel = document.querySelector("[data-issue-product]") as HTMLSelectElement | null;
    if (!sel) return;
    try {
      const res = await fetch("/admin/products", { credentials: "same-origin" });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || res.status);
      const items = (Array.isArray(data.items) ? data.items : []) as {
        slug?: string;
        name?: string;
        status?: string;
      }[];
      const usable = items.filter((p) => p.slug && p.status !== "draft");
      const opts = usable
        .map((p) => {
          const label = `${p.name || p.slug}${
            p.status && p.status !== "published" ? ` · ${p.status}` : ""
          }`;
          return `<option value="${esc(String(p.slug))}">${esc(label)}</option>`;
        })
        .join("");
      sel.innerHTML = `<option value="">Producto…</option>${opts}`;
    } catch (e) {
      setStatus(e instanceof Error ? e.message : "No se cargaron productos", false);
    }
  };

  document.querySelector("[data-issue-form]")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const emailInput = document.querySelector("[data-issue-email]") as HTMLInputElement | null;
    const productSel = document.querySelector("[data-issue-product]") as HTMLSelectElement | null;
    const submitBtn = document.querySelector("[data-issue-submit]") as HTMLButtonElement | null;
    const email = String(emailInput?.value || "").trim();
    const productSlug = String(productSel?.value || "").trim();
    if (!email || !productSlug) {
      setStatus("Email y producto obligatorios", false);
      return;
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "…";
    }
    setStatus("Enviando…", true);

    try {
      const r = await fetch("/admin/orders", {
        method: "POST",
        credentials: "same-origin",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          action: "issue",
          email,
          productSlug,
          planId: "founder",
          planName: "Founder",
        }),
      });
      const j = await r.json();
      if (!r.ok || !j.ok) throw new Error(j.message || j.error || "issue_failed");

      // Feedback inmediato: listo para el siguiente email
      if (emailInput) {
        emailInput.value = "";
        emailInput.focus();
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Emitir Founder";
      }
      setStatus(
        j.mailed
          ? `✓ ENVIADO · ${email}`
          : `✓ KEY OK · ${email} (mail falló — revisa)`,
        true,
      );

      // Refresco de tabla en segundo plano (no bloquea el ritmo)
      void load();
    } catch (err) {
      setStatus(err instanceof Error ? err.message : "Error", false);
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Emitir Founder";
      }
    }
  });

  document.querySelector("[data-refresh]")?.addEventListener("click", () => void load());
  void fillProducts();
  void load();
</script>

<style>
  .admin {
    padding-block: 2.25rem 5rem;
    max-width: 90rem;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .head__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    align-items: center;
  }
  .eyebrow {
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-dim, #9a8b5c);
  }
  h1 {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .lead {
    color: var(--color-muted, #9a9aa6);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0.75rem 0 1.5rem;
    max-width: 48rem;
  }
  .card {
    margin: 0 0 1.5rem;
    padding: 1.25rem 1.4rem 1.4rem;
    border: 1px solid var(--color-border, #2a2a32);
    border-radius: 14px;
    background: var(--color-surface, #121218);
  }
  .issue-card {
    border-color: rgb(201 169 98 / 0.35);
    background: linear-gradient(165deg, rgb(201 169 98 / 0.07), transparent 55%),
      var(--color-surface, #121218);
  }
  .issue-card__top {
    margin-bottom: 1rem;
  }
  .subhead {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin: 0 0 0.35rem;
    font-weight: 500;
  }
  .subhead--tight {
    margin-bottom: 0.25rem;
  }
  .tool-hint {
    margin: 0;
    font-size: 0.88rem;
    color: var(--color-muted, #9a9aa6);
    line-height: 1.5;
    max-width: 40rem;
  }
  .issue-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1rem;
    align-items: flex-end;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 14rem;
  }
  .field--grow {
    flex: 1 1 16rem;
  }
  .field span {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted, #9a9aa6);
  }
  .field input,
  .field select {
    font: inherit;
    font-size: 0.95rem;
    background: var(--color-bg-elevated, #0c0c10);
    color: var(--color-fg, #e8e8ec);
    border: 1px solid var(--color-border, #2a2a32);
    border-radius: 10px;
    padding: 0.65rem 0.8rem;
    min-height: 2.75rem;
  }
  .btn--issue {
    min-height: 2.75rem;
    padding: 0.65rem 1.25rem;
    font-weight: 600;
  }
  .flash {
    margin: 1rem 0 0;
    padding: 0.85rem 1rem;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.35;
  }
  .flash.is-ok {
    color: #d4f5d4;
    background: rgb(40 130 60 / 0.28);
    border: 1px solid rgb(100 190 110 / 0.45);
  }
  .flash.is-err {
    color: #f5c4c4;
    background: rgb(130 40 40 / 0.28);
    border: 1px solid rgb(210 90 90 / 0.45);
  }
  .flash.is-pulse {
    animation: flash-in 0.45s ease;
  }
  @keyframes flash-in {
    from {
      transform: scale(0.98);
      opacity: 0.5;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }
  .registry-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
    margin-bottom: 1rem;
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-border, #2a2a32);
    border-radius: 12px;
    background: rgb(0 0 0 / 0.2);
  }
  .tbl {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .tbl th,
  .tbl td {
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--color-border, #2a2a32);
    text-align: left;
    vertical-align: middle;
  }
  .tbl th {
    color: var(--color-muted, #9a9aa6);
    font-weight: 600;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    white-space: nowrap;
    background: rgb(0 0 0 / 0.15);
  }
  .tbl tbody tr:hover {
    background: rgb(201 169 98 / 0.05);
  }
  .tbl tr.is-revoked {
    opacity: 0.5;
  }
  .td-date {
    white-space: nowrap;
    color: var(--color-muted, #9a9aa6);
    font-size: 0.85rem;
  }
  .td-email {
    font-weight: 500;
    word-break: break-word;
    max-width: 16rem;
  }
  .td-product {
    font-weight: 600;
    max-width: 14rem;
  }
  .key-mask {
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: var(--color-muted, #9a9aa6);
    user-select: none;
  }
  .pill {
    display: inline-block;
    font-size: 0.75rem;
    line-height: 1.35;
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--color-accent, #c9a962);
  }
  .th-actions {
    width: 1%;
  }
  .td-actions {
    width: 1%;
    white-space: nowrap;
    padding-right: 0.65rem !important;
  }
  .icon-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .ibtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.85rem;
    height: 1.85rem;
    padding: 0;
    border-radius: 8px;
    border: 1px solid var(--color-border, #2a2a32);
    background: rgb(0 0 0 / 0.25);
    cursor: pointer;
    color: #4ade80;
    transition: background 0.12s ease, border-color 0.12s ease, transform 0.1s ease;
