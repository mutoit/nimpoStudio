---
/**
 * Admin productos software (solo estudio).
 * Sube nombre, descripción, imágenes/GIF y vídeo → R2 + catálogo vivo.
 */
import Layout from "../../components/Layout.astro";
---

<Layout title="Admin productos" description="Panel privado de productos" lang="es">
  <div class="container admin">
    <header class="head">
      <div>
        <p class="eyebrow">Privado · no indexar</p>
        <h1>Publicar productos</h1>
      </div>
      <div class="head__actions">
        <a class="btn btn--ghost" href="/admin/biblioteca/">Biblioteca</a>
        <a class="btn btn--ghost" href="/admin/pedidos/">Pedidos</a>
        <a class="btn btn--ghost" href="/admin/abonados/">Abonados</a>
        <button type="button" class="btn btn--ghost" data-logout>Cerrar sesión</button>
      </div>
    </header>

    <p class="lead">
      Software / plugins / tools. Se ve en
      <a href="/es/catalogo/" target="_blank" rel="noopener">/es/catalogo/</a>
      (panel + ficha). Misma sesión que biblioteca.
    </p>

    <section class="stats-card" data-download-stats>
      <div class="stats-card__head">
        <h2 class="subhead">Descargas</h2>
        <p class="lead lead--sm" data-stats-meta>Demo/beta (clic) · full con licencia (entrega real)</p>
      </div>
      <div class="stats-totals" data-stats-totals>
        <span class="stat-pill" data-tot-demo title="Demo descarga">Demo <strong>0</strong></span>
        <span class="stat-pill" data-tot-web title="Demo web">Web <strong>0</strong></span>
        <span class="stat-pill" data-tot-request title="Solicitar demo">Req <strong>0</strong></span>
        <span class="stat-pill" data-tot-full title="Full con licencia">Full <strong>0</strong></span>
      </div>
      <div class="table-wrap" data-stats-table>
        <p class="rail-empty">Sin datos aún (se rellenan al usar el catálogo).</p>
      </div>
    </section>

    <div class="admin-layout">
      <div class="workspace">
        <div class="edit-bar" data-edit-bar hidden>
          <span data-edit-label>Editando…</span>
          <button type="button" class="btn btn--sm" data-edit-cancel>Nuevo</button>
        </div>

        <form class="form" data-product-form>
          <label>
            Nombre *
            <input name="name" required maxlength="160" data-name placeholder="Nimpo Tools" />
          </label>
          <label>
            slug (url)
            <input name="slug" maxlength="80" data-slug placeholder="auto desde el nombre" />
          </label>

          <div class="row">
            <label>
              Categoría
              <select name="category" data-category>
                <option value="plugin">Plugin</option>
                <option value="app">App</option>
                <option value="tool">Tool</option>
                <option value="pack">Pack</option>
                <option value="other" selected>Otro</option>
              </select>
            </label>
            <label>
              Estado
              <select name="status" data-status>
                <option value="published" selected>Publicado</option>
                <option value="beta">Beta (sin precio obligatorio)</option>
                <option value="demo">Demo (sin precio obligatorio)</option>
                <option value="coming-soon">Próximamente</option>
                <option value="draft">Borrador (oculto)</option>
              </select>
            </label>
          </div>

          <label>
            Descripción corta
            <input name="shortDescription" maxlength="280" data-short placeholder="Una línea para el panel" />
          </label>
          <label>
            Descripción *
            <textarea name="description" required maxlength="4000" rows="6" data-description placeholder="Qué es, para quién, qué incluye…"></textarea>
          </label>

          <div class="row">
            <label>
              Tags (coma)
              <input name="tags" data-tags placeholder="vst, windows, midi" />
            </label>
            <label>
              Formatos (coma)
              <input name="formats" data-formats placeholder="VST3, AU, Win" />
            </label>
          </div>

          <label class="check">
            <input type="checkbox" name="featured" value="1" data-featured />
            Destacado (arriba en el panel)
          </label>

          <p class="lead lead--sm">Demo · precio (hub ficha pública)</p>
          <div class="row">
            <label>
              Demo
              <select name="demoKind" data-demo-kind>
                <option value="none">Sin demo</option>
                <option value="download">Descarga</option>
                <option value="web">Web / URL</option>
                <option value="request">Solicitar (form)</option>
              </select>
            </label>
            <label>
              Versión
              <input name="version" data-version maxlength="40" placeholder="1.0.0" />
            </label>
          </div>
          <label>
            URL demo (path /api/media/… o https)
            <input name="demoUrl" data-demo-url maxlength="500" placeholder="/api/media/library/products/…/demo.zip" />
          </label>
          <label>
            Notas demo
            <input name="demoNotes" data-demo-notes maxlength="500" placeholder="Windows x64 · sin export…" />
          </label>
          <div class="row">
            <label>
              Plan
              <input name="planName" data-plan-name maxlength="80" placeholder="Standard" />
            </label>
            <label>
              Precio EUR
              <input
                name="priceEur"
                data-price-eur
                type="number"
                min="0"
                step="0.01"
                inputmode="decimal"
                placeholder="9.90"
              />
              <span class="field-hint" data-price-hint>Decimales OK (9.90). Vacío en beta/demo.</span>
            </label>
          </div>
          <label>
            URL compra fallback (Payment Link https… · vacío = Checkout API o mailto)
            <input name="buyUrl" data-buy-url maxlength="500" placeholder="https://buy.stripe.com/…" />
          </label>
          <label>
            Stripe Price ID (price_… → Checkout)
            <input name="stripePriceId" data-stripe-price maxlength="80" placeholder="price_…" />
          </label>
          <p class="field-label">Demo file (zip, opcional — se publica en demo/)</p>
          <div
            class="dropzone"
            data-demo-drop
            tabindex="0"
            role="button"
            aria-label="Arrastra demo file o haz clic"
          >
            <input
              type="file"
              accept=".zip,.7z,.msi,.exe,.dmg,.pkg,application/zip"
              hidden
              data-demo-file
            />
            <p class="dropzone__title">Arrastra demo</p>
            <p class="dropzone__sub" data-demo-fname>zip / exe / dmg · o clic</p>
          </div>
          <p class="bin-status" data-demo-status data-state="idle" hidden></p>

          <p class="field-label">Full build (zip/exe — privado full/, solo post-pago)</p>
          <div
            class="dropzone"
            data-full-drop
            tabindex="0"
            role="button"
            aria-label="Arrastra full build o haz clic"
          >
            <input
              type="file"
              accept=".zip,.7z,.msi,.exe,.dmg,.pkg,application/zip"
              hidden
              data-full-file
            />
            <p class="dropzone__title">Arrastra full build</p>
            <p class="dropzone__sub" data-full-fname>zip / exe / dmg · o clic</p>
          </div>
          <p class="bin-status" data-full-status data-state="idle" hidden></p>

          <p class="field-label">Imágenes / GIF (hasta 8 · al editar se suman, no se borran)</p>
          <div
            class="dropzone"
            data-images-drop
            tabindex="0"
            role="button"
            aria-label="Arrastra imágenes o haz clic"
          >
            <input
              type="file"
              accept="image/jpeg,image/png,image/webp,image/gif,.jpg,.jpeg,.png,.webp,.gif"
              multiple
              hidden
              data-images
            />
            <p class="dropzone__title">Arrastra imágenes / GIF</p>
            <p class="dropzone__sub" data-images-fname>jpg · png · webp · gif · o clic</p>
          </div>
          <p class="lead lead--sm" data-media-keep-hint hidden>
            Media actual se conserva al guardar. Solo se borra si marcas «Reemplazar todo» abajo.
          </p>
          <div class="preview preview--row" data-images-current hidden></div>
          <div class="preview preview--row" data-images-preview hidden></div>

          <p class="field-label">Vídeo (opcional, mp4/webm · sin archivo nuevo = se mantiene)</p>
          <div
            class="dropzone"
            data-video-drop
            tabindex="0"
            role="button"
            aria-label="Arrastra vídeo o haz clic"
          >
            <input
              type="file"
              accept="video/mp4,video/webm,video/quicktime,.mp4,.webm,.mov"
              hidden
              data-video
            />
            <p class="dropzone__title">Arrastra vídeo</p>
            <p class="dropzone__sub" data-video-fname>mp4 / webm / mov · o clic</p>
          </div>
          <div class="preview preview--video" data-video-current hidden></div>
          <div class="preview preview--video" data-video-preview hidden></div>

          <label class="check" data-replace-wrap hidden>
            <input type="checkbox" name="replaceMedia" value="1" data-replace />
            Reemplazar todo el media (borra imágenes/vídeo previos y deja solo lo que subas ahora)
          </label>

          <button type="submit" class="btn btn--gold" data-publish>Publicar producto</button>
          <p class="status" data-status-msg hidden></p>
        </form>
      </div>

      <aside class="rail">
        <div class="rail__head">
          <h2 class="subhead">Publicados</h2>
          <button type="button" class="btn btn--sm" data-refresh title="Actualizar">↻</button>
        </div>
        <p class="lead lead--sm">Miniaturas · editar · borrar</p>
        <div class="rail-list" data-rail>
          <p class="rail-empty">Cargando…</p>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script>
  import { compressImageForUpload, compressImagesForUpload } from "../../lib/admin-image-compress";
  import { bindFileDropzone } from "../../lib/admin/file-dropzone";

  type Product = {
    slug: string;
    name: string;
    category?: string;
    status?: string;
    shortDescription?: string;
    description?: string;
    images?: string[];
    video?: string | null;
    tags?: string[];
    formats?: string[];
    featured?: boolean;
    version?: string;
    fullKey?: string | null;
    demo?: { kind?: string; url?: string | null; notes?: string };
    pricing?: {
      id?: string;
      name?: string;
      priceEur?: number | null;
      buyUrl?: string | null;
      stripePriceId?: string | null;
    }[];
  };

  let editingSlug: string | null = null;
  let items: Product[] = [];
  /** Snapshot del producto en edición — para reponer status bins si se quita el file local */
  let editingItem: Product | null = null;

  type DlRow = { demo: number; web: number; request: number; full: number; lastDemoAt?: string; lastFullAt?: string };
  let downloadStats: {
    products: Record<string, DlRow>;
    totals: { demo: number; web: number; request: number; full: number };
    updatedAt?: string;
  } = {
    products: {},
    totals: { demo: 0, web: 0, request: 0, full: 0 },
  };

  const form = document.querySelector("[data-product-form]") as HTMLFormElement | null;
  const statusEl = document.querySelector("[data-status-msg]");
  const editBar = document.querySelector("[data-edit-bar]");
  const editLabel = document.querySelector("[data-edit-label]");
  const replaceWrap = document.querySelector("[data-replace-wrap]");
  const publishBtn = document.querySelector("[data-publish]");

  document.querySelector("[data-logout]")?.addEventListener("click", async () => {
    await fetch("/admin/session", { method: "DELETE", credentials: "same-origin" });
    location.href = "/admin/productos/";
  });

  const setStatus = (msg: string, ok = true) => {
    if (!(statusEl instanceof HTMLElement)) return;
    statusEl.hidden = false;
    statusEl.textContent = msg;
    statusEl.classList.toggle("is-err", !ok);
  };

  type BinState = "idle" | "none" | "kept" | "pending" | "ok" | "err";

  const formatBinSize = (bytes: number) => {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  };

  const baseName = (path: string) => {
    const s = String(path || "").trim();
    if (!s) return "";
    const clean = s.split("?")[0] || s;
    const parts = clean.split("/").filter(Boolean);
    return parts[parts.length - 1] || clean;
  };

  const setBinStatus = (sel: string, state: BinState, text: string) => {
    const el = document.querySelector(sel);
    if (!(el instanceof HTMLElement)) return;
    if (state === "idle" || !text) {
      el.hidden = true;
      el.textContent = "";
      el.dataset.state = "idle";
      return;
    }
    el.hidden = false;
    el.textContent = text;
    el.dataset.state = state;
  };

  const DROP_DEFAULTS: Record<string, string> = {
    demo: "zip / exe / dmg · o clic",
    full: "zip / exe / dmg · o clic",
    images: "jpg · png · webp · gif · o clic",
    video: "mp4 / webm / mov · o clic",
  };
  const DROP_TITLES: Record<string, string> = {
    demo: "Arrastra demo",
    full: "Arrastra full build",
    images: "Arrastra imágenes / GIF",
    video: "Arrastra vídeo",
  };

  const setDropTitle = (dropSel: string, title: string) => {
    const t = document.querySelector(`${dropSel} .dropzone__title`);
    if (t instanceof HTMLElement) t.textContent = title;
  };

  const setDropFname = (sel: string, text: string) => {
    const el = document.querySelector(sel);
    if (el instanceof HTMLElement) el.textContent = text;
  };

  const resetDropFnames = () => {
    setDropTitle("[data-demo-drop]", DROP_TITLES.demo);
    setDropTitle("[data-full-drop]", DROP_TITLES.full);
    setDropTitle("[data-images-drop]", DROP_TITLES.images);
    setDropTitle("[data-video-drop]", DROP_TITLES.video);
    setDropFname("[data-demo-fname]", DROP_DEFAULTS.demo);
    setDropFname("[data-full-fname]", DROP_DEFAULTS.full);
    setDropFname("[data-images-fname]", DROP_DEFAULTS.images);
    setDropFname("[data-video-fname]", DROP_DEFAULTS.video);
  };

  const syncDemoBinFromItem = (item: Product | null) => {
    const demoFile = form?.querySelector("[data-demo-file]") as HTMLInputElement | null;
    const local = demoFile?.files?.[0];
    if (local && local.size > 0) {
      setBinStatus(
        "[data-demo-status]",
        "pending",
        `Demo listo: ${local.name} (${formatBinSize(local.size)}) · se subirá al guardar`,
      );
      setDropTitle("[data-demo-drop]", "Demo listo (PC)");
      setDropFname("[data-demo-fname]", `${local.name} · ${formatBinSize(local.size)} · se sube al guardar`);
      return;
    }
    const url = item?.demo?.url ? String(item.demo.url) : "";
    if (url) {
      setBinStatus(
        "[data-demo-status]",
        "kept",
        `Demo en catálogo: ${baseName(url)} · se mantiene si no subes otro`,
      );
      setDropTitle("[data-demo-drop]", "Demo en catálogo");
      setDropFname(
        "[data-demo-fname]",
        `${baseName(url)} · se mantiene · arrastra otro para reemplazar`,
      );
      return;
    }
    if (item) {
      setBinStatus("[data-demo-status]", "none", "Demo: sin archivo (opcional)");
      setDropTitle("[data-demo-drop]", "Arrastra demo");
      setDropFname("[data-demo-fname]", "sin archivo · zip / exe / dmg · o clic");
      return;
    }
    setBinStatus("[data-demo-status]", "idle", "");
    setDropTitle("[data-demo-drop]", "Arrastra demo");
    setDropFname("[data-demo-fname]", DROP_DEFAULTS.demo);
  };

  const syncFullBinFromItem = (item: Product | null) => {
    const fullFile = form?.querySelector("[data-full-file]") as HTMLInputElement | null;
    const local = fullFile?.files?.[0];
    if (local && local.size > 0) {
      setBinStatus(
        "[data-full-status]",
        "pending",
        `Full listo: ${local.name} (${formatBinSize(local.size)}) · se subirá al guardar`,
      );
      setDropTitle("[data-full-drop]", "Full listo (PC)");
      setDropFname("[data-full-fname]", `${local.name} · ${formatBinSize(local.size)} · se sube al guardar`);
      return;
    }
    const key = item?.fullKey ? String(item.fullKey) : "";
    if (key) {
      setBinStatus(
        "[data-full-status]",
        "kept",
        `Full en R2: ${baseName(key)} · se mantiene si no subes otro`,
      );
      setDropTitle("[data-full-drop]", "Full en R2");
      setDropFname(
        "[data-full-fname]",
        `${baseName(key)} · se mantiene · arrastra otro para reemplazar`,
      );
      return;
    }
    if (item) {
      setBinStatus("[data-full-status]", "none", "Full: sin archivo en R2");
      setDropTitle("[data-full-drop]", "Arrastra full build");
      setDropFname("[data-full-fname]", "sin archivo en R2 · zip / exe · o clic");
      return;
    }
    setBinStatus("[data-full-status]", "idle", "");
    setDropTitle("[data-full-drop]", "Arrastra full build");
    setDropFname("[data-full-fname]", DROP_DEFAULTS.full);
  };

  const clearBinStatuses = () => {
    setBinStatus("[data-demo-status]", "idle", "");
    setBinStatus("[data-full-status]", "idle", "");
  };

  const bindBinFile = (inputSel: string, sync: () => void) => {
    const input = document.querySelector(inputSel);
    if (!(input instanceof HTMLInputElement)) return;
    input.addEventListener("change", () => sync());
  };
  bindBinFile("[data-demo-file]", () => syncDemoBinFromItem(editingItem));
  bindBinFile("[data-full-file]", () => syncFullBinFromItem(editingItem));

  const formatDropNames = (files: File[]) => {
    if (!files.length) return "";
    if (files.length === 1) {
      const f = files[0]!;
      return `${f.name} · ${formatBinSize(f.size)}`;
    }
    return `${files.length} archivos · ${files.map((f) => f.name).slice(0, 3).join(", ")}${files.length > 3 ? "…" : ""}`;
  };

  const wireProductDrop = (
    dropSel: string,
    inputSel: string,
    fnameSel: string,
    opts: { multiple?: boolean; maxFiles?: number; pendingTitle?: string },
  ) => {
    const drop = document.querySelector(dropSel);
    const input = document.querySelector(inputSel);
    if (!(drop instanceof HTMLElement) || !(input instanceof HTMLInputElement)) return;
    bindFileDropzone({
      drop,
      input,
      multiple: opts.multiple,
      maxFiles: opts.maxFiles,
      onReject: (reason) => setStatus(reason, false),
      onAssigned: (files) => {
        if (opts.pendingTitle) setDropTitle(dropSel, opts.pendingTitle);
        setDropFname(fnameSel, `${formatDropNames(files)} · se sube al guardar`);
      },
    });
    input.addEventListener("change", () => {
      const files = input.files ? [...input.files] : [];
      if (!files.length) return;
      if (opts.pendingTitle) setDropTitle(dropSel, opts.pendingTitle);
      setDropFname(fnameSel, `${formatDropNames(files)} · se sube al guardar`);
    });
  };
  wireProductDrop("[data-demo-drop]", "[data-demo-file]", "[data-demo-fname]", {
    pendingTitle: "Demo listo (PC)",
  });
  wireProductDrop("[data-full-drop]", "[data-full-file]", "[data-full-fname]", {
    pendingTitle: "Full listo (PC)",
  });
  wireProductDrop("[data-images-drop]", "[data-images]", "[data-images-fname]", {
    multiple: true,
    maxFiles: 8,
    pendingTitle: "Imágenes listas (PC)",
  });
  wireProductDrop("[data-video-drop]", "[data-video]", "[data-video-fname]", {
    pendingTitle: "Vídeo listo (PC)",
  });

  const slugify = (s: string) =>
    s
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-|-$/g, "")
      .slice(0, 80);

  const nameInput = form?.querySelector("[data-name]") as HTMLInputElement | null;
  const slugInput = form?.querySelector("[data-slug]") as HTMLInputElement | null;
  nameInput?.addEventListener("input", () => {
    if (editingSlug) return;
    if (slugInput && !slugInput.dataset.touched) {
      slugInput.value = slugify(nameInput.value);
    }
  });
  slugInput?.addEventListener("input", () => {
    slugInput.dataset.touched = "1";
  });

  const bindPreview = (inputSel: string, boxSel: string, multi: boolean) => {
    const input = document.querySelector(inputSel);
    const box = document.querySelector(boxSel);
    if (!(input instanceof HTMLInputElement) || !(box instanceof HTMLElement)) return;
    input.addEventListener("change", () => {
      const files = input.files ? [...input.files] : [];
      if (!files.length) {
        box.hidden = true;
        box.innerHTML = "";
        return;
      }
      box.hidden = false;
      box.innerHTML = files
        .slice(0, multi ? 8 : 1)
        .map((f) => {
          const url = URL.createObjectURL(f);
          if (f.type.startsWith("video/")) {
            return `<video src="${url}" controls playsinline></video><p class="fname">${f.name}</p>`;
          }
          return `<img src="${url}" alt="" /><p class="fname">${f.name}</p>`;
        })
        .join("");
    });
  };
  bindPreview("[data-images]", "[data-images-preview]", true);
  bindPreview("[data-video]", "[data-video-preview]", false);

  const clearFileInputs = () => {
    form?.querySelectorAll('input[type="file"]').forEach((el) => {
      if (el instanceof HTMLInputElement) el.value = "";
    });
    resetDropFnames();
  };

  const clearPreview = (sel: string) => {
    const el = document.querySelector(sel);
    if (el instanceof HTMLElement) {
      el.hidden = true;
      el.innerHTML = "";
    }
  };

  const showCurrentMedia = (item: Product) => {
    const imgs = document.querySelector("[data-images-current]");
    const vids = document.querySelector("[data-video-current]");
    const hint = document.querySelector("[data-media-keep-hint]");
    const list = Array.isArray(item.images) ? item.images.filter(Boolean) : [];
    const localImages = form?.querySelector("[data-images]") as HTMLInputElement | null;
    const localVideo = form?.querySelector("[data-video]") as HTMLInputElement | null;
    const hasLocalImg = Boolean(localImages?.files?.length);
    const hasLocalVid = Boolean(localVideo?.files?.[0]);

    if (imgs instanceof HTMLElement) {
      if (list.length) {
        imgs.hidden = false;
        imgs.innerHTML =
          `<p class="fname">Actuales (${list.length}/8) — se conservan al guardar</p>` +
          list
            .map(
              (src) =>
                `<img src="${String(src).replace(/"/g, "")}" alt="" loading="lazy" />`,
            )
            .join("");
      } else {
        imgs.hidden = true;
        imgs.innerHTML = "";
      }
    }
    if (!hasLocalImg) {
      if (list.length) {
        setDropTitle("[data-images-drop]", "Imágenes en catálogo");
        setDropFname(
          "[data-images-fname]",
          `${list.length}/8 en catálogo · se conservan · arrastra para sumar`,
        );
      } else {
        setDropTitle("[data-images-drop]", DROP_TITLES.images);
        setDropFname("[data-images-fname]", DROP_DEFAULTS.images);
      }
    }

    if (vids instanceof HTMLElement) {
      const v = item.video ? String(item.video) : "";
      if (v) {
        vids.hidden = false;
        vids.innerHTML = `<p class="fname">Vídeo actual — se mantiene si no subes otro</p><video src="${v.replace(/"/g, "")}" controls playsinline></video>`;
      } else {
        vids.hidden = true;
        vids.innerHTML = "";
      }
    }
    if (!hasLocalVid) {
      const v = item.video ? String(item.video) : "";
      if (v) {
        setDropTitle("[data-video-drop]", "Vídeo en catálogo");
        setDropFname(
          "[data-video-fname]",
          `${baseName(v)} · se mantiene · arrastra otro para reemplazar`,
        );
      } else {
        setDropTitle("[data-video-drop]", DROP_TITLES.video);
        setDropFname("[data-video-fname]", DROP_DEFAULTS.video);
      }
    }

    if (hint instanceof HTMLElement) {
      hint.hidden = !(list.length || item.video);
    }
  };

  const resetForm = () => {
    editingSlug = null;
    editingItem = null;
    form?.reset();
    clearFileInputs();
    if (slugInput) {
      delete slugInput.dataset.touched;
      slugInput.value = "";
    }
    if (editBar instanceof HTMLElement) editBar.hidden = true;
    if (replaceWrap instanceof HTMLElement) replaceWrap.hidden = true;
    if (publishBtn instanceof HTMLElement) publishBtn.textContent = "Publicar producto";
    const replaceCb = form?.querySelector("[data-replace]") as HTMLInputElement | null;
    if (replaceCb) replaceCb.checked = false;
    clearPreview("[data-images-preview]");
    clearPreview("[data-video-preview]");
    clearPreview("[data-images-current]");
    clearPreview("[data-video-current]");
    clearBinStatuses();
    const hint = document.querySelector("[data-media-keep-hint]");
    if (hint instanceof HTMLElement) hint.hidden = true;
  };

  document.querySelector("[data-edit-cancel]")?.addEventListener("click", resetForm);

  const priceInput = form?.querySelector("[data-price-eur]") as HTMLInputElement | null;
  const priceHint = document.querySelector("[data-price-hint]");
  const statusSelect = form?.querySelector("[data-status]") as HTMLSelectElement | null;

  const syncPriceOptional = () => {
    const st = statusSelect?.value || "published";
    const optional = st === "beta" || st === "demo";
    if (priceInput) {
      priceInput.required = false;
      priceInput.removeAttribute("required");
      priceInput.placeholder = optional ? "opcional" : "9.90";
    }
    if (priceHint instanceof HTMLElement) {
      priceHint.textContent = optional
        ? "Beta/demo: precio no obligatorio. Decimales OK (9.90)."
        : "Decimales OK (9.90). Vacío = sin precio público.";
    }
  };
  statusSelect?.addEventListener("change", syncPriceOptional);
  syncPriceOptional();

  const fillForm = (item: Product) => {
    editingSlug = item.slug;
    editingItem = item;
    if (editBar instanceof HTMLElement) editBar.hidden = false;
    if (editLabel) editLabel.textContent = `Editando «${item.name}»`;
    if (replaceWrap instanceof HTMLElement) replaceWrap.hidden = false;
    if (publishBtn instanceof HTMLElement) publishBtn.textContent = "Guardar cambios";

    // No reutilizar checkbox ni files de otra ficha
    clearFileInputs();
    const replaceCb = form?.querySelector("[data-replace]") as HTMLInputElement | null;
    if (replaceCb) replaceCb.checked = false;
    clearPreview("[data-images-preview]");
    clearPreview("[data-video-preview]");

    const set = (sel: string, v: string) => {
      const el = form?.querySelector(sel) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
      if (el) el.value = v;
    };
    set("[data-name]", item.name || "");
    set("[data-slug]", item.slug || "");
    if (slugInput) slugInput.dataset.touched = "1";
    set("[data-category]", item.category || "other");
    set("[data-status]", item.status || "published");
    set("[data-short]", item.shortDescription || "");
    set("[data-description]", item.description || "");
    set("[data-tags]", (item.tags || []).join(", "));
    set("[data-formats]", (item.formats || []).join(", "));
    const feat = form?.querySelector("[data-featured]") as HTMLInputElement | null;
    if (feat) feat.checked = Boolean(item.featured);
    set("[data-demo-kind]", item.demo?.kind || "none");
    set("[data-demo-url]", item.demo?.url || "");
    set("[data-demo-notes]", item.demo?.notes || "");
    set("[data-version]", item.version || "");
    const plan = item.pricing?.[0];
    set("[data-plan-name]", plan?.name || "Standard");
    set(
      "[data-price-eur]",
      plan?.priceEur != null && Number.isFinite(Number(plan.priceEur))
        ? String(plan.priceEur)
        : "",
    );
    set("[data-buy-url]", plan?.buyUrl || "");
    set("[data-stripe-price]", plan?.stripePriceId || "");
    syncPriceOptional();
    showCurrentMedia(item);
    syncDemoBinFromItem(item);
    syncFullBinFromItem(item);

    form?.scrollIntoView({ behavior: "smooth", block: "start" });
  };

  const safeThumbUrl = (item: Product) => {
    const imgs = Array.isArray(item.images) ? item.images : [];
    const first = imgs.map((u) => String(u || "").trim()).find(Boolean);
    if (!first) return "/images/admin-thumb.svg";
    // Solo paths/media conocidos (evita javascript: en thumb)
    if (
      first.startsWith("/api/media/") ||
      first.startsWith("/images/") ||
      /^https:\/\//i.test(first)
    ) {
      return first.replace(/"/g, "%22").replace(/</g, "");
    }
    return "/images/admin-thumb.svg";
  };

  const railBinChips = (item: Product) => {
    const hasFull = Boolean(item.fullKey && String(item.fullKey).includes("/full/"));
    const demoUrl = item.demo?.url ? String(item.demo.url) : "";
    const hasDemo = Boolean(demoUrl && !demoUrl.includes("/full/"));
    const st = downloadStats.products[item.slug || ""] || {
      demo: 0,
      web: 0,
      request: 0,
      full: 0,
    };
    const demoN = (st.demo || 0) + (st.web || 0) + (st.request || 0);
    const fullN = st.full || 0;
    const chips = [
      hasFull
        ? `<span class="tile__chip tile__chip--full" title="Full en R2">full</span>`
        : "",
      hasDemo
        ? `<span class="tile__chip tile__chip--demo" title="Demo en catálogo">demo</span>`
        : "",
      demoN > 0
        ? `<span class="tile__chip tile__chip--stat" title="Demo/beta clic: ${demoN}">↓${demoN}</span>`
        : "",
      fullN > 0
        ? `<span class="tile__chip tile__chip--stat-full" title="Full descargado: ${fullN}">F${fullN}</span>`
        : "",
    ].filter(Boolean);
    if (!chips.length) {
      return `<span class="tile__chip tile__chip--muted" title="Sin binarios">sin bin</span>`;
    }
    return chips.join("");
  };

  const renderDownloadStats = () => {
    const tot = downloadStats.totals || { demo: 0, web: 0, request: 0, full: 0 };
    const setPill = (sel: string, n: number) => {
      const el = document.querySelector(sel);
      if (el) {
        const strong = el.querySelector("strong");
        if (strong) strong.textContent = String(n);
      }
    };
    setPill("[data-tot-demo]", tot.demo || 0);
    setPill("[data-tot-web]", tot.web || 0);
    setPill("[data-tot-request]", tot.request || 0);
    setPill("[data-tot-full]", tot.full || 0);

    const meta = document.querySelector("[data-stats-meta]");
    if (meta instanceof HTMLElement && downloadStats.updatedAt) {
      const d = new Date(downloadStats.updatedAt);
      const label = Number.isNaN(d.getTime())
        ? downloadStats.updatedAt
        : d.toLocaleString("es-ES");
      meta.textContent = `Demo/beta (clic) · full con licencia · actualizado ${label}`;
    }

    const table = document.querySelector("[data-stats-table]");
    if (!(table instanceof HTMLElement)) return;

    const rows = items
      .map((item) => {
        const slug = item.slug || "";
        const st = downloadStats.products[slug] || {
          demo: 0,
          web: 0,
          request: 0,
          full: 0,
        };
        const sum =
          (st.demo || 0) + (st.web || 0) + (st.request || 0) + (st.full || 0);
        return { item, st, sum, slug };
      })
      .filter((r) => r.sum > 0)
      .sort((a, b) => b.sum - a.sum);

    // Productos solo en stats (borrados del catálogo pero con histórico)
    for (const [slug, st] of Object.entries(downloadStats.products || {})) {
      if (items.some((i) => i.slug === slug)) continue;
      const sum =
        (st.demo || 0) + (st.web || 0) + (st.request || 0) + (st.full || 0);
      if (sum > 0) {
        rows.push({
          item: { slug, name: `${slug} (histórico)` },
          st,
          sum,
          slug,
        });
      }
    }
    rows.sort((a, b) => b.sum - a.sum);

    if (!rows.length) {
      table.innerHTML =
        `<p class="rail-empty">Sin descargas aún. Al pulsar «Probar demo/beta» o descargar full desde cuenta se cuentan aquí.</p>`;
      return;
    }

    const esc = (s: string) =>
      String(s || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/"/g, "&quot;");

    table.innerHTML = `<table class="stats-table">
      <thead>
        <tr>
          <th>Producto</th>
          <th title="Clic Probar demo/beta (descarga)">Demo</th>
          <th title="Apertura demo web">Web</th>
          <th title="Solicitar demo">Req</th>
          <th title="Full con licencia">Full</th>
        </tr>
      </thead>
      <tbody>
        ${rows
          .map(({ item, st }) => {
            const name = esc(item.name || item.slug || "—");
            const slug = esc(item.slug || "");
            return `<tr>
              <td><strong>${name}</strong><br /><span class="stats-slug">${slug}</span></td>
              <td>${st.demo || 0}</td>
              <td>${st.web || 0}</td>
              <td>${st.request || 0}</td>
              <td>${st.full || 0}</td>
            </tr>`;
          })
          .join("")}
      </tbody>
    </table>`;
  };

  const renderRail = () => {
    const rail = document.querySelector("[data-rail]");
    if (!(rail instanceof HTMLElement)) return;
    if (!items.length) {
      rail.innerHTML = `<p class="rail-empty">Ningún producto aún. Publica el primero.</p>`;
      return;
    }
    rail.innerHTML = items
      .map((item) => {
        const safeSlug = String(item.slug || "").replace(/"/g, "");
        const safeName = String(item.name || "").replace(/"/g, "");
        const thumb = safeThumbUrl(item);
        const media = `<img src="${thumb}" alt="" width="64" height="64" loading="lazy" />`;
        const name = String(item.name || safeSlug);
        const shortName = name.length > 22 ? `${name.slice(0, 20)}…` : name;
        const safeShort = shortName.replace(/</g, "&lt;").replace(/"/g, "&quot;");
        const chips = railBinChips(item);
        return `<article class="tile" data-slug="${safeSlug}" title="${safeName}">
          <div class="tile__media" data-edit="${safeSlug}" role="button" tabindex="0" aria-label="Editar ${safeName}">
            ${media}
          </div>
          <p class="tile__title">${safeShort}</p>
          <div class="tile__bins">${chips}</div>
          <div class="tile__actions">
            <button type="button" class="tile__btn" data-edit="${safeSlug}" title="Editar" aria-label="Editar ${safeName}">Editar</button>
            <button type="button" class="tile__btn tile__btn--danger" data-del="${safeSlug}" title="Borrar" aria-label="Borrar ${safeName}">Borrar</button>
          </div>
        </article>`;
      })
      .join("");

    rail.querySelectorAll("[data-edit]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const slug = (btn as HTMLElement).dataset.edit;
        const item = items.find((x) => x.slug === slug);
        if (item) fillForm(item);
      });
    });
    rail.querySelectorAll("[data-del]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const slug = (btn as HTMLElement).dataset.del || "";
        if (!slug || !confirm(`¿Borrar «${slug}» y su media?`)) return;
        try {
          const res = await fetch(`/admin/products?slug=${encodeURIComponent(slug)}`, {
            method: "DELETE",
            credentials: "same-origin",
          });
          const data = await res.json();
          if (!res.ok || !data.ok) throw new Error(data.message || data.error || res.status);
          setStatus(`✅ Borrado «${slug}»`);
          if (editingSlug === slug) resetForm();
          await loadItems();
        } catch (e) {
          setStatus(e instanceof Error ? e.message : "Error al borrar", false);
        }
      });
    });
  };

  const loadItems = async () => {
    const rail = document.querySelector("[data-rail]");
    try {
      const res = await fetch("/admin/products", { credentials: "same-origin" });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || res.status);
      items = Array.isArray(data.items) ? data.items : [];
      if (data.downloadStats && typeof data.downloadStats === "object") {
        downloadStats = {
          products: data.downloadStats.products || {},
          totals: data.downloadStats.totals || {
            demo: 0,
            web: 0,
            request: 0,
            full: 0,
          },
          updatedAt: data.downloadStats.updatedAt,
        };
      }
      renderDownloadStats();
      renderRail();
    } catch (e) {
      if (rail instanceof HTMLElement) {
        rail.innerHTML = `<p class="rail-empty is-err">${e instanceof Error ? e.message : "Error"}</p>`;
      }
    }
  };

  document.querySelector("[data-refresh]")?.addEventListener("click", () => loadItems());

  /** POST multipart con % de subida (fetch no expone upload progress). */
  const postFormWithProgress = (
    url: string,
    body: FormData,
    onProgress: (loaded: number, total: number) => void,
  ): Promise<{ ok: boolean; status: number; data: Record<string, unknown> }> =>
    new Promise((resolve, reject) => {
      const xhr = new XMLHttpRequest();
      xhr.open("POST", url);
      xhr.withCredentials = true;
      xhr.upload.onprogress = (ev) => {
        if (ev.lengthComputable && ev.total > 0) onProgress(ev.loaded, ev.total);
      };
      xhr.onload = () => {
        let data: Record<string, unknown> = {};
        try {
          data = JSON.parse(xhr.responseText || "{}") as Record<string, unknown>;
        } catch {
          reject(new Error(`Respuesta no JSON (${xhr.status})`));
          return;
        }
        resolve({
          ok: xhr.status >= 200 && xhr.status < 300,
          status: xhr.status,
          data,
        });
      };
      xhr.onerror = () => reject(new Error("Error de red al subir"));
      xhr.onabort = () => reject(new Error("Subida cancelada"));
      xhr.send(body);
    });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const btn = form.querySelector("[data-publish]");
    if (btn instanceof HTMLButtonElement) btn.disabled = true;

    const demoFileEl = form.querySelector("[data-demo-file]") as HTMLInputElement | null;
    const fullFileEl = form.querySelector("[data-full-file]") as HTMLInputElement | null;
    const demoLocal = demoFileEl?.files?.[0] || null;
    const fullLocal = fullFileEl?.files?.[0] || null;
    const hasDemoUpload = Boolean(demoLocal);
    const hasFullUpload = Boolean(fullLocal);
    const uploadHint = [hasFullUpload ? "full" : null, hasDemoUpload ? "demo" : null]
      .filter(Boolean)
      .join("+");
    const verb = editingSlug ? "Guardando" : "Publicando";
    setStatus(
      uploadHint
        ? `${verb}… (subiendo ${uploadHint})`
        : editingSlug
          ? "Guardando… (bins sin cambios)"
          : "Publicando…",
    );
    if (hasDemoUpload && demoLocal) {
      setBinStatus(
        "[data-demo-status]",
        "pending",
        `Demo: subiendo… ${demoLocal.name} (${formatBinSize(demoLocal.size)})`,
      );
    }
    if (hasFullUpload && fullLocal) {
      setBinStatus(
        "[data-full-status]",
        "pending",
        `Full: subiendo… ${fullLocal.name} (${formatBinSize(fullLocal.size)})`,
      );
    }

    try {
      const fd = new FormData(form);
      // rename fields for API
      const body = new FormData();
      body.set("name", String(fd.get("name") || "").trim());
      body.set("slug", String(fd.get("slug") || "").trim());
      body.set("category", String(fd.get("category") || "other"));
      body.set("status", String(fd.get("status") || "published"));
      body.set("shortDescription", String(fd.get("shortDescription") || "").trim());
      body.set("description", String(fd.get("description") || "").trim());
      body.set("tags", String(fd.get("tags") || "").trim());
      body.set("formats", String(fd.get("formats") || "").trim());
      body.set("demoKind", String(fd.get("demoKind") || "none"));
      body.set("demoUrl", String(fd.get("demoUrl") || "").trim());
      body.set("demoNotes", String(fd.get("demoNotes") || "").trim());
      body.set("version", String(fd.get("version") || "").trim());
      body.set("planName", String(fd.get("planName") || "Standard").trim());
      body.set("priceEur", String(fd.get("priceEur") || "").trim());
      body.set("buyUrl", String(fd.get("buyUrl") || "").trim());
      body.set("stripePriceId", String(fd.get("stripePriceId") || "").trim());
      if (fd.get("featured") === "1" || fd.get("featured") === "on") body.set("featured", "1");
      // Solo si el usuario marca la casilla; por defecto NO se envía → se conservan y se suman
      const replaceCb = form.querySelector("[data-replace]") as HTMLInputElement | null;
      if (replaceCb?.checked) body.set("replaceMedia", "1");

      if (demoLocal) body.set("demoFile", demoLocal);
      if (fullLocal) body.set("full", fullLocal);

      const images = form.querySelector("[data-images]") as HTMLInputElement | null;
      if (images?.files?.length) {
        const editing = Boolean(editingSlug);
        const existingCount = editing
          ? items.find((x) => x.slug === editingSlug)?.images?.length || 0
          : 0;
        const replaceAll = Boolean(replaceCb?.checked);
        const room = replaceAll ? 8 : Math.max(0, 8 - existingCount);
        // Galería: max 720px; al editar solo caben hasta llenar 8
        const raw = [...images.files].slice(0, room || (replaceAll ? 8 : 0));
        if (raw.length) {
          const small = await compressImagesForUpload(raw, {
            maxEdge: 720,
            quality: 0.78,
            preserveGif: true,
          });
          small.forEach((f) => body.append("images", f, f.name));
        } else if (images.files.length && !replaceAll && existingCount >= 8) {
          throw new Error("Ya hay 8 imágenes. Marca «Reemplazar todo» o borra el producto y vuelve a crear.");
        }
      }
      const video = form.querySelector("[data-video]") as HTMLInputElement | null;
      if (video?.files?.[0]) body.set("video", video.files[0]);

      const { ok, status, data } = await postFormWithProgress(
        "/admin/products",
        body,
        (loaded, total) => {
          const pct = Math.min(100, Math.round((loaded / total) * 100));
          const sizePart = `${formatBinSize(loaded)} / ${formatBinSize(total)}`;
          setStatus(
            uploadHint
              ? `${verb}… ${pct}% · ${sizePart}${uploadHint ? ` · ${uploadHint}` : ""}`
              : `${verb}… ${pct}%`,
          );
          if (hasDemoUpload && demoLocal) {
            setBinStatus(
              "[data-demo-status]",
              "pending",
              `Demo: subiendo ${pct}% · ${demoLocal.name}`,
            );
          }
          if (hasFullUpload && fullLocal) {
            setBinStatus(
              "[data-full-status]",
              "pending",
              `Full: subiendo ${pct}% · ${fullLocal.name}`,
            );
          }
        },
      );
      if (!ok || !data.ok) {
        throw new Error(
          String(data.message || data.error || `Error ${status}`),
        );
      }
      setStatus(`✅ ${String(data.message || "OK")} · «${(data.item as { name?: string } | undefined)?.name || ""}»`);
      resetForm();
      await loadItems();
    } catch (err) {
      setStatus(err instanceof Error ? err.message : "Error", false);
      if (hasDemoUpload) {
        setBinStatus("[data-demo-status]", "err", "Demo: error al subir");
      } else {
        syncDemoBinFromItem(editingItem);
      }
      if (hasFullUpload) {
        setBinStatus("[data-full-status]", "err", "Full: error al subir");
      } else {
        syncFullBinFromItem(editingItem);
      }
    } finally {
      if (btn instanceof HTMLButtonElement) btn.disabled = false;
    }
  });

  void loadItems();
</script>

<style>
