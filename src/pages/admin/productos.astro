    padding-block: 2rem 4rem;
    max-width: 72rem;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .head__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .eyebrow {
    margin: 0;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-dim);
    font-weight: 600;
  }
  h1 {
    margin: 0.25rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 500;
  }
  .lead {
    margin: 0 0 1.5rem;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .field-hint {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.75rem;
    color: var(--color-muted);
    line-height: 1.35;
  }
  .lead a {
    color: var(--color-accent);
  }
  .lead--sm {
    margin-bottom: 0.75rem;
    font-size: 0.78rem;
  }
  .stats-card {
    margin: 0 0 1.25rem;
    padding: 1rem 1.1rem 1.15rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }
  .stats-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.65rem;
  }
  .stats-card__head .subhead {
    margin: 0;
  }
  .stats-card__head .lead--sm {
    margin: 0;
  }
  .stats-totals {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 0.75rem;
  }
  .stat-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: #0c0c10;
    font-size: 0.72rem;
    color: var(--color-muted);
  }
  .stat-pill strong {
    color: var(--color-fg);
    font-variant-numeric: tabular-nums;
  }
  .stats-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
  }
  .stats-table th,
  .stats-table td {
    text-align: left;
    padding: 0.4rem 0.5rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }
  .stats-table th {
    color: var(--color-muted);
    font-weight: 600;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .stats-table td:not(:first-child) {
    font-variant-numeric: tabular-nums;
    text-align: right;
    width: 3.5rem;
  }
  .stats-table th:not(:first-child) {
    text-align: right;
  }
  .stats-slug {
    font-size: 0.7rem;
    color: var(--color-muted);
  }
  .admin-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 18rem);
    gap: 1.25rem;
    align-items: start;
  }
  @media (max-width: 900px) {
    .admin-layout {
